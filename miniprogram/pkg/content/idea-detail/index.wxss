.article-page {
  padding-left: 56rpx;
  padding-right: 56rpx;
}

.article-card {
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.14);
}

.article-card__cover {
  width: 100%;
  height: 420rpx;
  border-radius: 28rpx;
  margin-bottom: 32rpx;
}

.article-card__title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.article-card__title {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 62rpx;
}

.article-card .detail-action-group {
  flex: 0 0 auto;
}

.article-hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.article-hero-meta__author {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.article-hero-meta__eyebrow {
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 0.22em;
  color: rgba(141, 77, 47, 0.58);
}

.article-hero-meta__name {
  font-size: 24rpx;
  line-height: 1.4;
  color: #7a3f2b;
  font-weight: 600;
}

.article-hero-meta__date {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(95, 82, 70, 0.72);
}

.article-guide-block {
  margin-top: 32rpx;
}

.article-guide-block__inner {
  padding: 28rpx 28rpx 30rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(186, 104, 63, 0.16), rgba(255, 246, 236, 0.92));
  box-shadow:
    inset 0 0 0 1rpx rgba(180, 108, 67, 0.14),
    0 18rpx 40rpx rgba(132, 83, 45, 0.08);
}

.article-guide-block__eyebrow {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #8d4d2f;
}

.article-rich-text {
  display: block;
  margin-top: 36rpx;
}

.article-rich-text--excerpt {
  margin-top: 0;
}

.article-inline-button {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8d4d2f, #a75f38);
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx rgba(141, 77, 47, 0.18);
}

.article-inline-button::after {
  border: 0;
}

.article-services {
  padding-top: 0;
}

.article-services__list {
  gap: 0;
}

.idea-service-card {
  display: block;
}
