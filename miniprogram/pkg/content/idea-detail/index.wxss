.article-page {
  padding-left: 56rpx;
  padding-right: 56rpx;
}

.article-card {
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.14);
}

.article-card__title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.article-card__title {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 62rpx;
}

.article-rich-text {
  display: block;
  margin-top: 36rpx;
}

.article-author {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 0;
}

.article-author__avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid rgba(189, 154, 95, 0.34);
}

.article-author__body {
  flex: 1;
  min-width: 0;
}

.article-author__name {
  display: block;
  margin-top: 4rpx;
}

.article-author__stance {
  display: block;
  margin-top: 8rpx;
}

.article-author__arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(153, 57, 33, 0.5);
}
