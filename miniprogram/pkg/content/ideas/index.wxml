<view class="page-shell idea-page">
  <view class="idea-hero">
    <image class="idea-hero__image" src="/images/content/hero-aba-presence.jpg" mode="aspectFill"></image>
    <view class="idea-hero__shade"></view>
    <view class="idea-hero__paper"></view>
    <view class="idea-hero__content">
      <view class="idea-hero__meta-row">
        <text class="idea-hero__meta">FIELD NOTES</text>
      </view>
      <text class="page-eyebrow idea-hero__title">真实在场 · 在地经验</text>
      <text class="page-subtitle idea-hero__subtitle" wx:if="{{!creatorSlug}}">把路上的风、人的声音和土地的细节，慢慢写进一篇篇笔记。</text>
      <text class="page-subtitle idea-hero__subtitle" wx:else>{{pageTitle}}</text>
    </view>
  </view>

  <scroll-view wx:if="{{!creatorSlug && themes.length}}" class="section-block theme-scroll" scroll-x="true" show-scrollbar="false">
    <view class="theme-row">
      <view
        wx:for="{{themes}}"
        wx:key="*this"
        class="theme-chip {{currentTheme === item ? 'theme-chip--active' : ''}}"
        data-theme="{{item}}"
        bindtap="toggleTheme"
      >
        <text class="theme-chip__text">{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="section-block idea-list-block">
    <view wx:if="{{errorText}}" class="paper-block page-feedback">
      <text class="page-feedback__title">加载失败</text>
      <text class="page-feedback__desc">{{errorText}}</text>
    </view>
    <view wx:elif="{{loading}}" class="empty-state">故事列表加载中...</view>
    <view wx:elif="{{ideas.length}}" class="idea-list">
      <view
        wx:for="{{ideas}}"
        wx:key="slug"
        class="idea-list-item {{index === 0 ? 'idea-list-item--featured' : ''}}"
        data-slug="{{item.slug}}"
        data-source-type="{{item.sourceType}}"
        data-wechat-article-url="{{item.wechatArticleUrl}}"
        data-wechat-article-title="{{item.wechatArticleTitle}}"
        data-title="{{item.title}}"
        bindtap="onIdeaTap"
        hover-class="idea-list-item--pressed"
        hover-stay-time="80"
      >
        <view wx:if="{{index === 0}}" class="idea-list-item__cover-wrap">
          <image class="idea-list-item__cover" src="{{item.cover || '/images/content/hero-aba-presence.jpg'}}" mode="aspectFill"></image>
          <text class="idea-list-item__cover-label">田野 · 现场笔记</text>
        </view>
        <view wx:elif="{{item.cover}}" class="idea-list-item__thumb-wrap">
          <image class="idea-list-item__thumb" src="{{item.cover}}" mode="aspectFill"></image>
        </view>
        <view wx:else class="idea-list-item__stamp">
          <text class="idea-list-item__stamp-text">野哉</text>
        </view>
        <view class="idea-list-item__main">
          <view class="idea-list-item__meta-row">
            <text class="idea-list-item__theme">{{item.themeLabel || item.theme || '现场笔记'}}</text>
            <text class="idea-list-item__number">NO.{{index + 1}}</text>
          </view>
          <text class="idea-list-item__title">{{item.title}}</text>
          <text class="idea-list-item__summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          <view class="idea-list-item__footer">
            <text class="idea-list-item__action">阅读全文</text>
            <text class="idea-list-item__arrow">→</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">暂无相关文章。</view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
