.theme-scroll {
  width: 100%;
}

.theme-row {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  padding-right: 12rpx;
}

.theme-chip {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 60rpx;
  padding: 0 20rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.18);
  background: rgba(255, 249, 242, 0.44);
  color: #6a5a4b;
  white-space: nowrap;
}

.theme-chip__text {
  display: block;
  font-size: 24rpx;
  line-height: 60rpx;
}

.theme-chip--active {
  border-color: rgba(209, 94, 20, 0.34);
  background: rgba(209, 94, 20, 0.09);
  color: #993921;
}

.idea-list-block {
  margin-top: 0;
}

.idea-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.idea-list-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 28rpx 30rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.08);
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.64), rgba(249, 244, 236, 0.34));
  box-shadow: 0 10rpx 24rpx rgba(84, 57, 31, 0.035);
}

.idea-list-item:last-child {
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.08);
}

.idea-list-item__main {
  flex: 1;
  min-width: 0;
}

.idea-list-item__title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #2b241d;
}

.idea-list-item__summary {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.78;
  color: #6a5a4b;
}

.idea-list-item__arrow {
  flex-shrink: 0;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(153, 57, 33, 0.5);
}
