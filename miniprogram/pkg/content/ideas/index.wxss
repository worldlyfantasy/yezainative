page {
  background:
    linear-gradient(180deg, #efe1bd 0%, #f4ead2 46%, #efe1bd 100%);
}

.idea-page {
  min-height: 100vh;
  padding: 28rpx 34rpx 196rpx;
}

.idea-hero {
  position: relative;
  overflow: hidden;
  min-height: 520rpx;
  border-radius: 34rpx;
  background: #2b241d;
  box-shadow:
    0 30rpx 70rpx rgba(60, 42, 24, 0.18),
    inset 0 0 0 1rpx rgba(255, 249, 242, 0.22);
}

.idea-hero__image,
.idea-hero__shade,
.idea-hero__paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.idea-hero__image {
  opacity: 0.94;
}

.idea-hero__shade {
  background:
    linear-gradient(180deg, rgba(43, 36, 29, 0.08) 0%, rgba(43, 36, 29, 0.38) 38%, rgba(43, 36, 29, 0.82) 100%),
    linear-gradient(120deg, rgba(43, 36, 29, 0.72), rgba(98, 121, 131, 0.18) 48%, rgba(169, 77, 53, 0.3));
}

.idea-hero__paper {
  opacity: 0.35;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(255, 249, 242, 0.08) 0,
      rgba(255, 249, 242, 0.08) 1rpx,
      transparent 1rpx,
      transparent 18rpx
    ),
    repeating-linear-gradient(
      0deg,
      rgba(255, 249, 242, 0.06) 0,
      rgba(255, 249, 242, 0.06) 1rpx,
      transparent 1rpx,
      transparent 22rpx
    );
}

.idea-hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 520rpx;
  flex-direction: column;
  justify-content: flex-end;
  padding: 40rpx 40rpx 42rpx;
}

.idea-hero__meta-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.idea-hero__meta {
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 0.16em;
  color: rgba(255, 249, 242, 0.76);
}

.idea-hero__title {
  margin-bottom: 0;
  font-size: 46rpx;
  line-height: 1.32;
  letter-spacing: 3rpx;
  color: #fff9f2;
  opacity: 1;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.34);
}

.idea-hero__subtitle {
  max-width: 570rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.78;
  color: rgba(255, 249, 242, 0.82);
}

.theme-scroll {
  width: 100%;
  margin-top: 26rpx;
}

.theme-row {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  padding: 2rpx 12rpx 8rpx 0;
}

.theme-chip {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 60rpx;
  padding: 0 20rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.2);
  background: rgba(255, 249, 242, 0.62);
  color: #5f5145;
  box-shadow: 0 8rpx 18rpx rgba(84, 57, 31, 0.04);
  white-space: nowrap;
}

.theme-chip__text {
  display: block;
  font-size: 24rpx;
  line-height: 60rpx;
}

.theme-chip.theme-chip--active {
  border-color: rgba(169, 77, 53, 0.46);
  background: #a94d35;
  color: #fff9f2;
  box-shadow: 0 12rpx 26rpx rgba(169, 77, 53, 0.16);
}

.idea-list-block {
  margin-top: 26rpx;
}

.idea-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.idea-list-item {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 22rpx;
  overflow: hidden;
  padding: 26rpx 24rpx 26rpx 28rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.1);
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, rgba(255, 250, 239, 0.92), rgba(247, 238, 219, 0.76));
  box-shadow:
    0 18rpx 38rpx rgba(84, 57, 31, 0.07),
    inset 0 0 0 1rpx rgba(255, 249, 242, 0.56);
  transition: transform 160ms ease, opacity 160ms ease;
}

.idea-list-item:last-child {
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.1);
}

.idea-list-item--pressed {
  opacity: 0.9;
  transform: scale(0.985);
}

.idea-list-item--featured {
  display: block;
  padding: 0;
  border-radius: 34rpx;
  background: #fff8ea;
}

.idea-list-item__cover-wrap {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 248rpx;
  background: #2b241d;
}

.idea-list-item__cover {
  width: 100%;
  height: 100%;
  opacity: 0.94;
}

.idea-list-item__cover-label {
  position: absolute;
  left: 24rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255, 249, 242, 0.28);
  border-radius: 999rpx;
  background: rgba(43, 36, 29, 0.36);
  color: #fff9f2;
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 0.08em;
}

.idea-list-item__thumb-wrap {
  flex: 0 0 126rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #2b241d;
  box-shadow: inset 0 0 0 1rpx rgba(255, 249, 242, 0.22);
}

.idea-list-item__thumb {
  width: 100%;
  height: 100%;
}

.idea-list-item__stamp {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  min-height: 142rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(169, 77, 53, 0.18);
  background:
    linear-gradient(180deg, rgba(169, 77, 53, 0.1), rgba(109, 122, 82, 0.08)),
    rgba(255, 249, 242, 0.44);
}

.idea-list-item__stamp-text {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.1;
  text-align: center;
  color: rgba(153, 57, 33, 0.58);
}

.idea-list-item__main {
  flex: 1;
  min-width: 0;
}

.idea-list-item--featured .idea-list-item__main {
  padding: 26rpx 28rpx 28rpx;
}

.idea-list-item__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.idea-list-item__theme,
.idea-list-item__number {
  display: block;
  font-size: 20rpx;
  line-height: 1.35;
  letter-spacing: 0.12em;
  color: rgba(153, 57, 33, 0.68);
}

.idea-list-item__theme {
  max-width: 360rpx;
}

.idea-list-item__number {
  color: rgba(95, 82, 70, 0.5);
}

.idea-list-item__title {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #2b241d;
}

.idea-list-item--featured .idea-list-item__title {
  font-size: 42rpx;
  line-height: 1.34;
}

.idea-list-item__summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.68;
  color: #6a5a4b;
}

.idea-list-item__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(153, 57, 33, 0.08);
}

.idea-list-item__action {
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.12em;
  color: rgba(153, 57, 33, 0.72);
}

.idea-list-item__arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
  color: rgba(153, 57, 33, 0.56);
}

.idea-page .empty-state,
.idea-page .page-feedback {
  border-radius: 28rpx;
  background: rgba(255, 249, 242, 0.48);
  box-shadow: inset 0 0 0 1rpx rgba(153, 57, 33, 0.08);
}
