.service-gallery {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-gallery__hero-wrapper {
  position: relative;
}

.service-gallery__hero {
  display: block;
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
}

.service-gallery--single .service-gallery__hero {
  height: 708rpx;
}

.service-gallery--two .service-gallery__hero {
  height: 344rpx;
}

.service-gallery__counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(43, 36, 29, 0.56);
}

.service-gallery__counter-text {
  font-size: 24rpx;
  color: #fff9f2;
}

.service-gallery__topics {
  margin-top: -2rpx;
}

.service-gallery__topic-scroll {
  width: 100%;
  white-space: nowrap;
}

.service-gallery__topic-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 2rpx;
}

.service-gallery__topic-chip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 249, 242, 0.58);
  color: #6a5a4b;
}

.service-gallery__topic-chip--active {
  border-color: rgba(153, 57, 33, 0.36);
  background: rgba(255, 249, 242, 0.92);
  color: #993921;
}

.service-gallery__topic-name {
  font-size: 24rpx;
  font-weight: 500;
}

.service-gallery__strip {
  width: 100%;
}

.service-gallery__row {
  display: flex;
  gap: 16rpx;
}

.service-gallery__thumb {
  flex: 1 1 0;
  width: 0;
  height: 168rpx;
  border-radius: 24rpx;
}

.service-gallery__row--count-1 .service-gallery__thumb {
  height: 220rpx;
}

.service-gallery--two .service-gallery__row--count-1 .service-gallery__thumb {
  height: 344rpx;
}

.service-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.service-hero__title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.service-hero__title {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 62rpx;
}

.service-route-tags {
  margin-top: 18rpx;
  gap: 10rpx 16rpx;
}

.service-route-tag {
  letter-spacing: 1rpx;
}

.service-route-tag--clickable {
  color: #993921;
}

/* 创作者卡片（与人物页 creator-card 一致）：头像+名字+标签「创作者」「带领者」+ 对该目的地的个人宣传语（引号），点击进入创作者页 */
/* 上下间距：margin-top 为与主标题的间距，margin-bottom 为与下方「标签/团期」的间距 */
.creator-quote.creator-card {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 28rpx;
}

.creator-quote--tappable:active {
  opacity: 0.88;
}

.creator-quote .creator-card__head {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.creator-quote .creator-card__avatar {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid rgba(189, 154, 95, 0.34);
}

.creator-quote .creator-card__avatar-bg {
  background-color: rgba(189, 154, 95, 0.14);
}

.creator-quote .creator-card__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.creator-quote .creator-card__title-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.creator-quote .creator-card__name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 500;
  color: #2b241d;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-quote .creator-card__tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 0 8rpx;
  max-height: 32rpx;
  overflow: hidden;
  margin-top: 8rpx;
}

.creator-quote .creator-card__tag {
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 400;
  color: #8a7664;
}

.creator-quote .creator-card__tag-separator {
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 400;
  color: #8a7664;
}

.creator-quote .creator-card__stance {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.9;
  color: #6a5a4b;
}

.service-skeleton__creator {
  margin-top: 60rpx;
}

.service-skeleton__avatar {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
}

.service-skeleton__meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-hero__meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-info__body,
.service-creator__stance {
  font-size: 26rpx;
  line-height: 1.95;
  color: #6a5a4b;
}

.service-creator__button {
  width: 100%;
  margin-top: 24rpx;
}

/* 轻量路线信息条 */
.service-tags {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 30rpx;
}

.service-info-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 18rpx;
  margin-top: 30rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.08);
  border-radius: 22rpx;
  background: rgba(255, 249, 242, 0.54);
}

.service-info-item {
  display: flex;
  align-items: center;
  flex: 1 1 260rpx;
  min-width: 0;
}

.service-info-item--meetingPoint,
.service-info-item--dismissalPoint {
  align-items: flex-start;
}

.service-info-item--clickable {
  padding-right: 4rpx;
}

.service-info-item__inner {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.service-info-item--meetingPoint .service-info-item__inner,
.service-info-item--dismissalPoint .service-info-item__inner {
  align-items: flex-start;
  width: 100%;
}

.service-info-item__label {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.07);
  font-size: 22rpx;
  line-height: 1.35;
  color: #8a5a38;
}

.service-info-item__value {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.45;
  color: #2b241d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-info-item--meetingPoint .service-info-item__value,
.service-info-item--dismissalPoint .service-info-item__value {
  flex: 1;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-overflow: ellipsis;
  word-break: break-all;
  white-space: normal;
}

.service-info-item__arrow {
  flex: 0 0 auto;
  margin-left: 8rpx;
  font-size: 24rpx;
  color: rgba(153, 57, 33, 0.62);
}

/* 选择团期（横向滑动条） */
.service-periods {
  margin-top: 40rpx;
}

.service-periods__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.service-periods__title {
  flex: 1;
  min-width: 0;
}

.service-periods__cta {
  flex: 0 0 auto;
  margin: 0;
}

.service-periods__actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 14rpx;
}

.service-periods__consult {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.24);
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 500;
  color: #993921;
  background: rgba(255, 249, 242, 0.72);
}

.service-periods__consult:active {
  opacity: 0.82;
}

.service-periods__strip {
  width: 100%;
  white-space: nowrap;
}

.service-periods__row {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 0 8rpx 4rpx;
}

.period-card {
  position: relative;
  flex: 0 0 auto;
  width: 320rpx;
  min-width: 320rpx;
  padding: 28rpx 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.72), rgba(249, 244, 236, 0.48));
  border: 2rpx solid rgba(153, 57, 33, 0.1);
  border-radius: 22rpx;
  transition: border-color 0.2s, background 0.2s;
  box-sizing: border-box;
  overflow: visible;
}

.period-card--selected {
  border-color: rgba(209, 94, 20, 0.5);
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.9), rgba(209, 94, 20, 0.08));
}

.period-card__check {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #D15E14;
}

.period-card__date {
  display: block;
  font-size: 26rpx;
  line-height: 1.4;
  color: #2b241d;
  margin-bottom: 8rpx;
  padding-right: 36rpx;
  white-space: normal;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.period-card--selected .period-card__date {
  color: #2b241d;
}

.period-card__meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.period-card__version,
.period-card__duration {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #8a5a38;
  background: rgba(189, 154, 95, 0.12);
}

.period-card__price {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b241d;
  margin-right: 16rpx;
}

.period-card__price--active {
  color: #D15E14;
}

.period-card__status {
  font-size: 26rpx;
  color: #6a5a4b;
}

/* 团期选择底部面板 */
.period-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.period-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.34);
}

.period-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  background:
    linear-gradient(180deg, #FFF9F2 0%, #F9F4EC 64%, #F2E6C9 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 46rpx rgba(84, 57, 31, 0.14);
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 280ms cubic-bezier(0.32, 0.72, 0.2, 1);
}

.period-sheet__panel--active {
  transform: translateY(0);
}

.period-sheet__handle {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.18);
  margin: 20rpx auto 12rpx;
}

.period-sheet__header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  padding: 0 92rpx 24rpx 32rpx;
}

.period-sheet__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2b241d;
}

.period-sheet__body {
  flex: 1;
  padding: 0 32rpx 24rpx;
  max-height: 60vh;
}

.period-sheet__section {
  margin-bottom: 32rpx;
}

.period-sheet__versions {
  white-space: nowrap;
}

.period-sheet__versions-inner {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 6rpx;
}

.period-version {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #6a5a4b;
  background: rgba(255, 249, 242, 0.66);
  border-radius: 999rpx;
}

.period-version--active {
  background: rgba(209, 94, 20, 0.1);
  color: #D15E14;
  font-weight: 500;
}

.period-sheet__label {
  font-size: 28rpx;
  font-weight: 500;
  color: #2b241d;
  display: block;
  margin-bottom: 16rpx;
}

.period-sheet__months {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.period-month {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #6a5a4b;
  background: rgba(255, 249, 242, 0.66);
  border-radius: 999rpx;
}

.period-month--active {
  background: rgba(209, 94, 20, 0.1);
  color: #D15E14;
  font-weight: 500;
}

.period-sheet__dates {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.period-sheet__dates-inner {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 0;
}

.period-date {
  position: relative;
  flex: 0 0 auto;
  width: 300rpx;
  min-width: 300rpx;
  padding: 24rpx;
  padding-right: 44rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.74), rgba(249, 244, 236, 0.48));
  border: 2rpx solid rgba(153, 57, 33, 0.1);
  border-radius: 22rpx;
}

.period-date--selected {
  border-color: rgba(209, 94, 20, 0.5);
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.9), rgba(209, 94, 20, 0.08));
}

.period-date__start,
.period-date__end {
  display: inline-block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #2b241d;
  white-space: nowrap;
}

.period-date__range {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.period-date__info {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.period-date__version,
.period-date__duration {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #8a5a38;
  background: rgba(189, 154, 95, 0.12);
}

.period-date__meta {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.period-date__price {
  font-size: 28rpx;
  font-weight: 600;
  color: #D15E14;
}

.period-date__status {
  font-size: 24rpx;
  color: #6a5a4b;
}

.period-date__check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #D15E14;
}

.period-sheet__people-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.period-sheet__people-control {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 18rpx;
  padding: 10rpx 0 4rpx;
}

.period-sheet__notice-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  min-width: 0;
  gap: 6rpx;
  padding: 10rpx 0 4rpx;
  color: #993921;
}

.period-sheet__notice-link:active {
  opacity: 0.72;
}

.period-sheet__notice-link-text {
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
}

.period-sheet__notice-link-arrow {
  flex: 0 0 auto;
  font-size: 24rpx;
  line-height: 1.45;
}

.period-sheet__helper {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a5a38;
}

.period-sheet__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 0;
  min-height: 0;
  padding: 24rpx 0 24rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 249, 242, 0.92);
  border-top: 1rpx solid rgba(153, 57, 33, 0.1);
}

.period-sheet__total {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.period-sheet__total-label {
  font-size: 28rpx;
  color: #2b241d;
}

.period-sheet__total-price {
  font-size: 40rpx;
  font-weight: 600;
  color: #D15E14;
}

.period-sheet__next {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 220rpx;
  width: 220rpx;
  height: 82rpx;
  margin-left: 0;
  padding: 0;
  min-height: 82rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: #fff9f2;
  background: #D15E14;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(209, 94, 20, 0.18);
}

.period-sheet__next::after {
  border: none;
}

.period-sheet__next--disabled {
  color: rgba(255, 255, 255, 0.82);
  background: rgba(153, 57, 33, 0.32);
  box-shadow: none;
}

.period-sheet__section .stepper__button {
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  min-height: 48rpx;
  padding: 0;
  font-size: 28rpx;
  line-height: 48rpx;
  text-align: center;
  color: #2b241d;
  background: rgba(153, 57, 33, 0.08);
  border-radius: 14rpx;
  border: none;
  box-sizing: border-box;
}

.period-sheet__section .stepper__button::after {
  border: none;
}

.period-sheet__section .stepper__value {
  font-size: 28rpx;
  font-weight: 500;
  min-width: 40rpx;
  text-align: center;
}

.travel-detail-shell {
  position: relative;
}

.travel-detail-tabs-anchor {
  height: 1rpx;
  margin-bottom: -1rpx;
  opacity: 0;
}

.travel-detail-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 12rpx 0 28rpx;
  background:
    linear-gradient(180deg, rgba(242, 230, 201, 0.99), rgba(242, 230, 201, 0.92));
}

.travel-detail-tabs--sticky .section-tabs {
  box-shadow: 0 14rpx 28rpx rgba(43, 36, 29, 0.08);
}

.travel-section {
  margin-top: 56rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.travel-section__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.travel-section__title {
  display: block;
  color: #993921;
}

.travel-section__version-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.travel-section__version-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8a5a38;
  background: rgba(189, 154, 95, 0.12);
}

.travel-section__version-tag--active {
  color: #fff9f2;
  background: #D15E14;
}

.travel-section__hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8a5a38;
}

.travel-highlights {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.travel-overview {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.travel-overview__image {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  display: block;
}

.travel-overview__video-shell {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #1f1b16;
}

.travel-overview__video {
  display: block;
  width: 100%;
  height: 420rpx;
}

.travel-overview__subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 500;
  color: #3f352b;
}

.travel-overview__body {
  display: block;
  font-size: 26rpx;
  line-height: 1.9;
  color: #6a5a4b;
  white-space: pre-line;
}

.travel-overview__body--suitable {
  color: #6a5a4b;
}

.travel-highlight-card {
  padding: 0 0 28rpx;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.1);
  border-radius: 0;
  background: transparent;
}

.travel-highlight-card__title {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 500;
  color: #3f352b;
}

.travel-highlight-card__title::before {
  content: "";
  flex: 0 0 4rpx;
  width: 4rpx;
  height: 28rpx;
  margin-top: 6rpx;
  background: rgba(153, 57, 33, 0.42);
}

.travel-highlight-card__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.85;
  color: #6a5a4b;
}

.travel-highlight-card__gallery {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.travel-highlight-card__gallery-row {
