}

.media-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.media-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.28);
}

.media-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 140rpx;
  height: calc(100vh - 140rpx);
  background:
    linear-gradient(180deg, #FFF9F2 0%, #F9F4EC 64%, #F2E6C9 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 46rpx rgba(84, 57, 31, 0.14);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.media-sheet__panel--active {
  transform: translateY(0);
}

.media-sheet__handle {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.18);
  margin: 20rpx auto 12rpx;
}

.media-sheet__header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  position: relative;
  padding: 0 92rpx 16rpx 32rpx;
}

.media-sheet__tabs-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.media-sheet__tabs {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 4rpx 4rpx 0;
}

.media-sheet__tab {
  flex: 0 0 auto;
  max-width: 280rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: rgba(255, 249, 242, 0.58);
  color: #6a5a4b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-sheet__tab--active {
  background: rgba(255, 249, 242, 0.96);
  color: #993921;
  font-weight: 500;
}

.media-sheet__body {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.media-sheet__images {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.media-sheet__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.media-sheet__loading-text {
  font-size: 26rpx;
  color: #6a5a4b;
}

.media-sheet__image {
  display: block;
  width: 100%;
  border-radius: 24rpx;
}

