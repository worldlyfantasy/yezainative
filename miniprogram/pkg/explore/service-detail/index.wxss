  flex: 0 0 auto;
}

.travel-cost-stack {
  display: flex;
  flex-direction: column;
  gap: 44rpx;
}

.travel-subsection {
  margin-top: 32rpx;
}

.travel-subsection:first-of-type {
  margin-top: 0;
}

.travel-subsection__title {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 500;
  color: #3f352b;
}

.travel-subsection__title::before {
  content: "";
  flex: 0 0 4rpx;
  width: 4rpx;
  height: 28rpx;
  margin-top: 6rpx;
  background: rgba(153, 57, 33, 0.42);
}

.travel-notice-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.travel-notice {
  padding-top: 4rpx;
}

.travel-notice__title {
  display: flex;
  align-items: flex-start;
