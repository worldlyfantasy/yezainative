<view wx:if="{{loading}}" class="page-shell">
  <view class="skeleton-line skeleton-line--back"></view>

  <view class="section-block service-gallery">
    <view class="skeleton-card skeleton-card--hero"></view>
    <view class="service-gallery__row">
      <view class="skeleton-card skeleton-card--thumb"></view>
      <view class="skeleton-card skeleton-card--thumb"></view>
      <view class="skeleton-card skeleton-card--thumb"></view>
    </view>
  </view>

  <view class="section-block paper-block">
    <view class="skeleton-line skeleton-line--eyebrow"></view>
    <view class="skeleton-line skeleton-line--page-title"></view>

    <view class="service-skeleton__creator skeleton-row">
      <view class="service-skeleton__avatar skeleton-circle"></view>
      <view class="service-skeleton__meta">
        <view class="skeleton-line skeleton-line--medium"></view>
        <view class="skeleton-line skeleton-line--long"></view>
        <view class="skeleton-line skeleton-line--short"></view>
      </view>
    </view>

    <view class="service-tags">
      <view class="skeleton-card skeleton-card--tag"></view>
      <view class="skeleton-card skeleton-card--tag"></view>
      <view class="skeleton-card skeleton-card--tag"></view>
      <view class="skeleton-card skeleton-card--tag"></view>
    </view>
  </view>

  <view class="section-block">
    <view class="skeleton-line skeleton-line--section"></view>
    <view class="skeleton-card-list">
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
    </view>
  </view>
</view>

<view wx:elif="{{service}}" class="page-shell">
  <text class="back-link" bindtap="goBack">← 返回旅程</text>

  <view wx:if="{{galleryHero || heroCover}}" class="section-block service-gallery {{galleryLayoutClass}}">
    <view class="service-gallery__hero-wrapper" bindtap="openMediaSheet">
      <image
        class="service-gallery__hero"
        src="{{galleryHero || heroCover}}"
        mode="{{galleryHeroMode || 'aspectFill'}}"
        lazy-load="{{true}}"
      ></image>
      <view wx:if="{{galleryCounterText}}" class="service-gallery__counter">
        <text class="service-gallery__counter-text">{{galleryCounterText}}</text>
      </view>
    </view>
    <view wx:if="{{galleryThumbs.length}}" class="service-gallery__strip">
      <view class="service-gallery__row service-gallery__row--count-{{galleryThumbs.length}}">
        <image
          wx:for="{{galleryThumbs}}"
          wx:key="*this"
          class="service-gallery__thumb"
          src="{{item}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          bindtap="openMediaSheet"
        ></image>
      </view>
    </view>
    <view wx:if="{{galleryTabs.length > 1}}" class="service-gallery__topics">
      <scroll-view class="service-gallery__topic-scroll" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
        <view class="service-gallery__topic-row">
          <view
            wx:for="{{galleryTabs}}"
            wx:key="key"
            class="service-gallery__topic-chip {{index === activeGalleryTabIndex ? 'service-gallery__topic-chip--active' : ''}}"
            data-index="{{index}}"
            catchtap="onGalleryTabTap"
          >
            <text class="service-gallery__topic-name">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="section-block paper-block">
    <view class="service-hero">
      <view class="service-hero__content">
        <text class="page-eyebrow">{{service.type}}</text>
        <view class="service-hero__title-row">
          <text class="page-title service-hero__title">{{service.name}}</text>
          <view class="detail-action-group">
            <favorite-star
              favorited="{{service.isFavorited}}"
              notice-state="{{favoriteNoticeState}}"
              notice-label="{{favoriteNoticeLabel}}"
              notice-action-label="{{favoriteNoticeActionLabel}}"
              notice-mode="{{favoriteNoticeMode}}"
              bind:toggle="toggleFavorite"
              bind:noticeaction="handleFavoriteNoticeAction"
            ></favorite-star>
          </view>
        </view>
        <view wx:if="{{serviceRouteTags && serviceRouteTags.length}}" class="row-tags service-route-tags">
          <text
            wx:for="{{serviceRouteTags}}"
            wx:key="*this"
            class="tag-chip service-route-tag service-route-tag--clickable"
            data-tag="{{item}}"
            bindtap="onRouteTagTap"
          >{{item}}</text>
        </view>
        <view wx:if="{{creator}}" class="creator-quote creator-card creator-quote--tappable" bindtap="goCreatorDetail">
          <view class="creator-card__head">
            <image class="creator-card__avatar" src="{{creator.avatar}}" mode="aspectFill"></image>
            <view class="creator-card__meta">
              <view class="creator-card__title-row">
                <text class="creator-card__name">{{creator.name}}</text>
                <view class="creator-card__tags">
                  <text
                    wx:for="{{service.creatorRoles}}"
                    wx:key="*this"
                    class="creator-card__tag"
                  >{{item}}</text>
                </view>
              </view>
              <text class="creator-card__stance">"{{creatorQuoteText || service.summary}}"</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{serviceMetaCards && serviceMetaCards.length > 0}}" class="service-info-strip">
      <view
        wx:for="{{serviceMetaCards}}"
        wx:key="key"
        class="service-info-item {{item.clickable ? 'service-info-item--clickable' : ''}}"
        data-key="{{item.key}}"
        bindtap="{{item.clickable ? 'onTagTap' : ''}}"
      >
        <view class="service-info-item__inner">
          <text class="service-info-item__label">{{item.label}}</text>
          <text class="service-info-item__value">{{item.value}}</text>
        </view>
        <text wx:if="{{item.clickable}}" class="service-info-item__arrow">></text>
      </view>
    </view>

    <view wx:if="{{groupPeriods && groupPeriods.length > 0}}" class="service-periods">
      <view class="service-periods__head">
        <text class="section-title service-periods__title">选择团期</text>
        <view class="service-periods__actions">
          <view class="service-periods__cta cta-pill-button" bindtap="onViewMorePeriods">立即报名</view>
          <view class="service-periods__consult" bindtap="openConsultSheet">路线咨询</view>
        </view>
      </view>
      <scroll-view class="service-periods__strip" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
        <view class="service-periods__row">
          <view
            wx:for="{{groupPeriods}}"
            wx:key="id"
            class="period-card {{selectedPeriodId === item.id ? 'period-card--selected' : ''}}"
            data-period="{{item}}"
            bindtap="onSelectPeriod"
          >
            <view wx:if="{{selectedPeriodId === item.id}}" class="period-card__check">✓</view>
            <view wx:if="{{showGroupPeriodVersionTags && (item.versionName || item.durationLabel)}}" class="period-card__meta-row">
              <text wx:if="{{showGroupPeriodVersionTags && item.versionName}}" class="period-card__version">{{item.versionName}}</text>
              <text wx:if="{{item.durationLabel}}" class="period-card__duration">{{item.durationLabel}}</text>
            </view>
            <text class="period-card__date">{{item.dateLabel}}</text>
            <text class="period-card__price {{selectedPeriodId === item.id ? 'period-card__price--active' : ''}}">¥{{item.price}}</text>
            <text class="period-card__status">{{item.statusText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{travelDetail}}" class="section-block travel-detail-shell">
    <view class="js-section-tabs-anchor travel-detail-tabs-anchor"></view>
    <view class="js-section-tabs travel-detail-tabs {{isSectionTabsSticky ? 'travel-detail-tabs--sticky' : ''}}">
      <section-tabs
        sections="{{travelDetail.sections}}"
        active-key="{{activeSectionKey}}"
        bind:tabtap="onSectionTabTap"
      ></section-tabs>
    </view>

    <block wx:for="{{travelDetail.sections}}" wx:key="key" wx:for-item="sectionItem">
      <view wx:if="{{sectionItem.key === 'overview'}}" id="{{sectionItem.anchorId}}" class="travel-section">
        <view class="travel-section__head">
          <text class="section-title travel-section__title">{{sectionItem.title}}</text>
        </view>
        <view class="travel-overview">
          <image
            wx:if="{{travelDetail.overview && travelDetail.overview.coverImage}}"
            class="travel-overview__image"
            src="{{travelDetail.overview.coverImage}}"
            mode="aspectFill"
            bindload="onTravelDetailMediaLoad"
            bindtap="onOverviewImageTap"
          ></image>
          <text wx:if="{{travelDetail.overview && travelDetail.overview.whyJoinText}}" class="travel-overview__body">
            {{travelDetail.overview.whyJoinText}}
          </text>
          <text class="travel-overview__subtitle">
            {{suitableTitleText || (travelDetail.overview && travelDetail.overview.suitableTitle) || '这段旅程适合谁'}}
          </text>
          <text wx:if="{{travelDetail.overview && travelDetail.overview.suitableText}}" class="travel-overview__body travel-overview__body--suitable">
            {{travelDetail.overview.suitableText}}
          </text>
        </view>
      </view>

      <view wx:if="{{sectionItem.key === 'highlights'}}" id="{{sectionItem.anchorId}}" class="travel-section">
        <view class="travel-section__head">
          <text class="section-title travel-section__title">{{sectionItem.title}}</text>
        </view>
        <view class="travel-highlights">
          <view
            wx:for="{{travelDetail.highlights}}"
            wx:key="id"
            wx:for-item="highlight"
            wx:for-index="highlightIndex"
            class="travel-highlight-card"
          >
            <text class="travel-highlight-card__title">{{highlight.title}}</text>
            <text class="travel-highlight-card__desc">{{highlight.description}}</text>
            <scroll-view
              wx:if="{{highlight.images && highlight.images.length}}"
              class="travel-highlight-card__gallery"
              scroll-x="true"
              enable-flex="true"
              show-scrollbar="{{false}}"
            >
              <view class="travel-highlight-card__gallery-row">
                <image
                  wx:for="{{highlight.images}}"
                  wx:key="*this"
                  wx:for-item="imageUrl"
                  wx:for-index="imageIndex"
                  class="travel-highlight-card__image"
                  src="{{imageUrl}}"
                  mode="aspectFill"
                  lazy-load="{{true}}"
                  bindload="onTravelDetailMediaLoad"
                  data-card-index="{{highlightIndex}}"
                  data-image-index="{{imageIndex}}"
                  bindtap="onHighlightImageTap"
                ></image>
              </view>
            </scroll-view>
          </view>
        </view>
      </view>

      <view wx:if="{{sectionItem.key === 'itinerary'}}" id="{{sectionItem.anchorId}}" class="travel-section">
        <view class="travel-section__head">
          <text class="section-title travel-section__title">{{sectionItem.title}}</text>
          <view wx:if="{{itineraryVersions.length > 1}}" class="travel-section__version-tags">
            <text
              wx:for="{{itineraryVersions}}"
              wx:key="key"
              class="travel-section__version-tag {{activeItineraryVersionKey === item.key ? 'travel-section__version-tag--active' : ''}}"
              data-version-name="{{item.versionName}}"
              bindtap="onItineraryVersionTap"
            >{{item.versionName}}</text>
          </view>
        </view>
        <itinerary-block itinerary="{{displayItinerary}}"></itinerary-block>
      </view>

      <view wx:if="{{sectionItem.key === 'notices'}}" id="{{sectionItem.anchorId}}" class="travel-section">
        <view class="travel-section__head">
          <text class="section-title travel-section__title">{{sectionItem.title}}</text>
        </view>
        <view class="travel-cost-stack">
          <!-- 抵达交通 -->
          <block wx:for="{{travelDetail.notices}}" wx:key="key">
            <cost-table
              wx:if="{{item.key === 'traffic'}}"
              default-expanded="{{true}}"
              title="抵达交通"
              content="{{item.content}}"
            ></cost-table>
          </block>

          <!-- 费用包含 -->
          <cost-table
            wx:for="{{costTableGroups}}"
            wx:key="key"
            wx:if="{{item.key === 'include'}}"
            default-expanded="{{true}}"
            title="{{item.title}}"
            rows="{{item.rows}}"
          ></cost-table>

          <!-- 费用不含 -->
          <cost-table
            wx:for="{{costTableGroups}}"
            wx:key="key"
            wx:if="{{item.key === 'exclude'}}"
            default-expanded="{{true}}"
            title="{{item.title}}"
            rows="{{item.rows}}"
          ></cost-table>

          <!-- 变更说明 -->
          <cost-table
            wx:for="{{costTableGroups}}"
            wx:key="key"
            wx:if="{{item.key === 'refundRules'}}"
            default-expanded="{{true}}"
            title="{{item.title}}"
            rows="{{item.rows}}"
          ></cost-table>
        </view>
      </view>
    </block>
  </view>
  <view wx:if="{{periodSheetVisible}}" class="period-sheet">
    <view class="period-sheet__backdrop" bindtap="closePeriodSheet"></view>
    <view class="period-sheet__panel {{periodSheetAnimating ? 'period-sheet__panel--active' : ''}}">
      <view class="period-sheet__handle"></view>
      <view class="period-sheet__header">
        <text class="period-sheet__title">日期/人数</text>
        <view class="sheet-close period-sheet__close" bindtap="closePeriodSheet">⌄</view>
      </view>
      <scroll-view class="period-sheet__body" scroll-y="true">
        <view wx:if="{{periodSheetVersions.length > 1}}" class="period-sheet__section">
          <text class="period-sheet__label">版本</text>
          <scroll-view class="period-sheet__versions" scroll-x="true">
            <view class="period-sheet__versions-inner">
              <view
                wx:for="{{periodSheetVersions}}"
                wx:key="key"
                class="period-version {{periodSheetActiveVersion === item.key ? 'period-version--active' : ''}}"
                data-version-key="{{item.key}}"
                bindtap="onSelectPeriodVersion"
              >{{item.label}}</view>
            </view>
          </scroll-view>
        </view>
        <view class="period-sheet__section">
          <text class="period-sheet__label">出发日期</text>
          <view class="period-sheet__months">
            <view
              wx:for="{{periodSheetMonths}}"
              wx:key="*this"
              class="period-month {{periodSheetActiveMonth === item ? 'period-month--active' : ''}}"
              data-month="{{item}}"
              bindtap="onSelectMonth"
            >{{item}}</view>
          </view>
          <scroll-view class="period-sheet__dates" scroll-x="true">
            <view class="period-sheet__dates-inner">
              <view
                wx:for="{{periodSheetDates}}"
                wx:key="id"
                class="period-date {{periodSheetSelectedDateId === item.id ? 'period-date--selected' : ''}}"
                data-date="{{item}}"
                bindtap="onSelectSheetDate"
              >
                <view wx:if="{{item.versionName || item.durationLabel}}" class="period-date__info">
                  <text wx:if="{{item.versionName}}" class="period-date__version">{{item.versionName}}</text>
                  <text wx:if="{{item.durationLabel}}" class="period-date__duration">{{item.durationLabel}}</text>
                </view>
                <view class="period-date__range">
                  <text class="period-date__start">{{item.startDateLabel}} -</text>
                  <text class="period-date__end">{{item.endDateLabel}}</text>
                </view>
                <view class="period-date__meta">
                  <text class="period-date__price">¥{{item.price}}</text>
                  <text class="period-date__status">{{item.statusText}}</text>
                </view>
                <view wx:if="{{periodSheetSelectedDateId === item.id}}" class="period-date__check">✓</view>
              </view>
            </view>
          </scroll-view>
        </view>
        <view class="period-sheet__section">
          <text class="period-sheet__label">出行人数</text>
          <view class="period-sheet__people-control">
            <button class="stepper__button" bindtap="decreaseSheetPeople">-</button>
            <text class="stepper__value">{{periodSheetPeople}}</text>
            <button class="stepper__button" bindtap="increaseSheetPeople">+</button>
          </view>
          <text wx:if="{{periodSheetPeopleLimitText}}" class="period-sheet__helper">{{periodSheetPeopleLimitText}}</text>
        </view>
      </scroll-view>
      <view class="period-sheet__footer">
        <view class="period-sheet__total">
          <text class="period-sheet__total-label">总价</text>
          <text class="period-sheet__total-price">¥{{periodSheetTotalPrice}}</text>
        </view>
        <button
          class="period-sheet__next {{!periodSheetCanCheckout ? 'period-sheet__next--disabled' : ''}}"
          bindtap="goToCheckout"
          disabled="{{!periodSheetCanCheckout}}"
        >立即报名</button>
      </view>
    </view>
  </view>

  <view wx:if="{{mediaSheetVisible}}" class="media-sheet">
    <view class="media-sheet__backdrop" bindtap="closeMediaSheet"></view>
    <view class="media-sheet__panel {{mediaSheetAnimating ? 'media-sheet__panel--active' : ''}}">
      <view class="media-sheet__handle"></view>
      <view class="media-sheet__header">
        <view class="media-sheet__tabs">
          <view
            wx:for="{{mediaTabs}}"
            wx:key="key"
            class="media-sheet__tab {{index === activeMediaTabIndex ? 'media-sheet__tab--active' : ''}}"
            data-index="{{index}}"
            bindtap="onMediaTabChange"
          >
            {{item.label}}
          </view>
        </view>
        <view class="sheet-close media-sheet__close" bindtap="closeMediaSheet">⌄</view>
      </view>
      <scroll-view class="media-sheet__body" scroll-y="true">
        <view wx:if="{{galleryLoading && !mediaTabs.length}}" class="media-sheet__loading">
          <text class="media-sheet__loading-text">正在加载全部图集...</text>
        </view>
        <view wx:elif="{{mediaTabs.length && mediaTabs[activeMediaTabIndex]}}" class="media-sheet__images">
          <image
            wx:for="{{mediaTabs[activeMediaTabIndex].images}}"
            wx:key="*this"
            wx:for-index="index"
            class="media-sheet__image"
            src="{{item}}"
            mode="widthFix"
            lazy-load="{{true}}"
            data-tab-index="{{activeMediaTabIndex}}"
            data-image-index="{{index}}"
            bindtap="onMediaImageTap"
          ></image>
        </view>
        <view wx:else class="media-sheet__loading">
          <text class="media-sheet__loading-text">暂时没有可查看的图集</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{consultSheetVisible}}" class="consult-sheet">
    <view class="consult-sheet__backdrop" bindtap="closeConsultSheet"></view>
    <view class="consult-sheet__panel {{consultSheetAnimating ? 'consult-sheet__panel--active' : ''}}">
      <view class="consult-sheet__handle"></view>
      <view class="consult-sheet__header">
        <text class="consult-sheet__title">{{consultSheetTitle}}</text>
        <view class="sheet-close consult-sheet__close" bindtap="closeConsultSheet">⌄</view>
      </view>
      <view class="consult-sheet__cards">
        <view wx:if="{{consultWeChatQr}}" class="consult-card consult-card--tappable" bindtap="onConsultQrTap">
          <image class="consult-card__qr" src="{{consultWeChatQr}}" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
          <text class="consult-card__label">路线专属客服</text>
          <text wx:if="{{consultCardLabel}}" class="consult-card__desc">{{consultCardLabel}}</text>
          <text class="consult-card__desc">{{consultCardDesc}}</text>
          <text class="consult-card__desc">{{consultFollowupNote}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{suitableSheetVisible}}" class="suitable-sheet">
    <view class="suitable-sheet__backdrop" bindtap="closeSuitableSheet"></view>
    <view class="suitable-sheet__panel {{suitableSheetAnimating ? 'suitable-sheet__panel--active' : ''}}">
      <view class="suitable-sheet__handle"></view>
      <view class="suitable-sheet__header">
        <text class="suitable-sheet__title">{{suitableTitleText || '这段旅程适合谁'}}</text>
        <view class="sheet-close suitable-sheet__close" bindtap="closeSuitableSheet">⌄</view>
      </view>
      <scroll-view class="suitable-sheet__body" scroll-y="true">
        <text class="suitable-sheet__content">{{suitableSheetContent}}</text>
      </scroll-view>
    </view>
  </view>

  <favorite-star
    show-button="{{false}}"
    notice-state="{{checkoutNoticeState}}"
    notice-label="{{checkoutNoticeLabel}}"
    notice-action-label="{{checkoutNoticeActionLabel}}"
    notice-mode="{{checkoutNoticeMode}}"
    notice-elevated="{{true}}"
    bind:noticeaction="handleCheckoutNoticeAction"
  ></favorite-star>
</view>

<app-tab-bar wx:if="{{!periodSheetVisible && !mediaSheetVisible && !consultSheetVisible && !suitableSheetVisible}}"></app-tab-bar>
