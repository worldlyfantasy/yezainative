<view wx:if="{{service}}" class="checkout-screen">
  <bottom-action-bar
    placement="sticky-top"
    label-text="{{amountLabelText}}"
    price-text="{{payableText}}"
    button-text="{{submitButtonText}}"
    loading-text="提交中..."
    disabled="{{submitting}}"
    loading="{{submitting}}"
    bind:actiontap="submitOrder"
    class="checkout-action-bar"
  ></bottom-action-bar>

  <view class="page-shell checkout-page">
  <!-- 订单摘要模块 -->
  <view class="checkout-summary paper-block">
    <text class="section-title">{{summaryTitleText}}</text>
    <view class="checkout-summary__row">
      <text class="checkout-summary__label">行程名称</text>
      <text class="checkout-summary__value">{{service.name}}</text>
    </view>
    <view class="checkout-summary__row">
      <text class="checkout-summary__label">版本名称</text>
      <text class="checkout-summary__value">{{selectedVersion}}</text>
    </view>
    <view class="checkout-summary__row">
      <text class="checkout-summary__label">出发日期</text>
      <text class="checkout-summary__value">{{selectedDateText}}</text>
    </view>
    <view class="checkout-summary__row">
      <text class="checkout-summary__label">单价</text>
      <text class="checkout-summary__value">¥{{summaryPrice}}</text>
    </view>
    <view class="checkout-summary__row">
      <text class="checkout-summary__label">出行人数</text>
      <text class="checkout-summary__value">{{summaryCount}} 人</text>
    </view>
  </view>

  <!-- 出行人信息（动态数量） -->
  <view class="section-block paper-block checkout-travelers-block">
    <text class="section-title">出行人信息</text>
    <view class="checkout-travelers">
      <view wx:for="{{travelPersons}}" wx:for-index="idx" wx:key="index" class="checkout-traveler">
        <view class="checkout-traveler__header">
          <text class="checkout-traveler__title">出行人 {{item.index}}</text>
        </view>

        <view class="checkout-field-group">
          <text class="checkout-field-label">姓名</text>
          <input class="search-input checkout-field {{travelPersonErrors[idx].name ? 'checkout-field--error' : ''}}" placeholder="真实姓名" data-index="{{item.index}}" data-field="name" value="{{item.name}}" bindinput="onTravelPersonInput" bindblur="onTravelPersonBlur" />
          <text wx:if="{{travelPersonErrors[idx].name}}" class="checkout-field-error">{{travelPersonErrors[idx].name}}</text>
        </view>

        <view class="checkout-field-group">
          <text class="checkout-field-label">证件信息</text>
          <view class="checkout-document-row">
            <view class="checkout-document-col checkout-document-col--type">
              <picker class="filter-picker-trigger checkout-document-trigger" mode="selector" range="{{documentTypeOptions}}" value="{{item.documentTypeIndex}}" data-index="{{item.index}}" bindchange="onTravelPersonDocumentTypeChange">
                <view class="filter-picker checkout-picker-value {{travelPersonErrors[idx].documentType ? 'checkout-field--error' : ''}} {{item.documentType ? '' : 'checkout-picker-value--placeholder'}}">{{item.documentType ? documentTypeOptions[item.documentTypeIndex] : "证件类型"}}</view>
              </picker>
              <text wx:if="{{travelPersonErrors[idx].documentType}}" class="checkout-field-error checkout-field-error--compact">{{travelPersonErrors[idx].documentType}}</text>
            </view>
            <view class="checkout-document-col checkout-document-col--number">
              <input class="search-input checkout-document-input {{travelPersonErrors[idx].documentNumber ? 'checkout-field--error' : ''}}" placeholder="{{item.documentType === 'passport' ? '护照号' : (item.documentType === 'idCard' ? '身份证号' : '证件号')}}" maxlength="18" data-index="{{item.index}}" data-field="documentNumber" value="{{item.documentNumber}}" bindinput="onTravelPersonInput" bindblur="onTravelPersonBlur" />
              <text wx:if="{{travelPersonErrors[idx].documentNumber}}" class="checkout-field-error checkout-field-error--compact">{{travelPersonErrors[idx].documentNumber}}</text>
            </view>
          </view>
        </view>

        <view class="checkout-field-group">
          <text class="checkout-field-label">手机号</text>
          <input class="search-input checkout-field {{travelPersonErrors[idx].phone ? 'checkout-field--error' : ''}}" placeholder="常用手机号" type="number" maxlength="11" data-index="{{item.index}}" data-field="phone" value="{{item.phone}}" bindinput="onTravelPersonInput" bindblur="onTravelPersonBlur" />
          <text wx:if="{{travelPersonErrors[idx].phone}}" class="checkout-field-error">{{travelPersonErrors[idx].phone}}</text>
        </view>

        <view class="checkout-field-group">
          <text class="checkout-field-label">微信号（选填）</text>
          <input class="search-input checkout-field" placeholder="微信号" data-index="{{item.index}}" data-field="wechat" value="{{item.wechat}}" bindinput="onTravelPersonInput" />
        </view>

        <view class="checkout-field-group">
          <text class="checkout-field-label">备注需求（选填）</text>
          <textarea class="checkout-note" placeholder="饮食禁忌、过敏源等补充说明" data-index="{{item.index}}" data-field="note" value="{{item.note}}" bindinput="onTravelPersonInput"></textarea>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系人信息 -->
  <view class="section-block paper-block checkout-contact-block">
    <text class="section-title">联系人信息</text>
    <view class="checkout-contact-card">
      <view class="checkout-field-group">
        <text class="checkout-field-label">联系人姓名</text>
        <input class="search-input checkout-field {{contactErrors.contactName ? 'checkout-field--error' : ''}}" placeholder="联系人姓名" data-field="contactName" value="{{contactName}}" bindinput="onContactInput" bindblur="onContactBlur" />
        <text wx:if="{{contactErrors.contactName}}" class="checkout-field-error">{{contactErrors.contactName}}</text>
      </view>
      <view class="checkout-field-group">
        <text class="checkout-field-label">联系电话</text>
        <input class="search-input checkout-field {{contactErrors.contactPhone ? 'checkout-field--error' : ''}}" placeholder="手机号或座机" maxlength="20" data-field="contactPhone" value="{{contactPhone}}" bindinput="onContactInput" bindblur="onContactBlur" />
        <text wx:if="{{contactErrors.contactPhone}}" class="checkout-field-error">{{contactErrors.contactPhone}}</text>
      </view>
    </view>
  </view>

  <!-- 协议确认 -->
  <view class="section-block paper-block checkout-agreements">
    <text class="checkout-agreement-intro">我已阅读并同意：</text>
    <checkbox-group class="checkout-agreement-list" bindchange="onAgreementChange">
      <label class="checkout-agreement__label">
        <checkbox value="service" checked="{{agreedService}}" color="#6b5344" />
        <view class="checkout-agreement__link-wrap" catchtap="onAgreementLinkTap" data-key="service">
          <text class="checkout-agreement__link">《{{serviceAgreementTitle}}》</text>
        </view>
      </label>
      <label class="checkout-agreement__label">
        <checkbox value="risk" checked="{{agreedRisk}}" color="#6b5344" />
        <view class="checkout-agreement__link-wrap" catchtap="onAgreementLinkTap" data-key="risk">
          <text class="checkout-agreement__link">《{{riskAgreementTitle}}》</text>
        </view>
      </label>
      <label class="checkout-agreement__label">
        <checkbox value="refund" checked="{{agreedRefund}}" color="#6b5344" />
        <view class="checkout-agreement__link-wrap" catchtap="onAgreementLinkTap" data-key="refund">
          <text class="checkout-agreement__link">《{{refundAgreementTitle}}》</text>
        </view>
      </label>
    </checkbox-group>
  </view>
  </view>

</view>

<!-- 协议正文弹层 -->
<view wx:if="{{agreementSheetVisible}}" class="agreement-sheet">
  <view class="agreement-sheet__backdrop" bindtap="closeAgreementSheet"></view>
  <view class="agreement-sheet__panel {{agreementSheetAnimating ? 'agreement-sheet__panel--active' : ''}}">
    <view class="agreement-sheet__handle"></view>
    <view class="agreement-sheet__header">
      <text class="agreement-sheet__title">{{agreementSheetTitle}}</text>
      <view class="agreement-sheet__close" bindtap="closeAgreementSheet">×</view>
    </view>
    <scroll-view class="agreement-sheet__body" scroll-y="true">
      <text class="agreement-sheet__content">{{agreementSheetContent}}</text>
    </scroll-view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
