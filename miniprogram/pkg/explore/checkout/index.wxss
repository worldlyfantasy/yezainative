.checkout-page {
  padding-top: 0;
  padding-bottom: 220rpx;
}

.checkout-page .section-block {
  margin-top: 52rpx;
}

.checkout-page .paper-block {
  padding-bottom: 32rpx;
}

/* ---------- 订单摘要 ---------- */
.checkout-summary {
  padding-bottom: 32rpx;
}

.checkout-summary__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.checkout-summary__label {
  color: #6a5a4b;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.checkout-summary__value {
  color: #2b241d;
  text-align: right;
}

.checkout-summary__row--interactive {
  align-items: center;
  margin-top: 20rpx;
}

.checkout-summary__coupon {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.checkout-summary__value--accent {
  color: #D15E14;
  font-weight: 600;
}

.checkout-summary__coupon-hint {
  font-size: 22rpx;
  line-height: 1.4;
  color: #8a5a38;
}

.checkout-summary__arrow {
  font-size: 24rpx;
  color: #8a5a38;
  font-weight: 500;
  line-height: 1;
}

.checkout-summary__helper {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a5a38;
}

/* ---------- 出行人信息 ---------- */
.checkout-travelers-block {
  min-height: 200rpx;
}
.checkout-travelers {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.checkout-traveler {
  padding: 28rpx 24rpx 24rpx;
  border: 1rpx solid rgba(189, 154, 95, 0.24);
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 251, 244, 0.84), rgba(255, 248, 236, 0.62)),
    rgba(255, 250, 241, 0.48);
  box-shadow: 0 12rpx 30rpx rgba(153, 57, 33, 0.04);
}

.checkout-traveler__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.checkout-traveler__title {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #2b241d;
}

.checkout-traveler__hint {
  font-size: 22rpx;
  color: #8a5a38;
}

/* 出行人卡片（列表摘要）：轻量扁平，与表单区区分层次 */
.checkout-traveler-card {
  padding: 24rpx 22rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.08);
  background: rgba(255, 249, 242, 0.78);
  box-shadow: 0 4rpx 22rpx rgba(84, 57, 31, 0.045);
}

.checkout-contact-card {
  padding: 24rpx 22rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.08);
  background: rgba(255, 249, 242, 0.78);
  box-shadow: 0 4rpx 22rpx rgba(84, 57, 31, 0.045);
}

.checkout-traveler-card__head {
  margin-bottom: 14rpx;
}

.checkout-traveler-card__badge {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: #9a8b7c;
}

.checkout-traveler-card__body {
  margin-top: 4rpx;
}

.checkout-traveler-card__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkout-traveler-card__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #2b241d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-traveler-card__phone {
  flex-shrink: 0;
  max-width: 40%;
  font-size: 26rpx;
  line-height: 1.35;
  color: #6a5a4b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-traveler-card__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-left: 4rpx;
}

.checkout-traveler-card__action {
  font-size: 26rpx;
  line-height: 1.3;
  color: #8a7a6a;
}

.checkout-traveler-card__action--primary {
  color: #993921;
  font-weight: 500;
}

.checkout-traveler-card__empty {
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx dashed rgba(153, 57, 33, 0.22);
  background: rgba(255, 252, 248, 0.65);
  text-align: center;
}

.checkout-traveler-card__empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #993921;
}

.checkout-traveler-card__empty-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9a8b7c;
}

.checkout-field-label--spaced {
  margin-top: 24rpx;
}

.checkout-field-group + .checkout-field-group {
  margin-top: 18rpx;
}

.checkout-field-label {
  display: block;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #6a5a4b;
}

.checkout-field {
  margin-top: 0;
}

.checkout-field--error {
  border-color: rgba(153, 57, 33, 0.72);
  background: rgba(255, 245, 242, 0.88);
}

.checkout-field-error {
  display: block;
  margin-top: 10rpx;
  padding-left: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #993921;
}

.checkout-field-error--compact {
  padding-left: 4rpx;
}

.checkout-document-row {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.checkout-document-col {
  min-width: 0;
}

.checkout-document-col--type {
  flex: 0 0 176rpx;
}

.checkout-document-col--number {
  flex: 1;
}

.checkout-document-trigger,
.checkout-document-input {
  margin-top: 0;
  min-height: 72rpx;
  height: 72rpx;
  padding-top: 0;
  padding-bottom: 0;
}

.checkout-picker-value {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  height: 72rpx;
  padding-top: 0;
  padding-bottom: 0;
  width: 100%;
}

.checkout-picker-value--placeholder {
  color: rgba(106, 90, 75, 0.72);
}

.checkout-note {
  width: 100%;
  height: 148rpx;
  min-height: 148rpx;
  margin-top: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(189, 154, 95, 0.35);
  border-radius: 20rpx;
  background: rgba(255, 250, 241, 0.5);
  color: #2b241d;
  font-size: 26rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.checkout-contact-block {
  margin-top: 0;
}

.checkout-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.checkout-inline-button {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.38);
  color: #993921;
  font-size: 22rpx;
  background: rgba(255, 249, 242, 0.7);
}

.checkout-inline-button::after {
  border: 0;
}

.checkout-text-button {
  margin: 10rpx 0 0;
  padding: 0;
  min-height: auto;
  line-height: 1.2;
  font-size: 22rpx;
  color: #993921;
  text-align: left;
  background: transparent;
}

.checkout-text-button::after {
  border: 0;
}

.checkout-text-button--danger {
  color: #c53030;
  font-size: 22rpx;
}

.checkout-doc-row {
  margin-top: 16rpx;
  padding: 16rpx 16rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 252, 246, 0.9);
  border: 1rpx solid rgba(189, 154, 95, 0.18);
}

.checkout-doc-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.checkout-doc-row__label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6a5a4b;
}

.checkout-field-error--block {
  margin-top: 12rpx;
}

.checkout-sheet-add-button--inline {
  margin-top: 16rpx;
}

.checkout-toggle-line {
  margin-top: 10rpx;
  padding-left: 6rpx;
}

.checkout-toggle-line__text {
  font-size: 22rpx;
  color: #8a5a38;
}

/* ---------- 睡友安排（分组面板 + 网格对齐） ---------- */
.checkout-rooming-panel {
  margin-top: 0;
  padding: 4rpx 6rpx 8rpx;
  border-radius: 22rpx;
  background: linear-gradient(165deg, rgba(255, 253, 249, 0.98) 0%, rgba(255, 248, 238, 0.88) 100%);
  border: 1rpx solid rgba(189, 154, 95, 0.16);
  box-shadow: 0 6rpx 24rpx rgba(84, 57, 31, 0.04);
}

.checkout-rooming-block {
  padding: 22rpx 18rpx 20rpx;
}

.checkout-rooming-block--divider {
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(189, 154, 95, 0.12);
}

.checkout-rooming-block__label {
  display: block;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: 0.14em;
  color: #8a7a6a;
}

.checkout-rooming-matrix {
  display: block;
}

.checkout-rooming-matrix__pair {
  display: block;
}

.checkout-rooming-matrix__pair--full {
  width: 100%;
}

.checkout-rooming-rg {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 28rpx;
  row-gap: 18rpx;
  align-items: center;
  margin: 0;
}

.checkout-rooming-matrix__pair--full .checkout-rooming-rg {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  max-width: 100%;
}

.checkout-rooming-name-field {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed rgba(189, 154, 95, 0.2);
}

.checkout-rooming-note {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 250, 241, 0.88);
  border: 1rpx solid rgba(189, 154, 95, 0.2);
}

.checkout-rooming-note__title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b5344;
}

.checkout-rooming-note__text {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6a5a4b;
}

.checkout-rooming-choice {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  min-height: 48rpx;
}

.checkout-rooming-choice radio {
  flex-shrink: 0;
}

.checkout-rooming-choice__text {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 500;
  color: #2b241d;
}

.checkout-rooming-choice--muted {
  opacity: 0.4;
}

.checkout-rooming-choice--muted .checkout-rooming-choice__text {
  color: #6a5a4b;
}

.checkout-rooming-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2b241d;
  background: rgba(255, 249, 242, 0.92);
  border: 1rpx solid rgba(189, 154, 95, 0.2);
  box-sizing: border-box;
}

.checkout-rooming-input--block {
  display: block;
  height: 84rpx;
  min-height: 84rpx;
  border-radius: 18rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
}

.checkout-rooming-input--error {
  border-color: rgba(153, 57, 33, 0.5);
  background: rgba(255, 245, 242, 0.75);
}

.checkout-note--large {
  height: 220rpx;
  min-height: 220rpx;
}

.checkout-sheet-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.checkout-sheet-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(189, 154, 95, 0.24);
  border-radius: 18rpx;
  background: rgba(255, 250, 241, 0.5);
}

.checkout-sheet-item--selected {
  border-color: rgba(153, 57, 33, 0.42);
  background: rgba(255, 236, 220, 0.55);
}

.checkout-sheet-item--disabled {
  border-color: rgba(116, 103, 89, 0.14);
  background: rgba(246, 241, 233, 0.42);
}

.checkout-sheet-item__check-area {
  flex-shrink: 0;
  padding: 2rpx 4rpx 2rpx 0;
}

.checkout-sheet-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(153, 57, 33, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 249, 242, 0.78);
}

.checkout-sheet-check__icon {
  font-size: 22rpx;
  color: transparent;
  line-height: 1;
}

.checkout-sheet-check--active {
  border-color: #D15E14;
  background: #D15E14;
}

.checkout-sheet-check--active .checkout-sheet-check__icon {
  color: #fff9f2;
}

.checkout-sheet-item__selectable {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.checkout-sheet-item__phone {
  flex-shrink: 0;
  max-width: 46%;
  font-size: 26rpx;
  color: #6a5a4b;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-sheet-item__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.checkout-sheet-item__edit {
  flex-shrink: 0;
  padding: 8rpx 0;
  font-size: 28rpx;
  line-height: 1.3;
  color: #993921;
}

.checkout-sheet-item__delete {
  flex-shrink: 0;
  padding: 8rpx 0;
  font-size: 28rpx;
  line-height: 1.3;
  color: #b14d35;
}

.checkout-sheet-add-button {
  margin-top: 8rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: rgba(255, 250, 241, 0.92);
  color: #993921;
  font-size: 28rpx;
  border: 1rpx dashed rgba(153, 57, 33, 0.35);
}

.checkout-sheet-add-button::after {
  border: 0;
}

.checkout-form-section {
  padding: 8rpx 8rpx 24rpx;
}

.checkout-form-section + .checkout-form-section {
  border-top: 1rpx solid rgba(189, 154, 95, 0.2);
  margin-top: 8rpx;
  padding-top: 24rpx;
}

.checkout-form-section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #993921;
}

.checkout-form-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.checkout-inline-button--small {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  min-height: auto;
  line-height: 1.3;
}

.agreement-sheet--front {
  z-index: 1100;
}

.agreement-sheet__panel--tall {
  max-height: 88vh;
}

.agreement-sheet__body--form {
  max-height: 56vh;
}

.checkout-sheet-item__main {
  flex: 1;
  min-width: 0;
}

.checkout-sheet-item__name {
  display: block;
  font-size: 26rpx;
  color: #2b241d;
}

.checkout-sheet-item__selectable .checkout-sheet-item__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-sheet-item__meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6a5a4b;
}

.checkout-sheet-item--disabled .checkout-sheet-item__name,
.checkout-sheet-item--disabled .checkout-sheet-item__meta {
  color: rgba(106, 90, 75, 0.48);
}

.checkout-sheet-item__meta--disabled {
  color: rgba(153, 57, 33, 0.58);
}

.checkout-sheet-item__check {
  font-size: 30rpx;
  color: #993921;
  font-weight: 600;
}

.checkout-sheet-empty {
  margin-top: 16rpx;
  color: #6a5a4b;
  font-size: 24rpx;
}

.checkout-sheet-footer {
  padding: 12rpx 32rpx 24rpx;
}

.checkout-sheet-footer__button {
  width: 100%;
  height: 82rpx;
  border-radius: 999rpx;
  background: #D15E14;
  color: #fff9f2;
  font-size: 30rpx;
  line-height: 82rpx;
}

.checkout-sheet-footer__button::after {
  border: 0;
}

.checkout-sheet-footer__button--disabled {
  background: #d0cdc7;
  color: #fff9f2;
}

/* ---------- 协议确认 ---------- */
.checkout-agreements {
  padding-bottom: 24rpx;
}

.checkout-agreement-intro {
  display: block;
  font-size: 26rpx;
  color: #2b241d;
  margin-bottom: 16rpx;
}

.checkout-agreement-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.checkout-agreement__label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #2b241d;
}

.checkout-agreement__link-wrap {
  flex: 0 0 auto;
}

.checkout-agreement__link {
  color: #993921;
  text-decoration: underline;
  font-size: 26rpx;
}

/* ---------- 协议正文弹层 ---------- */
.agreement-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.agreement-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.32);
}

.agreement-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 75vh;
  background:
    linear-gradient(180deg, #FFF9F2 0%, #F9F4EC 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 46rpx rgba(84, 57, 31, 0.14);
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.agreement-sheet__panel--active {
  transform: translateY(0);
}

.agreement-sheet__handle {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.18);
  margin: 8rpx auto 12rpx;
}

.agreement-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.agreement-sheet__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2b241d;
}

.agreement-sheet__title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.agreement-sheet__asset-link {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.22);
  color: #993921;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
  background: rgba(255, 250, 241, 0.72);
}

.agreement-sheet__close {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  font-size: 34rpx;
  line-height: 52rpx;
  text-align: center;
  color: #6a5a4b;
  background: rgba(153, 57, 33, 0.06);
  border: 1rpx solid rgba(153, 57, 33, 0.1);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.agreement-sheet__body {
  flex: 1;
  padding: 0 32rpx 32rpx;
  max-height: 60vh;
}

.agreement-sheet__content {
  display: block;
  font-size: 26rpx;
  line-height: 1.85;
  color: #2b241d;
  white-space: pre-line;
}

/* ---------- 顶部吸附操作条 ---------- */
.checkout-action-bar .bottom-action-bar {
  z-index: 1001;
  margin: 0;
  padding: 18rpx 40rpx 16rpx;
  align-items: center;
}

.checkout-action-bar .bottom-action-bar__meta {
  min-height: 88rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.checkout-action-bar .bottom-action-bar__meta--compact {
  justify-content: center;
}

.checkout-action-bar .bottom-action-bar__label {
  font-size: 24rpx;
  color: #6a5a4b;
}

.checkout-action-bar .bottom-action-bar__price {
  font-size: 44rpx;
  font-weight: 600;
  color: #2b241d;
  margin-top: 0;
  line-height: 1;
}

.checkout-action-bar .bottom-action-bar__button {
  flex: 0 0 320rpx;
  width: 320rpx;
  max-width: none;
  min-width: 320rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  background-color: #D15E14;
  background-image: none;
  color: #fff9f2;
  box-shadow: 0 12rpx 28rpx rgba(209, 94, 20, 0.18);
}

.checkout-action-bar .bottom-action-bar__button::after {
  border: 0;
}

