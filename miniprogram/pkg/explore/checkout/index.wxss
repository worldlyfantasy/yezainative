.checkout-page {
  padding-top: 0;
  padding-bottom: 220rpx;
}

/* ---------- 订单摘要 ---------- */
.checkout-summary {
  padding-bottom: 28rpx;
}

.checkout-summary__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.checkout-summary__label {
  color: #6a5a4b;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.checkout-summary__value {
  color: #2b241d;
  text-align: right;
}

/* ---------- 出行人信息 ---------- */
.checkout-travelers-block {
  min-height: 200rpx;
}
.checkout-travelers {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.checkout-traveler,
.checkout-contact-card {
  padding: 28rpx 24rpx 24rpx;
  border: 1rpx solid rgba(189, 154, 95, 0.24);
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 251, 244, 0.84), rgba(255, 248, 236, 0.62)),
    rgba(255, 250, 241, 0.48);
  box-shadow: 0 12rpx 30rpx rgba(153, 57, 33, 0.04);
}

.checkout-traveler__header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.checkout-traveler__title {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #2b241d;
}

.checkout-field-group + .checkout-field-group {
  margin-top: 18rpx;
}

.checkout-field-label {
  display: block;
  margin-bottom: 10rpx;
  padding-left: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #6a5a4b;
}

.checkout-field {
  margin-top: 0;
}

.checkout-field--error {
  border-color: rgba(153, 57, 33, 0.72);
  background: rgba(255, 245, 242, 0.88);
}

.checkout-field-error {
  display: block;
  margin-top: 10rpx;
  padding-left: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #993921;
}

.checkout-field-error--compact {
  padding-left: 4rpx;
}

.checkout-document-row {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.checkout-document-col {
  min-width: 0;
}

.checkout-document-col--type {
  flex: 0 0 176rpx;
}

.checkout-document-col--number {
  flex: 1;
}

.checkout-document-trigger,
.checkout-document-input {
  margin-top: 0;
  min-height: 72rpx;
  height: 72rpx;
  padding-top: 0;
  padding-bottom: 0;
}

.checkout-picker-value {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  height: 72rpx;
  padding-top: 0;
  padding-bottom: 0;
  width: 100%;
}

.checkout-picker-value--placeholder {
  color: rgba(106, 90, 75, 0.72);
}

.checkout-note {
  width: 100%;
  height: 148rpx;
  min-height: 148rpx;
  margin-top: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(189, 154, 95, 0.35);
  border-radius: 20rpx;
  background: rgba(255, 250, 241, 0.5);
  color: #2b241d;
  font-size: 26rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.checkout-contact-block {
  margin-top: 48rpx;
}

/* ---------- 协议确认 ---------- */
.checkout-agreements {
  padding-bottom: 24rpx;
}

.checkout-agreement-intro {
  display: block;
  font-size: 26rpx;
  color: #2b241d;
  margin-bottom: 16rpx;
}

.checkout-agreement-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.checkout-agreement__label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #2b241d;
}

.checkout-agreement__link-wrap {
  flex: 0 0 auto;
}

.checkout-agreement__link {
  color: #993921;
  text-decoration: underline;
  font-size: 26rpx;
}

/* ---------- 协议正文弹层 ---------- */
.agreement-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.agreement-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
}

.agreement-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 75vh;
  background: #f9f4ec;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.agreement-sheet__panel--active {
  transform: translateY(0);
}

.agreement-sheet__handle {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.12);
  margin: 8rpx auto 12rpx;
}

.agreement-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.agreement-sheet__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2b241d;
}

.agreement-sheet__close {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  font-size: 34rpx;
  line-height: 52rpx;
  text-align: center;
  color: #6a5a4b;
  background: rgba(43, 36, 29, 0.06);
  border: 1rpx solid rgba(43, 36, 29, 0.08);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.agreement-sheet__body {
  flex: 1;
  padding: 0 32rpx 32rpx;
  max-height: 60vh;
}

.agreement-sheet__content {
  display: block;
  font-size: 26rpx;
  line-height: 1.85;
  color: #2b241d;
  white-space: pre-line;
}

/* ---------- 顶部吸附操作条 ---------- */
.checkout-action-bar .bottom-action-bar {
  z-index: 1001;
  margin: 0;
  padding: 18rpx 40rpx 16rpx;
  align-items: center;
}

.checkout-action-bar .bottom-action-bar__meta {
  min-height: 88rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.checkout-action-bar .bottom-action-bar__meta--compact {
  justify-content: center;
}

.checkout-action-bar .bottom-action-bar__label {
  font-size: 24rpx;
  color: #6a5a4b;
}

.checkout-action-bar .bottom-action-bar__price {
  font-size: 44rpx;
  font-weight: 600;
  color: #2b241d;
  margin-top: 0;
  line-height: 1;
}

.checkout-action-bar .bottom-action-bar__button {
  flex: 0 0 320rpx;
  width: 320rpx;
  max-width: none;
  min-width: 320rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  background-color: #993921;
  background-image: none;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(153, 57, 33, 0.18);
}

.checkout-action-bar .bottom-action-bar__button::after {
  border: 0;
}

.checkout-action-bar .bottom-action-bar__button--disabled {
  color: rgba(255, 255, 255, 0.82);
  background-color: rgba(153, 57, 33, 0.32);
  box-shadow: none;
}
