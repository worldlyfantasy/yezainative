<view wx:if="{{loading}}" class="page-shell">
  <view class="skeleton-line skeleton-line--back"></view>

  <view class="section-block creator-opening">
    <view class="creator-top">
      <view class="creator-top__body">
        <view class="skeleton-line skeleton-line--eyebrow"></view>
        <view class="skeleton-line skeleton-line--page-title"></view>
        <view class="skeleton-line skeleton-line--medium"></view>
        <view class="creator-top__tags">
          <view class="skeleton-chip"></view>
          <view class="skeleton-chip"></view>
          <view class="skeleton-chip"></view>
        </view>
      </view>
      <view class="creator-top__avatar skeleton-circle"></view>
    </view>
  </view>

  <view class="section-block paper-block">
    <view class="skeleton-line skeleton-line--section"></view>
    <view class="skeleton-stack">
      <view class="skeleton-line skeleton-line--long"></view>
      <view class="skeleton-line skeleton-line--long"></view>
      <view class="skeleton-line skeleton-line--medium"></view>
    </view>
  </view>

  <view class="section-block">
    <view class="skeleton-line skeleton-line--section"></view>
    <view class="skeleton-card-list">
      <view class="skeleton-card"></view>
      <view class="skeleton-card"></view>
    </view>
  </view>
</view>

<view wx:elif="{{creator}}" class="page-shell">
  <text class="back-link" bindtap="goBack">← 返回创作者列表</text>

  <view class="section-block creator-opening">
    <view class="creator-top">
      <view class="creator-top__body">
        <text class="page-eyebrow">创作者</text>
        <view class="creator-top__title-row">
          <text class="page-title creator-top__name">{{creator.name}}</text>
          <favorite-star
            favorited="{{creator.isFavorited}}"
            notice-state="{{favoriteNoticeState}}"
            notice-label="{{favoriteNoticeLabel}}"
            notice-action-label="{{favoriteNoticeActionLabel}}"
            notice-mode="{{favoriteNoticeMode}}"
            bind:toggle="toggleFavorite"
            bind:noticeaction="handleFavoriteNoticeAction"
          ></favorite-star>
        </view>
        <text class="page-subtitle creator-top__stance">{{creator.stance}}</text>
        <view class="creator-top__tags">
          <text wx:for="{{creator.tags}}" wx:key="*this" class="creator-top__descriptor">{{item}}</text>
        </view>
      </view>
      <image class="creator-top__avatar" src="{{creator.avatar}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="section-block paper-block">
      <text class="section-title detail-card__title">他与地方</text>
      <view class="detail-list">
        <text wx:for="{{creator.about}}" wx:key="*this" class="detail-list-item">{{item}}</text>
      </view>
  </view>

  <view class="section-block paper-block">
    <text class="section-title">常在这些地方停留</text>
    <view class="creator-place-list">
      <view
        wx:for="{{creatorDestinations}}"
        wx:key="id"
        class="creator-place-item"
        hover-class="creator-place-item--hover"
        data-slug="{{item.slug}}"
        bindtap="onDestinationTap"
      >
        <text class="creator-place-item__label">{{item.name}}</text>
        <text class="creator-place-item__icon">↗</text>
      </view>
    </view>
  </view>

  <view wx:if="{{displayIdeas.length}}" class="section-block creator-stories">
    <text class="section-title creator-stories__title">TA 的故事</text>
    <view class="creator-story-list">
      <view
        wx:for="{{displayIdeas}}"
        wx:key="id"
        class="creator-story-item"
        data-slug="{{item.slug}}"
        bindtap="onStoryTap"
      >
        <view class="creator-story-item__main">
          <text class="creator-story-item__title">{{item.title}}</text>
          <text class="creator-story-item__summary">{{item.summary}}</text>
        </view>
        <text class="creator-story-item__arrow">→</text>
      </view>
    </view>
    <view wx:if="{{hasMoreIdeas}}" class="creator-stories__more" bindtap="goCreatorStories">
      <text class="creator-stories__link">查看 TA 的全部故事 →</text>
    </view>
  </view>

  <view class="section-block">
    <text class="section-title">同行的旅程</text>
    <view class="card-stack creator-detail__list">
      <service-card
        wx:for="{{relatedServices}}"
        wx:key="id"
        service="{{item}}"
        hide-duration-in-price="{{true}}"
        bind:cardtap="onServiceTap"
      ></service-card>
    </view>
  </view>

  <view class="section-block creator-feedback">
    <text class="section-eyebrow creator-feedback__eyebrow">队员反馈</text>
    <text class="section-title">旅人回声</text>
    <view class="review-list">
      <view wx:for="{{creator.reviews}}" wx:key="content" class="review-item">
        <text class="review-item__mark">“</text>
        <text class="review-item__content">{{item.content}}</text>
        <text class="review-item__audience">来自 {{item.audience}}</text>
      </view>
    </view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
