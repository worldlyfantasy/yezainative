.creator-opening {
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.14);
}

.creator-top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.creator-top__body {
  flex: 1;
  min-width: 0;
}

.creator-top__avatar {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid rgba(189, 154, 95, 0.34);
}

.creator-top__title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.creator-top__name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 62rpx;
}

.creator-top__stance {
  margin-top: 16rpx;
}

.creator-top__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  margin-top: 18rpx;
}

.creator-top__descriptor {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #993921;
}

.detail-card__title {
  display: block;
}

.compare-block {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-top: 26rpx;
}

.compare-block__title {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 30rpx;
  font-weight: 500;
  color: #2b241d;
}

.creator-detail__list {
  margin-top: 28rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 28rpx;
}

.creator-feedback {
  padding: 32rpx 28rpx 36rpx;
  border: 1rpx solid rgba(189, 154, 95, 0.22);
  border-radius: 24rpx;
  background: #f7ecd4;
}

.creator-feedback__eyebrow {
  margin-bottom: 0;
}

.review-item__content,
.review-item__audience {
  display: block;
  font-size: 24rpx;
  line-height: 1.95;
  color: #6a5a4b;
}

.review-item {
  position: relative;
  padding: 26rpx 24rpx 22rpx 28rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.08);
  border-radius: 18rpx;
  background: #fbf4e7;
}

.review-item__mark {
  position: absolute;
  top: 12rpx;
  left: 18rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 52rpx;
  line-height: 1;
  color: rgba(153, 57, 33, 0.2);
}

.review-item__content {
  position: relative;
  z-index: 1;
  padding-left: 16rpx;
}

.review-item__audience {
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #993921;
  opacity: 0.82;
}

.creator-stories__title {
  display: block;
  margin-bottom: 24rpx;
}

.creator-story-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.creator-story-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.1);
}

.creator-story-item:last-child {
  border-bottom: none;
}

.creator-story-item__main {
  flex: 1;
  min-width: 0;
}

.creator-story-item__title {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #2b241d;
}

.creator-story-item__summary {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6a5a4b;
}

.creator-story-item__arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: rgba(153, 57, 33, 0.72);
}

.creator-stories__more {
  margin-top: 20rpx;
  padding-top: 16rpx;
}

.creator-stories__link {
  font-size: 26rpx;
  color: #993921;
}
