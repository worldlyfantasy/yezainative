.assets-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.assets-header {
  margin-top: 10rpx;
}

.assets-title {
  font-size: 48rpx;
  line-height: 1.16;
}

.assets-page .section-block {
  margin-top: 48rpx;
}

.referral-share-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  align-items: center;
  padding: 24rpx 26rpx;
  border: 0;
  border-radius: 22rpx;
  background: rgba(255, 250, 241, 0.78);
  box-shadow: none;
}

.referral-share-card__content {
  flex: 1;
  min-width: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.referral-share-card__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.referral-action-button {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  line-height: 68rpx;
  font-weight: 600;
  padding: 0 10rpx;
}

.referral-action-button--primary {
  background: #D15E14;
  color: #fffaf1;
}

.referral-action-button--secondary {
  background: rgba(255, 250, 241, 0.9);
  border: 1rpx solid rgba(209, 94, 20, 0.28);
  color: #993921;
}

.referral-action-button--disabled {
  opacity: 0.62;
}

.referral-action-button::after {
  border: 0;
}

.referral-code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 4rpx 0;
}

.referral-code-row__label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #8a7a68;
}

.referral-code-row__value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #6a5a4b;
  word-break: break-all;
}

.referral-code-row__copy {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #993921;
}

.referral-qr-box {
  width: 100%;
  height: 292rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  background: transparent;
}

.referral-qr-box__image {
  width: 252rpx;
  height: 252rpx;
}

.referral-qr-box__placeholder {
  font-size: 24rpx;
  color: #8a7a68;
}

.assets-state-block {
  padding-bottom: 0;
}

.referral-code-entry-card {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border: 0;
  border-radius: 22rpx;
  background: rgba(255, 250, 241, 0.62);
  box-shadow: none;
}

.referral-code-entry-card__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #993921;
}

.referral-code-entry-card__form {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.referral-code-entry-card__input-wrap {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 241, 0.86);
  border: 1rpx solid rgba(153, 57, 33, 0.14);
}

.referral-code-entry-card__input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0;
  background: transparent;
  font-size: 26rpx;
  color: #2b241d;
}

.referral-code-entry-card__scan {
  position: relative;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.referral-code-entry-card__scan--disabled {
  opacity: 0.46;
}

.referral-code-entry-card__scan-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.referral-code-entry-card__scan-corner {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-color: #993921;
}

.referral-code-entry-card__scan-corner--tl {
  top: 0;
  left: 0;
  border-top: 3rpx solid;
  border-left: 3rpx solid;
}

.referral-code-entry-card__scan-corner--tr {
  top: 0;
  right: 0;
  border-top: 3rpx solid;
  border-right: 3rpx solid;
}

.referral-code-entry-card__scan-corner--bl {
  bottom: 0;
  left: 0;
  border-bottom: 3rpx solid;
  border-left: 3rpx solid;
}

.referral-code-entry-card__scan-corner--br {
  right: 0;
  bottom: 0;
  border-right: 3rpx solid;
  border-bottom: 3rpx solid;
}

.referral-code-entry-card__scan-line {
  position: absolute;
  top: 13rpx;
  left: 5rpx;
  width: 20rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #D15E14;
}

.referral-code-entry-card__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 104rpx;
  height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #D15E14;
  color: #fffaf1;
  font-size: 26rpx;
  line-height: 68rpx;
  font-weight: 600;
}

.referral-code-entry-card__button--disabled {
  opacity: 0.62;
}

.assets-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.assets-tabs-block {
  margin-top: -4rpx;
}

.assets-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.assets-coupon-card,
.assets-list-card,
.assets-reward-card,
.assets-payout-card,
.assets-empty-block {
  border: 0;
  border-radius: 22rpx;
  background: rgba(255, 250, 241, 0.78);
  box-shadow: none;
}

.assets-coupon-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 32rpx 22rpx 132rpx;
  height: 228rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.assets-coupon-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.assets-coupon-card__content {
  position: relative;
  z-index: 1;
}

.assets-coupon-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.assets-coupon-card__value {
  display: flex;
  align-items: baseline;
  color: #993921;
}

.assets-coupon-card__currency {
  font-size: 30rpx;
  font-weight: 700;
}

.assets-coupon-card__amount {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  line-height: 0.95;
  font-weight: 700;
}

.assets-coupon-card__title {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.45;
  color: #2b241d;
  font-weight: 600;
}

.assets-coupon-card__meta {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
  color: #6a5a4b;
}

.assets-coupon-card__expires {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #6a5a4b;
}

.assets-list-card {
  padding: 28rpx;
}

.assets-list-card__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.assets-list-card__title {
  flex: 1;
  min-width: 0;
}

.assets-list-card__badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.08);
  font-size: 22rpx;
  color: #993921;
}

.assets-list-card__amount {
  display: block;
  margin-top: 18rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  line-height: 1.1;
  color: #2b241d;
}

.assets-reward-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx 32rpx 20rpx 132rpx;
  height: 228rpx;
  box-sizing: border-box;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.assets-reward-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.assets-reward-card__content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  height: 100%;
}

.assets-reward-card__main {
  width: 340rpx;
  max-width: 100%;
  min-width: 0;
}

.assets-reward-card__value {
  display: flex;
  align-items: baseline;
  color: #993921;
}

.assets-reward-card__currency {
  margin-right: 4rpx;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
}

.assets-reward-card__amount {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 54rpx;
  line-height: 0.95;
  font-weight: 700;
}

.assets-reward-card__title {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 27rpx;
  line-height: 1.45;
  color: #2b241d;
  font-weight: 600;
}

.assets-reward-card__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6a5a4b;
}

.assets-reward-card--paid .assets-reward-card__value {
  color: #5c6b4c;
}

.assets-reward-card--failed .assets-reward-card__value,
.assets-reward-card--failed .assets-reward-card__title {
  color: rgba(43, 36, 29, 0.72);
}

.assets-reward-card--failed .assets-reward-card__meta {
  color: rgba(106, 90, 75, 0.72);
}

.assets-reward-help-text {
  display: block;
  margin: 0 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a7a68;
}

.assets-payout-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
}

.assets-payout-card .section-eyebrow {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  line-height: 1.35;
  letter-spacing: 2rpx;
}

.assets-payout-card .section-title {
  font-size: 34rpx;
  line-height: 1.45;
}

.assets-payout-card__main {
  flex: 1;
  min-width: 0;
}

.assets-payout-card__action {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.08);
  color: #993921;
  font-size: 24rpx;
}

.assets-empty-block {
  padding: 8rpx 0 0;
  border: 0;
  background: transparent;
  border-radius: 0;
}

.assets-empty-block .section-eyebrow {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  line-height: 1.35;
  letter-spacing: 2rpx;
}

.assets-empty-block .section-title {
  font-size: 36rpx;
  line-height: 1.45;
}

.reward-gift-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(43, 36, 29, 0.28);
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.reward-gift-modal {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 38rpx 38rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 50% 25%, rgba(255, 241, 194, 0.62), rgba(255, 241, 194, 0) 32%),
    rgba(255, 248, 236, 0.96);
  box-shadow: 0 34rpx 80rpx rgba(67, 45, 26, 0.2);
  text-align: center;
  overflow: hidden;
  animation: reward-gift-modal-in 300ms ease both;
}

.reward-gift-visual {
  position: relative;
  height: 310rpx;
}

.reward-gift-visual__image {
  position: relative;
  z-index: 2;
  width: 330rpx;
  height: 330rpx;
  margin: 0 auto;
  display: block;
  animation: reward-gift-float 1800ms ease-in-out infinite;
}

.reward-gift-modal--opening .reward-gift-visual__image {
  animation: reward-gift-shake 560ms ease both;
}

.reward-gift-modal--celebrating .reward-gift-visual__image,
.reward-gift-modal--result .reward-gift-visual__image {
  animation: reward-gift-pop 620ms ease both;
}

.reward-gift-modal__eyebrow {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #b8724b;
}

.reward-gift-modal__title {
  position: relative;
  z-index: 3;
  display: block;
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  line-height: 1.42;
  color: #2b241d;
}

.reward-gift-modal__desc {
  position: relative;
  z-index: 3;
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #6a5a4b;
}

.reward-gift-modal__button {
  position: relative;
  z-index: 3;
  width: 100%;
  margin-top: 28rpx;
}

.reward-gift-confetti__piece {
  position: absolute;
  z-index: 1;
  width: 12rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #d7651d;
  opacity: 0;
  animation: reward-gift-confetti 900ms ease-out both;
}

.reward-gift-confetti__piece--0 { top: 80rpx; left: 104rpx; animation-delay: 20ms; }
.reward-gift-confetti__piece--1 { top: 54rpx; right: 112rpx; background: #b8724b; animation-delay: 70ms; }
.reward-gift-confetti__piece--2 { top: 180rpx; left: 68rpx; background: #993921; animation-delay: 120ms; }
.reward-gift-confetti__piece--3 { top: 178rpx; right: 76rpx; animation-delay: 160ms; }
.reward-gift-confetti__piece--4 { top: 120rpx; left: 180rpx; background: #f3c46c; animation-delay: 210ms; }
.reward-gift-confetti__piece--5 { top: 126rpx; right: 180rpx; background: #f3c46c; animation-delay: 250ms; }
.reward-gift-confetti__piece--6 { top: 44rpx; left: 230rpx; background: #b8724b; animation-delay: 280ms; }
.reward-gift-confetti__piece--7 { top: 48rpx; right: 230rpx; background: #993921; animation-delay: 320ms; }

.reward-gift-coin {
  position: absolute;
  z-index: 4;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #ffe6a1, #d79b28);
  color: #9a5b13;
  font-size: 24rpx;
  line-height: 42rpx;
  font-weight: 700;
  opacity: 0;
  box-shadow: 0 8rpx 18rpx rgba(130, 88, 30, 0.18);
  animation: reward-gift-coin 760ms ease-out both;
}

.reward-gift-coin--0 { left: 128rpx; top: 136rpx; animation-delay: 40ms; }
.reward-gift-coin--1 { left: 206rpx; top: 70rpx; animation-delay: 90ms; }
.reward-gift-coin--2 { right: 146rpx; top: 124rpx; animation-delay: 140ms; }
.reward-gift-coin--3 { right: 216rpx; top: 78rpx; animation-delay: 190ms; }
.reward-gift-coin--4 { left: 176rpx; top: 198rpx; animation-delay: 240ms; }
.reward-gift-coin--5 { right: 184rpx; top: 206rpx; animation-delay: 290ms; }

.reward-gift-card {
  position: relative;
  height: 188rpx;
  margin-top: 24rpx;
  padding: 22rpx 30rpx 18rpx 112rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-align: left;
}

.reward-gift-card__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.reward-gift-card__content {
  position: relative;
  z-index: 1;
}

.reward-gift-card__value {
  display: flex;
  align-items: baseline;
  color: #993921;
}

.reward-gift-card__currency {
  margin-right: 4rpx;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
}

.reward-gift-card__amount {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 50rpx;
  line-height: 0.95;
  font-weight: 700;
}

.reward-gift-card__title {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  line-height: 1.4;
  color: #2b241d;
  font-weight: 600;
}

.reward-gift-card__meta {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #6a5a4b;
}

@keyframes reward-gift-modal-in {
  from {
    opacity: 0;
    transform: translateY(24rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes reward-gift-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes reward-gift-shake {
  0%, 100% { transform: translateX(0) rotate(0deg); }
  20% { transform: translateX(-8rpx) rotate(-2deg); }
  40% { transform: translateX(7rpx) rotate(2deg); }
  60% { transform: translateX(-5rpx) rotate(-1deg); }
  80% { transform: translateX(4rpx) rotate(1deg); }
}

@keyframes reward-gift-pop {
  0% { transform: scale(0.9); }
  62% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

@keyframes reward-gift-confetti {
  0% {
    opacity: 0;
    transform: translateY(20rpx) rotate(0deg);
  }
  20% { opacity: 1; }
  100% {
    opacity: 0;
    transform: translateY(-150rpx) rotate(220deg);
  }
}

@keyframes reward-gift-coin {
  0% {
    opacity: 0;
    transform: translateY(40rpx) scale(0.62) rotate(0deg);
  }
  20% { opacity: 1; }
  100% {
    opacity: 0;
    transform: translateY(-120rpx) scale(1.05) rotate(220deg);
  }
}

@media (max-width: 360px) {
  .referral-qr-box {
    height: 260rpx;
  }

  .referral-qr-box__image {
    width: 230rpx;
    height: 230rpx;
  }
}
