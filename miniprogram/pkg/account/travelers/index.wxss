.travelers-page {
  padding-bottom: 120rpx;
}

.travelers-hero {
  margin-top: 28rpx;
  padding-bottom: 22rpx;
}

.travelers-add-button {
  margin-top: 32rpx;
}

.travelers-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.traveler-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 250, 241, 0.72);
  border: 1rpx solid rgba(153, 57, 33, 0.14);
}

.traveler-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.traveler-card__head-main {
  flex: 1;
  min-width: 0;
}

.traveler-card__head-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.traveler-card__title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  line-height: 1.45;
  color: #2b241d;
}

.traveler-card__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 18rpx;
  margin-top: 24rpx;
}

.traveler-card__row {
  font-size: 24rpx;
  line-height: 1.8;
  color: #6a5a4b;
  min-width: 0;
  word-break: break-all;
}

.traveler-card__row--full {
  grid-column: 1 / -1;
}

.traveler-card__action-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 6rpx;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.3);
  flex: none;
}

.traveler-card__action-trigger--compact {
  min-width: 52rpx;
}

.traveler-card__action-trigger--danger {
  border-bottom-color: rgba(122, 31, 31, 0.28);
}

.traveler-card__action-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: #993921;
  white-space: nowrap;
}

.traveler-card__action-trigger--danger .traveler-card__action-label {
  color: #7a1f1f;
}

.traveler-editor-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
}

.traveler-editor-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.32);
}

.traveler-editor-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #f8f1e4;
  overflow-y: auto;
}

.traveler-editor-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.traveler-editor-sheet__title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  line-height: 1.45;
  color: #2b241d;
}

.traveler-editor-sheet__close {
  font-size: 40rpx;
  color: #6a5a4b;
}

.traveler-form-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.traveler-form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.traveler-form-row__item {
  min-width: 0;
}

.traveler-form-group__label {
  font-size: 24rpx;
  color: #6a5a4b;
}

.traveler-form-group__input,
.traveler-form-group__picker {
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 250, 241, 0.92);
  border: 1rpx solid rgba(153, 57, 33, 0.12);
}

.traveler-form-group__picker {
  display: flex;
  align-items: center;
  width: 100%;
  color: #2b241d;
}

.traveler-form-group__picker--placeholder {
  color: #8c7968;
}

.traveler-form-group__input--error {
  border-color: rgba(122, 31, 31, 0.35);
}

.traveler-form-group__error {
  font-size: 22rpx;
  color: #7a1f1f;
}

.traveler-editor-sheet__footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 34rpx;
}

.traveler-editor-sheet__button {
  flex: 1;
}

.traveler-editor-sheet__button--primary {
  color: #f5f0e6;
}
