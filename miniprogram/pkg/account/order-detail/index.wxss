.order-detail-page {
  padding-bottom: 160rpx;
}

.order-detail__status {
  margin-top: 0;
  font-size: 56rpx;
  flex: 1;
  min-width: 0;
}

.order-detail__eyebrow {
  margin-bottom: 0;
}

.order-detail__meta-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-detail__meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.order-detail__meta-label {
  min-width: 120rpx;
  color: #8a7567;
}

.order-detail__meta-value {
  flex: 1;
  color: #5f5146;
}

.order-detail__status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.order-detail__consult-link {
  flex-shrink: 0;
  margin-top: 18rpx;
  line-height: 1.6;
  text-align: right;
}

.order-detail__journey-card {
  transition: opacity 0.16s ease-out, transform 0.16s ease-out;
}

.order-detail__journey-card--pressing {
  opacity: 0.9;
  transform: scale(0.992);
}

.order-product {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 20rpx;
}

.order-product__cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(153, 57, 33, 0.08);
}

.order-product__cover--placeholder {
  position: relative;
  overflow: hidden;
}

.order-product__cover--placeholder::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(153, 57, 33, 0.12), rgba(153, 57, 33, 0.03));
}

.order-product__arrow {
  flex-shrink: 0;
  align-self: center;
  font-size: 42rpx;
  line-height: 1;
  color: rgba(153, 57, 33, 0.44);
}

.order-product__cover--placeholder::after {
  content: "旅程";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: rgba(153, 57, 33, 0.72);
}

.order-product__body {
  flex: 1;
  min-width: 0;
}

.order-product__name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #241b14;
}

.order-product__meta {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b594d;
}

.price-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b594d;
}

.price-row__value {
  flex-shrink: 0;
  color: #4f4036;
}

.price-row--strong {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #241b14;
}

.order-travelers {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-traveler {
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(107, 89, 77, 0.12);
}

.order-traveler:first-child {
  padding-top: 0;
  border-top: 0;
}

.order-traveler__title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #241b14;
}

.order-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
}

.order-actions__button {
  flex: 1;
}

.pending-pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1800;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffaf4;
  box-shadow: 0 -10rpx 32rpx rgba(84, 57, 31, 0.12);
}

.pending-pay-bar__countdown {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: center;
  color: #b32828;
  background: #fff0dc;
}

.pending-pay-bar__main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 24rpx;
}

.pending-pay-bar__amount {
  flex: 1;
  min-width: 0;
}

.pending-pay-bar__price {
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #b32828;
}

.pending-pay-bar__cancel,
.pending-pay-bar__pay {
  min-width: 168rpx;
  min-height: 76rpx;
  font-size: 28rpx;
}

.consult-sheet {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.consult-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.32);
}

.consult-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, #FFF9F2 0%, #F9F4EC 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 46rpx rgba(84, 57, 31, 0.14);
  padding: 20rpx 32rpx 32rpx;
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.consult-sheet__panel--active {
  transform: translateY(0);
}

.consult-sheet__handle {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.18);
  margin: 8rpx auto 16rpx;
}

.consult-sheet__header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 16rpx;
  padding: 0 92rpx;
}

.consult-sheet__title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2b241d;
  text-align: center;
}

.sheet-close {
  position: absolute;
  top: 50%;
  right: 28rpx;
  transform: translateY(-50%);
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 8rpx;
  font-size: 44rpx;
  line-height: 34rpx;
  text-align: center;
  color: rgba(106, 90, 75, 0.92);
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.consult-sheet__cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.consult-card {
  width: 100%;
  padding: 8rpx 0 0;
  text-align: center;
}

.consult-card--tappable:active {
  opacity: 0.86;
}

.consult-card__qr {
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
}

.consult-card__label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #2b241d;
  text-align: center;
}

.consult-card__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6a5a4b;
  text-align: center;
}
