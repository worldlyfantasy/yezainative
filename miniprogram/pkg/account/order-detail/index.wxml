<view wx:if="{{order}}" class="page-shell order-detail-page">
  <view class="paper-block">
    <text class="page-eyebrow">{{statusTitleText}}</text>
    <view class="order-detail__status-row">
      <text class="page-title order-detail__status">{{order.statusText}}</text>
      <button
        wx:if="{{order.displayStatusKey === 'pending' || order.displayStatusKey === 'paid'}}"
        class="order-detail__consult-button"
        bindtap="openConsultSheet"
      >
        咨询入口 ›
      </button>
    </view>
    <text class="page-subtitle">{{orderIdLabelText}}：#{{order.shortId}} · 创建时间：{{order.createdAt}}</text>
  </view>

  <view class="section-block paper-block">
    <text class="section-title">旅程信息</text>
    <view class="order-product">
      <image class="order-product__cover" src="{{order.cover}}" mode="aspectFill"></image>
      <view class="order-product__body">
        <text class="order-product__name">{{order.serviceName}}</text>
        <text class="order-product__meta">日期 {{order.travelDate}} · {{order.peopleCount}} 人 · {{order.serviceType}}</text>
      </view>
    </view>
  </view>

  <view class="section-block paper-block">
    <text class="section-title">{{priceTitleText}}</text>
    <view class="price-row"><text>价格</text><text>{{order.amountText}}</text></view>
    <view class="price-row"><text>优惠</text><text>¥{{order.discount}}</text></view>
    <view class="price-row price-row--strong"><text>{{payableLabelText}}</text><text>{{order.payableText}}</text></view>
  </view>

  <view class="section-block paper-block">
    <text class="section-title">出行人信息</text>
    <view class="detail-list">
      <text class="detail-list-item">姓名：{{order.traveler.name}}</text>
      <text class="detail-list-item">证件：{{order.traveler.idCard}}</text>
      <text class="detail-list-item">手机：{{order.traveler.phone}}</text>
    </view>
  </view>

  <view class="section-block paper-block">
    <text class="section-title">联系与服务</text>
    <view class="detail-list">
      <text class="detail-list-item">{{creatorContactText}}</text>
      <text class="detail-list-item">{{serviceContactText}}</text>
    </view>
  </view>

  <view class="order-actions" wx:if="{{order.status === 'pending' || order.status === 'completed'}}">
    <button
      wx:if="{{order.status === 'pending'}}"
      class="outline-button order-actions__button"
      bindtap="handleSecondary"
    >
      {{pendingSecondaryText}}
    </button>
    <button
      wx:if="{{order.status === 'completed'}}"
      class="primary-button order-actions__button"
      bindtap="handlePrimary"
    >
      {{completedPrimaryText}}
    </button>
  </view>
</view>

<view wx:if="{{consultSheetVisible}}" class="consult-sheet">
  <view class="consult-sheet__backdrop" bindtap="closeConsultSheet"></view>
  <view class="consult-sheet__panel {{consultSheetAnimating ? 'consult-sheet__panel--active' : ''}}">
    <view class="consult-sheet__handle"></view>
    <view class="consult-sheet__header">
      <text class="consult-sheet__title">{{consultSheetTitle}}</text>
      <view class="sheet-close consult-sheet__close" bindtap="closeConsultSheet">⌄</view>
    </view>
    <view class="consult-sheet__cards">
      <view class="consult-card">
        <image class="consult-card__qr" src="{{consultGroupQr}}" mode="aspectFit"></image>
        <text wx:if="{{consultCardLabel}}" class="consult-card__label">{{consultCardLabel}}</text>
        <text class="consult-card__desc">{{consultCardDesc}}</text>
        <text class="consult-card__desc">{{consultFollowupNote}}</text>
      </view>
    </view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
