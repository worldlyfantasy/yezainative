.custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: stretch;
  padding: 10rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.86), rgba(242, 230, 201, 0.96));
  border-top: 1rpx solid rgba(153, 57, 33, 0.14);
  box-shadow: 0 -12rpx 30rpx rgba(84, 57, 31, 0.05);
}

.custom-tab-bar__item {
  flex: 1;
  min-height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 24rpx;
  border-bottom: 0;
  transition: background 0.18s ease-out, opacity 0.18s ease-out;
}

.custom-tab-bar__item--active {
  background: rgba(255, 249, 242, 0.42);
}

.custom-tab-bar__icon {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.custom-tab-bar__text {
  font-size: 22rpx;
  line-height: 1.3;
  color: #b79b63;
  font-weight: 500;
}

.custom-tab-bar__item--active .custom-tab-bar__text {
  color: #d15e14;
}
