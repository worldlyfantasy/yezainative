{
  "pages": [
    "pages/splash/splash",
    "pages/home/home",
    "pages/creators/index",
    "pages/destinations/index",
    "pages/profile/index",
    "pages/how-it-works/index"
  ],
  "subPackages": [
    {
      "root": "pkg/explore",
      "pages": [
        "creator-detail/index",
        "custom-services/index",
        "destination-detail/index",
        "service-detail/index",
        "checkout/index"
      ]
    },
    {
      "root": "pkg/content",
      "pages": [
        "ideas/index",
        "idea-detail/index",
        "article-bridge/index"
      ]
    },
    {
      "root": "pkg/account",
      "pages": [
        "assets/index",
        "share-referral-rules/index",
        "favorites/index",
        "orders/index",
        "payout-account/index",
        "travelers/index",
        "order-detail/index",
        "payment-result/index"
      ]
    },
    {
      "root": "pkg/activity",
      "pages": [
        "share-referral/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "wifi",
      "packages": [
        "pkg/explore",
        "pkg/content"
      ]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": [
        "pkg/account"
      ]
    }
  },
  "usingComponents": {
    "app-tab-bar": "/custom-tab-bar/index"
  },
  "window": {
    "backgroundColor": "#f5efe3",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#f5efe3",
    "navigationBarTitleText": "",
    "navigationBarTextStyle": "black"
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents"
}
