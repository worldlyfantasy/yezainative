{
  "pages": [
    "pages/splash/splash",
    "pages/home/home",
    "pages/creators/index",
    "pages/destinations/index",
    "pages/profile/index",
    "pages/how-it-works/index"
  ],
  "subPackages": [
    {
      "root": "pkg/explore",
      "pages": [
        "creator-detail/index",
        "destination-detail/index",
        "service-detail/index",
        "checkout/index"
      ]
    },
    {
      "root": "pkg/content",
      "pages": [
        "ideas/index",
        "idea-detail/index",
        "article-bridge/index"
      ]
    },
    {
      "root": "pkg/account",
      "pages": [
        "assets/index",
        "favorites/index",
        "orders/index",
        "payout-account/index",
        "travelers/index",
        "order-detail/index",
        "payment-result/index"
      ]
    },
    {
      "root": "pkg/activity",
      "pages": [
        "share-referral/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": [
        "pkg/explore",
        "pkg/content"
      ]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": [
        "pkg/account"
      ]
    }
  },
  "usingComponents": {
    "app-tab-bar": "/custom-tab-bar/index",
    "hero-image": "/components/yezai/hero-image/index",
    "page-title": "/components/yezai/page-title/index",
    "section-title": "/components/yezai/section-title/index",
    "narrative-text": "/components/yezai/narrative-text/index",
    "quote-block": "/components/yezai/quote-block/index",
    "creator-row": "/components/yezai/creator-row/index",
    "favorite-star": "/components/yezai/favorite-star/index",
    "journey-item": "/components/yezai/journey-item/index",
    "invite-button": "/components/yezai/invite-button/index",
    "divider-line": "/components/yezai/divider-line/index"
  },
  "window": {
    "backgroundColor": "#f5efe3",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#f5efe3",
    "navigationBarTitleText": "",
    "navigationBarTextStyle": "black"
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents"
}
