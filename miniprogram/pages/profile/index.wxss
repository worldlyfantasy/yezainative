.profile-page {
  padding: 24rpx 36rpx calc(244rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 42rpx 36rpx;
  border: 1rpx solid rgba(151, 124, 91, 0.18);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 85% 18%, rgba(255, 250, 242, 0.94), rgba(255, 250, 242, 0) 24%),
    radial-gradient(circle at 12% 82%, rgba(214, 190, 153, 0.2), rgba(214, 190, 153, 0) 28%),
    linear-gradient(150deg, rgba(255, 250, 242, 0.92), rgba(242, 230, 201, 0.76) 48%, rgba(226, 211, 181, 0.84));
  box-shadow: 0 24rpx 52rpx rgba(93, 71, 45, 0.08);
}

.profile-hero__glyph {
  position: absolute;
  z-index: 0;
  pointer-events: none;
  opacity: 0.14;
}

.profile-hero__glyph--ye {
  top: 22rpx;
  right: 40rpx;
  width: 164rpx;
  height: 164rpx;
  transform: rotate(8deg);
}

.profile-hero__glyph--zai {
  right: -6rpx;
  bottom: -10rpx;
  width: 188rpx;
  height: 188rpx;
  transform: rotate(-7deg);
}

.profile-hero__eyebrow,
.profile-hero__title,
.profile-hero__desc,
.profile-hero__button,
.profile-identity {
  position: relative;
  z-index: 1;
}

.profile-hero__eyebrow {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(143, 61, 36, 0.82);
}

.profile-hero__title {
  display: block;
  margin-top: 18rpx;
  padding-right: 140rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 54rpx;
  line-height: 1.32;
  font-weight: 500;
  color: #2a2119;
}

.profile-hero__desc {
  display: block;
  margin-top: 18rpx;
  max-width: 500rpx;
  font-size: 25rpx;
  line-height: 1.9;
  color: #5f5144;
}

.profile-hero__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  min-height: 84rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff9f2;
  background: #D15E14;
  box-shadow: 0 14rpx 30rpx rgba(209, 94, 20, 0.18);
}

/* 未登录：单框 = 底图完整 + 中央乳白区文案与按钮 */
.profile-guest-wrap {
  margin-bottom: 0;
}

.profile-guest-card {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.1);
  box-shadow: 0 24rpx 52rpx rgba(84, 57, 31, 0.08);
}

.profile-guest-card__bg {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 36rpx;
}

/* 中间整体位置：改 top 可上下移动，如 58% 更靠下、45% 更靠上 */
.profile-guest-card__content {
  position: absolute;
  left: 50%;
  top: 58%;
  transform: translate(-50%, -50%);
  width: 86%;
  max-width: 560rpx;
  padding: 0;
  text-align: center;
}

.profile-guest-card__title {
  display: block;
  margin-top: 0;
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 48rpx;
  line-height: 1.32;
  font-weight: 500;
  color: #2a2119;
  text-shadow: 0 2rpx 8rpx rgba(255, 250, 242, 0.8);
}

.profile-guest-card__desc {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.85;
  color: #3d352d;
  text-shadow: 0 2rpx 6rpx rgba(255, 250, 242, 0.7);
}

/* 用 view 实现，宽度由 padding 控制，无组件默认最小宽度 */
.profile-guest-card__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 100rpx;
  min-height: 64rpx;
  padding: 10rpx 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff9f2;
  background: #D15E14;
  box-shadow: 0 14rpx 30rpx rgba(209, 94, 20, 0.18);
}

.profile-guest-card__button--pressing {
  opacity: 0.92;
}

.profile-identity {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 22rpx;
}

.profile-identity__row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.profile-identity__avatar-wrap {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  z-index: 0;
}

.profile-identity__avatar-hitbox {
  position: absolute;
  inset: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.profile-identity__avatar-hitbox::after {
  border: none;
}

.profile-identity__avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 250, 242, 0.8);
  box-shadow: 0 12rpx 24rpx rgba(98, 79, 54, 0.12);
}

.profile-identity__avatar--placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background:
    radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 36%),
    linear-gradient(145deg, rgba(212, 205, 194, 0.9), rgba(236, 232, 224, 0.98));
  box-shadow:
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.46),
    0 12rpx 24rpx rgba(98, 79, 54, 0.08);
}

.profile-identity__avatar-placeholder {
  font-size: 18rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: rgba(97, 89, 77, 0.9);
}

.profile-identity__meta {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.profile-identity__name-hit {
  display: inline-flex;
  align-items: flex-start;
  max-width: 100%;
}

.profile-identity__name-hit--pressing {
  opacity: 0.76;
}

.profile-identity__name {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 48rpx;
  line-height: 1.25;
  color: #2a2119;
}

.profile-identity__member {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(143, 61, 36, 0.8);
}

.profile-identity__note {
  display: block;
  margin-top: 4rpx;
  padding-left: 0;
  font-size: 24rpx;
  line-height: 1.75;
  color: #66584a;
}

/* 退出：无框，红褐色文字 + 右箭头，与「查看全部 →」同风格 */
.profile-identity__logout {
  flex-shrink: 0;
  align-self: center;
  margin-left: auto;
  margin-right: 40rpx;
  margin-bottom: 70rpx;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 0;
  line-height: 1.3;
  font-size: 24rpx;
}

.profile-identity__logout-text,
.profile-identity__logout-arrow {
  color: rgba(143, 61, 36, 0.88);
  font-weight: 500;
}

.profile-identity__logout-arrow {
  font-size: 26rpx;
  line-height: 1;
}

.profile-identity__logout--pressing {
  opacity: 0.75;
}

.profile-identity__nickname-editor {
  margin-left: 160rpx;
  margin-right: 20rpx;
}

.profile-identity__nickname-input {
  min-height: 74rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 250, 242, 0.94);
  font-size: 28rpx;
  color: #2a2119;
  box-shadow: inset 0 0 0 1rpx rgba(151, 124, 91, 0.12);
}

.profile-identity__nickname-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.profile-identity__nickname-cancel,
.profile-identity__nickname-save {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.profile-identity__nickname-cancel {
  color: rgba(143, 61, 36, 0.88);
  background: rgba(255, 250, 242, 0.82);
}

.profile-identity__nickname-save {
  color: #fff9f2;
  background: #D15E14;
}

.profile-identity__nickname-cancel--pressing,
.profile-identity__nickname-save--pressing {
  opacity: 0.78;
}

.profile-entry-grid {
  display: flex;
  flex-direction: column;
  margin-top: 92rpx;
  padding: 0 10rpx;
  gap: 18rpx;
}

.profile-entry-row {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
}

.profile-entry-card {
  flex: 1;
  min-width: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 152rpx;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.08);
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(251, 247, 239, 0.98), rgba(255, 250, 242, 0.88)),
    linear-gradient(135deg, rgba(232, 216, 191, 0.05), rgba(184, 114, 75, 0.02));
  box-shadow: 0 10rpx 22rpx rgba(84, 57, 31, 0.035);
  text-align: left;
}

.profile-entry-card--strong {
  background:
    linear-gradient(180deg, rgba(247, 236, 212, 0.98), rgba(241, 226, 196, 0.92)),
    linear-gradient(135deg, rgba(184, 114, 75, 0.08), rgba(153, 57, 33, 0.03));
  border-color: rgba(209, 94, 20, 0.14);
  box-shadow: 0 14rpx 28rpx rgba(84, 57, 31, 0.05);
}

.profile-entry-card__glyph {
  position: absolute;
  right: 10rpx;
  bottom: 4rpx;
  width: 94rpx;
  height: 94rpx;
  opacity: 0.2;
  pointer-events: none;
}

.profile-entry-card--glyph-soft .profile-entry-card__glyph {
  opacity: 0.42;
}

.profile-entry-card__head {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.profile-entry-card__title-wrap {
  display: inline-flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.profile-entry-card__title {
  display: block;
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: #2a2119;
}

.profile-entry-card__desc {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12rpx;
  max-width: 200rpx;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: rgba(92, 78, 66, 0.82);
}

.profile-entry-card__arrow {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1;
  color: rgba(184, 114, 75, 0.72);
}

.profile-custom-entry {
  position: relative;
  overflow: hidden;
  min-height: 260rpx;
  margin-top: 34rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(194, 150, 84, 0.24);
  background:
    radial-gradient(circle at 82% 22%, rgba(255, 250, 242, 0.92), rgba(255, 250, 242, 0) 28%),
    linear-gradient(135deg, rgba(255, 250, 242, 0.86), rgba(238, 218, 174, 0.7));
  box-shadow: 0 18rpx 42rpx rgba(93, 71, 45, 0.07);
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.profile-custom-entry--pressing {
  opacity: 0.9;
  transform: scale(0.992);
}

.profile-custom-entry__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.78;
}

.profile-custom-entry__shade {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 78% 48%, rgba(255, 250, 242, 0.62), rgba(255, 250, 242, 0) 42%),
    linear-gradient(90deg, rgba(255, 248, 232, 0.22), rgba(247, 230, 190, 0.3) 42%, rgba(255, 248, 232, 0.56) 72%, rgba(255, 248, 232, 0.38)),
    linear-gradient(180deg, rgba(255, 250, 242, 0.18), rgba(196, 156, 96, 0.08));
}

.profile-custom-entry__content {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 28rpx;
  bottom: 0;
  display: flex;
  width: 300rpx;
  flex-direction: column;
  justify-content: center;
  padding: 36rpx 0;
  box-sizing: border-box;
}

.profile-custom-entry__eyebrow {
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 4rpx;
  color: rgba(153, 57, 33, 0.68);
}

.profile-custom-entry__title {
  display: block;
  margin-top: 12rpx;
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 50rpx;
  line-height: 1.25;
  font-weight: 500;
  color: #3a2c22;
  text-shadow: 0 2rpx 10rpx rgba(255, 250, 242, 0.72);
}

.profile-custom-entry__desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 249, 242, 0.86);
}

.profile-custom-entry__arrow {
  position: absolute;
  z-index: 1;
  right: 28rpx;
  bottom: 28rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.58);
  text-align: center;
  font-size: 44rpx;
  line-height: 52rpx;
  color: rgba(153, 57, 33, 0.58);
  box-shadow: 0 8rpx 20rpx rgba(93, 71, 45, 0.08);
  text-shadow: 0 2rpx 10rpx rgba(255, 250, 242, 0.72);
}

.is-pressing {
  opacity: 0.96;
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 20rpx rgba(90, 64, 40, 0.12);
}

.is-pressing-soft {
  opacity: 0.9;
}

.is-pressing-card {
  opacity: 0.94;
  transform: translateY(2rpx);
}

.profile-contact {
  margin-top: 88rpx;
  padding: 22rpx 6rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.profile-contact__label {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-align: center;
  color: rgba(153, 57, 33, 0.9);
}

.profile-contact__email {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
  color: rgba(74, 58, 43, 0.76);
}

.profile-credit {
  margin-top: 72rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(74, 58, 43, 0.48);
}

.profile-completion-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 28rpx 32rpx;
  background: rgba(35, 28, 20, 0.42);
  box-sizing: border-box;
}

.profile-completion-mask--keyboard {
  align-items: center;
  padding-bottom: 360rpx;
}

.profile-completion-panel {
  width: 100%;
  max-height: 86vh;
  overflow: hidden;
  padding: 34rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx;
  border: 1rpx solid rgba(151, 124, 91, 0.2);
  background:
    radial-gradient(circle at 88% 12%, rgba(255, 250, 242, 0.96), rgba(255, 250, 242, 0) 26%),
    linear-gradient(180deg, rgba(255, 250, 242, 0.98), rgba(245, 239, 227, 0.96));
  box-shadow: 0 -18rpx 52rpx rgba(28, 22, 15, 0.18);
  box-sizing: border-box;
}

.profile-completion__head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.profile-completion__eyebrow {
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 5rpx;
  color: rgba(143, 61, 36, 0.72);
}

.profile-completion__title {
  display: block;
  margin-top: 10rpx;
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 44rpx;
  line-height: 1.28;
  font-weight: 500;
  color: #2a2119;
}

.profile-completion__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #66584a;
}

.profile-completion__avatar-button {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  margin: 34rpx 0 0;
  padding: 24rpx;
  border: 1rpx solid rgba(151, 124, 91, 0.14);
  border-radius: 28rpx;
  background: rgba(255, 250, 242, 0.82);
  text-align: left;
  line-height: 1;
  box-sizing: border-box;
}

.profile-completion__avatar-button::after {
  border: none;
}

.profile-completion__avatar-shell {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
}

.profile-completion__avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 250, 242, 0.9);
  box-shadow: 0 12rpx 24rpx rgba(98, 79, 54, 0.12);
  box-sizing: border-box;
}

.profile-completion__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0) 38%),
    linear-gradient(145deg, rgba(226, 211, 181, 0.96), rgba(209, 94, 20, 0.18));
}

.profile-completion__avatar-mark {
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1;
  color: rgba(42, 33, 25, 0.72);
}

.profile-completion__avatar-label {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #2a2119;
}

.profile-completion__field {
  margin-top: 26rpx;
}

.profile-completion__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(143, 61, 36, 0.78);
}

.profile-completion__nickname-input {
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 250, 242, 0.96);
  font-size: 28rpx;
  color: #2a2119;
  box-shadow: inset 0 0 0 1rpx rgba(151, 124, 91, 0.16);
  box-sizing: border-box;
}

.profile-completion__actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 30rpx;
}

.profile-completion__later,
.profile-completion__save {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.profile-completion__later {
  flex: 0 0 auto;
  color: rgba(143, 61, 36, 0.88);
  background: rgba(255, 250, 242, 0.74);
}

.profile-completion__save {
  flex: 1;
  color: #fff9f2;
  background: #D15E14;
  box-shadow: 0 14rpx 30rpx rgba(209, 94, 20, 0.18);
}

.profile-completion__save--disabled {
  opacity: 0.68;
}

.profile-completion__later--pressing,
.profile-completion__save--pressing {
  opacity: 0.78;
}
