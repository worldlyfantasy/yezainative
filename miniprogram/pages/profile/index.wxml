<view class="page-shell profile-page">
  <view wx:if="{{!loggedIn}}" class="profile-guest-wrap">
    <view class="profile-guest-card">
      <image class="profile-guest-card__bg" src="cloud://yezai-3gr73wd48057512e-10f17b581.7965-yezai-3gr73wd48057512e-10f17b581-1407224025/brandasset/野哉-新媒体尺寸-小红书.jpg" mode="widthFix"></image>
      <view class="profile-guest-card__content">
        <text class="profile-guest-card__title">野于本心\n在彼途中</text>
        <view class="profile-guest-card__button" bindtap="handleLogin" hover-class="profile-guest-card__button--pressing" hover-stay-time="100">微信登录</view>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="profile-hero">
      <text class="profile-hero__eyebrow">MY YEZAI</text>
      <view class="profile-identity">
        <view class="profile-identity__row">
          <view class="profile-identity__avatar-wrap">
            <image wx:if="{{profileDraftAvatarUrl}}" class="profile-identity__avatar" src="{{profileDraftAvatarUrl}}" mode="aspectFill"></image>
            <image wx:elif="{{user.avatarUrl}}" class="profile-identity__avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="profile-identity__avatar profile-identity__avatar--placeholder">
              <text class="profile-identity__avatar-placeholder">点击</text>
              <text class="profile-identity__avatar-placeholder">编辑</text>
            </view>
            <button class="profile-identity__avatar-hitbox" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar"></button>
          </view>
          <view class="profile-identity__meta">
            <view class="profile-identity__name-hit" catchtap="handleStartNicknameEdit" hover-class="profile-identity__name-hit--pressing" hover-stay-time="100">
              <text class="profile-identity__name">{{user.nickname}}</text>
            </view>
            <text class="profile-identity__member">{{user.memberLabel}}</text>
          </view>
          <view class="profile-identity__logout" bindtap="handleLogout" hover-class="profile-identity__logout--pressing" hover-stay-time="100"><text class="profile-identity__logout-text">退出</text><text class="profile-identity__logout-arrow">→</text></view>
        </view>
        <view wx:if="{{profileNicknameEditing}}" class="profile-identity__nickname-editor">
          <input
            class="profile-identity__nickname-input"
            type="nickname"
            maxlength="20"
            placeholder="输入或选择昵称"
            value="{{profileDraftNickname}}"
            focus="{{nicknameInputFocus}}"
            confirm-type="done"
            bindinput="handleNicknameInput"
            bindblur="handleNicknameBlur"
            bindconfirm="handleNicknameConfirm"
          />
          <view class="profile-identity__nickname-actions">
            <view class="profile-identity__nickname-cancel" bindtap="handleNicknameCancel" hover-class="profile-identity__nickname-cancel--pressing" hover-stay-time="100">取消</view>
            <view class="profile-identity__nickname-save" bindtap="handleNicknameSaveTap" hover-class="profile-identity__nickname-save--pressing" hover-stay-time="100">完成</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-block profile-entry-grid">
      <view wx:for="{{shortcutRows}}" wx:key="index" wx:for-item="row" class="profile-entry-row">
        <button
          wx:for="{{row}}"
          wx:key="key"
          class="profile-entry-card {{item.cardClassName}}"
          hover-class="is-pressing-card"
          data-key="{{item.key}}"
          bindtap="onShortcutTap"
        >
          <image class="profile-entry-card__glyph" src="{{item.glyphSrc}}" mode="aspectFit"></image>
          <view class="profile-entry-card__head">
            <view class="profile-entry-card__title-wrap">
              <text class="profile-entry-card__title">{{item.label}}</text>
            </view>
            <text class="profile-entry-card__arrow">›</text>
          </view>
          <text class="profile-entry-card__desc">{{item.desc}}</text>
        </button>
      </view>
    </view>

    <view class="section-block profile-custom-entry" bindtap="onCustomTripEntryTap" hover-class="profile-custom-entry--pressing" hover-stay-time="100">
      <image class="profile-custom-entry__image" src="{{customTripEntryImage}}" mode="aspectFill"></image>
      <view class="profile-custom-entry__shade"></view>
      <view class="profile-custom-entry__content">
        <text class="profile-custom-entry__eyebrow">YEZAI CUSTOM</text>
        <text class="profile-custom-entry__title">野哉定制</text>
      </view>
      <text class="profile-custom-entry__arrow">›</text>
    </view>

    <view class="profile-contact">
      <text class="profile-contact__label">写信给野哉</text>
      <text class="profile-contact__email">zhayeye@yezai.me</text>
    </view>
  </block>

  <view wx:if="{{profilePromptVisible}}" class="profile-completion-mask {{profilePromptKeyboardActive ? 'profile-completion-mask--keyboard' : ''}}" catchtouchmove="noop">
    <view class="profile-completion-panel" catchtap="noop">
      <view class="profile-completion__head">
        <text class="profile-completion__eyebrow">PROFILE</text>
        <text class="profile-completion__title">完善头像和昵称</text>
        <text class="profile-completion__desc">方便我们识别你的报名、订单和沟通记录。</text>
      </view>

      <button class="profile-completion__avatar-button" open-type="chooseAvatar" bindchooseavatar="handleProfilePromptChooseAvatar">
        <view class="profile-completion__avatar-shell">
          <image wx:if="{{profileDraftAvatarUrl}}" class="profile-completion__avatar" src="{{profileDraftAvatarUrl}}" mode="aspectFill"></image>
          <image wx:elif="{{user.avatarUrl}}" class="profile-completion__avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="profile-completion__avatar profile-completion__avatar--placeholder">
            <text class="profile-completion__avatar-mark">野哉</text>
          </view>
        </view>
        <text class="profile-completion__avatar-label">选择头像</text>
      </button>

      <view class="profile-completion__field">
        <text class="profile-completion__label">昵称</text>
        <input
          class="profile-completion__nickname-input"
          type="nickname"
          maxlength="20"
          placeholder="输入或选择微信昵称"
          value="{{profileDraftNickname}}"
          focus="{{profilePromptNicknameFocus}}"
          confirm-type="done"
          bindinput="handleNicknameInput"
          bindfocus="handleProfilePromptNicknameFocus"
          bindblur="handleProfilePromptNicknameBlur"
          bindconfirm="handleProfilePromptConfirm"
        />
      </view>

      <view class="profile-completion__actions">
        <view class="profile-completion__later" bindtap="handleProfilePromptDismiss" hover-class="profile-completion__later--pressing" hover-stay-time="100">稍后再说</view>
        <view class="profile-completion__save {{profileSaving ? 'profile-completion__save--disabled' : ''}}" bindtap="handleProfilePromptSave" hover-class="profile-completion__save--pressing" hover-stay-time="100">{{profileSaving ? "保存中" : "完成"}}</view>
      </view>
    </view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
