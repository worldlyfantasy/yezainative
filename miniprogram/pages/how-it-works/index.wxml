<view class="page-shell">
  <view class="paper-block">
    <text class="page-eyebrow">信任机制</text>
    <text class="page-subtitle">{{introText}}</text>

    <view class="flow-list">
      <view wx:for="{{flows}}" wx:key="title" class="flow-item">
        <text class="flow-item__title">{{item.title}}</text>
        <text class="flow-item__desc">{{item.description}}</text>
      </view>
    </view>

    <view class="flow-cta">
      <text class="page-eyebrow">准备好了？</text>
      <text class="section-title">{{ctaTitle}}</text>
      <text class="page-subtitle">{{ctaDesc}}</text>
      <button class="primary-button flow-cta__button" bindtap="handleOfflineOrder">{{ctaButtonText}}</button>
    </view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
