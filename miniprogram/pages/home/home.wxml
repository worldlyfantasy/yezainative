<view class="home-page">
  <view class="hero">
    <swiper
      class="hero__swiper"
      indicator-dots="{{true}}"
      autoplay="{{true}}"
      circular="{{true}}"
      interval="1000000"
      duration="1000"
    >
      <swiper-item wx:for="{{heroSlides}}" wx:key="id">
        <view
          class="hero__slide hero__slide--{{item.variant}} {{item.tone === 'muted' ? 'hero__slide--muted' : ''}}"
          bindtap="onHeroTap"
          data-slug="{{item.targetIdeaSlug}}"
          data-source-type="{{item.sourceType}}"
          data-wechat-article-url="{{item.wechatArticleUrl}}"
          data-wechat-article-title="{{item.wechatArticleTitle}}"
          data-title="{{item.title}}"
        >
          <block wx:if="{{item.variant === 'photo'}}">
            <view class="hero__image hero__image-bg" style="{{item.imageBackgroundStyle}}"></view>
            <view wx:if="{{item.showMask !== false}}" class="hero__mask"></view>
          </block>
          <block wx:else>
            <view class="hero__art">
              <view class="hero__art-band hero__art-band--top"></view>
              <view class="hero__art-band hero__art-band--middle"></view>
              <view class="hero__art-band hero__art-band--bottom"></view>
              <text class="hero__art-logo">野哉</text>
            </view>
            <view class="hero__mask hero__mask--art"></view>
          </block>
          <view wx:if="{{item.mark || item.title || item.desc || item.subDesc}}" class="hero__content">
            <text wx:if="{{item.mark}}" class="hero__mark">{{item.mark}}</text>
            <text class="hero__title">{{item.title}}</text>
            <text class="hero__desc">{{item.desc}}</text>
            <text wx:if="{{item.subDesc}}" class="hero__desc hero__desc--secondary">{{item.subDesc}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view class="hero__transition">
    <view class="hero__transition-fade"></view>
  </view>

  <view class="page-shell">
    <view wx:if="{{errorText}}" class="section-block paper-block page-feedback">
      <text class="page-feedback__title">首页暂时不可用</text>
      <text class="page-feedback__desc">{{errorText}}</text>
    </view>
    <view wx:elif="{{loading}}" class="section-block empty-state">首页内容加载中...</view>
    <block wx:else>
      <view class="section-block home-services">
        <view class="service-tabs">
          <text
            wx:for="{{serviceTabs}}"
            wx:key="key"
            class="service-tab {{item.key === activeServiceTab ? 'service-tab--active' : ''}} {{item.key === 'more' ? 'service-tab--more' : ''}}"
            data-tab="{{item.key}}"
            bindtap="onServiceTabChange"
          >{{item.label}}</text>
        </view>
        <scroll-view class="trip-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="trip-scroll__track">
            <view
              wx:for="{{activeServices}}"
              wx:key="slug"
              class="trip-card"
              bindtap="onServiceTap"
              data-slug="{{item.slug}}"
            >
              <view class="trip-card__cover-wrap">
                <image wx:if="{{item.cover}}" class="trip-card__cover" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}"></image>
                <view class="trip-card__mask"></view>
                <view class="trip-card__cover-meta">
                  <text class="trip-card__title">{{item.name}}</text>
                  <text wx:if="{{item.priceLabel}}" class="trip-card__price">{{item.priceLabel}}</text>
                </view>
              </view>
              <text class="trip-card__summary">{{item.summary}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="section-block home-creators">
        <view class="section-head">
          <view class="home-section-title-row">
            <text class="section-eyebrow">野哉创作者</text>
            <text class="section-link" bindtap="goCreators">查看全部 →</text>
          </view>
          <text class="home-section-desc">他们熟悉一片山、一条路、一座城的细节\n也愿意把真实经验交给远道而来的旅人</text>
        </view>
        <view class="creator-constellation">
          <view
            class="creator-constellation__field"
            bindtouchstart="onCreatorDialTouchStart"
            bindtouchmove="onCreatorDialTouchMove"
            bindtouchend="onCreatorDialTouchEnd"
            bindtouchcancel="onCreatorDialTouchEnd"
          >
            <view class="creator-constellation__plate" style="{{creatorDialStyle}}">
              <block wx:for="{{featuredCreators}}" wx:key="id">
                <view
                  wx:if="{{index < 13}}"
                  class="creator-constellation__item creator-constellation__item--{{index}}"
                  bindtap="onCreatorTap"
                  data-slug="{{item.slug}}"
                  hover-class="creator-constellation__item--pressed"
                  hover-stay-time="80"
                >
                  <view
                    wx:if="{{item.avatarBackgroundStyle}}"
                    class="creator-constellation__avatar creator-constellation__avatar-bg"
                    style="{{item.avatarBackgroundStyle}}"
                  ></view>
                  <image
                    wx:elif="{{item.avatar}}"
                    class="creator-constellation__avatar"
                    src="{{item.avatar}}"
                    mode="aspectFill"
                    lazy-load="{{index > 2}}"
                  ></image>
                  <text wx:else class="creator-constellation__fallback">{{item.name}}</text>
                </view>
              </block>
            </view>
          </view>
        </view>
      </view>

      <view class="section-block home-ideas">
        <view class="section-head">
          <view class="home-section-title-row">
            <text class="section-eyebrow">旅行故事</text>
            <text class="section-link" bindtap="goIdeas">阅读更多 →</text>
          </view>
          <text class="home-section-desc">把路上的风、人的声音和土地的纹理写下来\n在出发之前，先读见一段真实旅程</text>
        </view>
        <view class="idea-list">
          <view
            wx:for="{{featuredIdeas}}"
            wx:key="slug"
            class="idea-list-item {{item.displayMode === 'featured' ? 'idea-list-item--featured' : ''}}"
            data-slug="{{item.slug}}"
            data-source-type="{{item.sourceType}}"
            data-wechat-article-url="{{item.wechatArticleUrl}}"
            data-wechat-article-title="{{item.wechatArticleTitle}}"
            data-title="{{item.title}}"
            bindtap="onIdeaTap"
            hover-class="idea-list-item--pressed"
            hover-stay-time="80"
          >
            <view wx:if="{{item.displayMode === 'featured'}}" class="idea-list-item__cover-wrap">
              <view wx:if="{{item.cover}}" class="idea-list-item__cover idea-list-item__cover-bg" style="{{item.coverBackgroundStyle}}"></view>
              <image wx:else class="idea-list-item__cover" src="/images/content/hero-aba-presence.jpg" mode="aspectFill"></image>
              <text class="idea-list-item__cover-label">田野 · 现场笔记</text>
            </view>
            <view wx:elif="{{item.cover}}" class="idea-list-item__thumb-wrap">
              <view class="idea-list-item__thumb idea-list-item__cover-bg" style="{{item.coverBackgroundStyle}}"></view>
            </view>
            <view wx:else class="idea-list-item__stamp">
              <text class="idea-list-item__stamp-text">野哉</text>
            </view>
            <view class="idea-list-item__main">
              <view class="idea-list-item__meta-row">
                <text class="idea-list-item__theme">{{item.themeLabel || item.theme || '现场笔记'}}</text>
                <text class="idea-list-item__number">NO.{{index + 1}}</text>
              </view>
              <text class="idea-list-item__title">{{item.title}}</text>
              <text class="idea-list-item__summary" wx:if="{{item.summary}}">{{item.summary}}</text>
              <view class="idea-list-item__footer">
                <text class="idea-list-item__action">阅读全文</text>
                <text class="idea-list-item__arrow">→</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>

<app-tab-bar></app-tab-bar>
