<view class="home-page">
  <view class="hero">
    <swiper
      class="hero__swiper"
      indicator-dots="{{true}}"
      autoplay="{{true}}"
      circular="{{true}}"
      interval="1000000"
      duration="1000"
    >
      <swiper-item wx:for="{{heroSlides}}" wx:key="id">
        <view class="hero__slide hero__slide--{{item.variant}} {{item.tone === 'muted' ? 'hero__slide--muted' : ''}}" bindtap="onHeroTap" data-slug="{{item.targetIdeaSlug}}">
          <block wx:if="{{item.variant === 'photo'}}">
            <image class="hero__image" src="{{item.image}}" mode="aspectFill" lazy-load="{{index > 0}}" binderror="onHeroImageError" data-src="{{item.image}}" data-id="{{item.id}}"></image>
            <view wx:if="{{item.showMask !== false}}" class="hero__mask"></view>
          </block>
          <block wx:else>
            <view class="hero__art">
              <view class="hero__art-band hero__art-band--top"></view>
              <view class="hero__art-band hero__art-band--middle"></view>
              <view class="hero__art-band hero__art-band--bottom"></view>
              <text class="hero__art-logo">野哉</text>
            </view>
            <view class="hero__mask hero__mask--art"></view>
          </block>
          <view wx:if="{{item.mark || item.title || item.desc || item.subDesc}}" class="hero__content">
            <text wx:if="{{item.mark}}" class="hero__mark">{{item.mark}}</text>
            <text class="hero__title">{{item.title}}</text>
            <text class="hero__desc">{{item.desc}}</text>
            <text wx:if="{{item.subDesc}}" class="hero__desc hero__desc--secondary">{{item.subDesc}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view class="hero__transition">
    <view class="hero__transition-fade"></view>
  </view>

  <view class="page-shell">
    <view class="home-note">
      <text class="home-note__text">看见那些沉淀着在地经验、有温度的路线\n为每一位奔赴山海的旅行者\n照亮一条通往真实旅途的路径</text>
    </view>

    <view wx:if="{{errorText}}" class="section-block paper-block page-feedback">
      <text class="page-feedback__title">首页暂时不可用</text>
      <text class="page-feedback__desc">{{errorText}}</text>
    </view>
    <view wx:elif="{{loading}}" class="section-block empty-state">首页内容加载中...</view>
    <block wx:else>
      <image
        class="home-section-divider divider--mountain"
        src="/images/separator/sep-mountain.svg"
        mode="widthFix"
      ></image>

      <view class="section-block">
        <view class="section-head section-head--trip">
          <view>
            <text class="section-eyebrow">精选行程</text>
          </view>
          <text class="section-link" bindtap="goServices">查看全部 →</text>
        </view>
        <view class="service-tabs service-tabs--top">
          <text
            wx:for="{{serviceTabs}}"
            wx:key="key"
            class="service-tab {{item.key === activeServiceTab ? 'service-tab--active' : ''}}"
            data-tab="{{item.key}}"
            bindtap="onServiceTabChange"
          >{{item.label}}</text>
        </view>
        <scroll-view class="trip-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="trip-scroll__track">
            <view
              wx:for="{{activeServices}}"
              wx:key="slug"
              class="trip-card"
              bindtap="onServiceTap"
              data-slug="{{item.slug}}"
            >
              <view class="trip-card__cover-wrap">
                <image wx:if="{{item.cover}}" class="trip-card__cover" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}"></image>
                <view class="trip-card__mask"></view>
                <view class="trip-card__cover-meta">
                  <text class="trip-card__title">{{item.name}}</text>
                  <text wx:if="{{item.priceLabel}}" class="trip-card__price">{{item.priceLabel}}</text>
                </view>
              </view>
              <text class="trip-card__summary">{{item.summary}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
      <image
        class="home-section-divider divider--human"
        src="/images/separator/sep-human.svg"
        mode="widthFix"
      ></image>

      <view class="section-block">
        <view class="section-head">
          <view>
            <text class="section-eyebrow">精选创作者</text>
          </view>
          <text class="section-link" bindtap="goCreators">查看全部 →</text>
        </view>
        <view class="card-stack">
          <creator-card
            wx:for="{{featuredCreators}}"
            wx:key="id"
            creator="{{item}}"
            show-divider="{{false}}"
            bind:cardtap="onCreatorTap"
          ></creator-card>
        </view>
      </view>
      <image
        class="home-section-divider divider--pack"
        src="/images/separator/sep-pack.svg"
        mode="widthFix"
      ></image>

      <view class="section-block">
        <view class="section-head">
          <view>
            <text class="section-eyebrow">旅行文学</text>
          </view>
          <text class="section-link" bindtap="goIdeas">阅读更多 →</text>
        </view>
        <view class="card-stack">
          <idea-card
            wx:for="{{featuredIdeas}}"
            wx:key="slug"
            idea="{{item}}"
            author-name="{{item.authorName}}"
            show-divider="{{false}}"
            bind:cardtap="onIdeaTap"
          ></idea-card>
        </view>
      </view>
    </block>
  </view>
</view>

<app-tab-bar></app-tab-bar>
