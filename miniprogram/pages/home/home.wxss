.home-page {
  padding-bottom: 80rpx;
}

.hero {
  position: relative;
  height: 820rpx;
  overflow: hidden;
}

.hero__transition {
  width: 100%;
  background: #F2E6C9;
}

.hero__transition-fade {
  width: 100%;
  height: 34rpx;
  background: linear-gradient(180deg, rgba(43, 36, 29, 0.1) 0%, rgba(43, 36, 29, 0.035) 56%, rgba(43, 36, 29, 0) 100%);
}

.hero__swiper,
.hero__slide {
  width: 100%;
  height: 100%;
}

.hero__slide {
  background: #e7dece;
}

.hero__image,
.hero__mask,
.hero__art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero__mask {
  background: linear-gradient(180deg, rgba(21, 15, 11, 0.08), rgba(21, 15, 11, 0.3) 82%);
}

.hero__slide--muted .hero__image {
  opacity: 1;
}

.hero__slide--muted .hero__mask {
  background:
    linear-gradient(180deg, rgba(255, 251, 243, 0.03), rgba(247, 235, 211, 0.08) 46%, rgba(121, 78, 43, 0.05) 100%),
    linear-gradient(90deg, rgba(255, 248, 234, 0.03), rgba(255, 248, 234, 0));
}

.hero__mask--art {
  background:
    linear-gradient(180deg, rgba(255, 252, 244, 0.06), rgba(58, 34, 18, 0.18) 76%),
    linear-gradient(90deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0));
}

.hero__art {
  background:
    linear-gradient(180deg, #f2ead7 0%, #ece3d4 58%, #ede6da 100%);
}

.hero__art-band {
  position: absolute;
  left: -8%;
  width: 116%;
  border-radius: 999rpx;
  transform: rotate(-6deg);
}

.hero__art-band--top {
  top: -40rpx;
  height: 260rpx;
  background:
    linear-gradient(180deg, rgba(241, 208, 108, 0.94), rgba(233, 187, 80, 0.9));
}

.hero__art-band--middle {
  top: 300rpx;
  left: 40%;
  width: 92%;
  height: 300rpx;
  background:
    linear-gradient(180deg, rgba(198, 189, 176, 0.46), rgba(215, 206, 193, 0.64));
  transform: rotate(-10deg);
}

.hero__art-band--bottom {
  right: -12%;
  bottom: -120rpx;
  left: auto;
  width: 78%;
  height: 240rpx;
  background:
    linear-gradient(180deg, rgba(206, 124, 69, 0.9), rgba(170, 86, 40, 0.94));
  transform: rotate(-10deg);
}

.hero__art-logo {
  position: absolute;
  top: 116rpx;
  left: 58rpx;
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 120rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #9e3820;
  transform: rotate(-14deg);
}

.hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  padding: 72rpx 44rpx;
}

.hero__mark {
  display: block;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(242, 230, 201, 0.92);
}

.hero__title {
  margin-top: 18rpx;
  max-width: 560rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 68rpx;
  line-height: 1.52;
  font-weight: 500;
  color: #F2E6C9;
}

.hero__desc {
  display: block;
  margin-top: 22rpx;
  max-width: 520rpx;
  font-size: 28rpx;
  line-height: 1.95;
  color: rgba(242, 230, 201, 0.86);
}

.hero__slide--art .hero__mark {
  color: rgba(123, 53, 24, 0.72);
}

.hero__slide--art .hero__title {
  color: #3b2a1f;
}

.hero__slide--art .hero__desc {
  color: rgba(70, 52, 41, 0.9);
}

.hero__desc--secondary {
  margin-top: 6rpx;
}

.home-page .section-block {
  margin-top: 0;
}

.home-services {
  padding-top: 64rpx;
}

.home-page .home-creators,
.home-page .home-ideas {
  margin-top: 96rpx;
}

.home-page .section-head {
  display: block;
}

.home-section-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.home-page .section-head .section-eyebrow {
  margin-bottom: 10rpx;
}

.home-section-desc {
  display: block;
  max-width: 100%;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 0.4rpx;
  color: rgba(95, 82, 70, 0.74);
}

.idea-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.idea-list-item {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 22rpx;
  overflow: hidden;
  padding: 26rpx 24rpx 26rpx 28rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.1);
  border-radius: 30rpx;
  background:
    linear-gradient(180deg, rgba(255, 250, 239, 0.92), rgba(247, 238, 219, 0.76));
  box-shadow:
    0 18rpx 38rpx rgba(84, 57, 31, 0.07),
    inset 0 0 0 1rpx rgba(255, 249, 242, 0.56);
  transition: transform 160ms ease, opacity 160ms ease;
}

.idea-list-item--pressed {
  opacity: 0.9;
  transform: scale(0.985);
}

.idea-list-item--featured {
  display: block;
  padding: 0;
  border-radius: 34rpx;
  background: #fff8ea;
}

.idea-list-item__cover-wrap {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 248rpx;
  background: #2b241d;
}

.idea-list-item__cover {
  width: 100%;
  height: 100%;
  opacity: 0.94;
}

.idea-list-item__cover-label {
  position: absolute;
  left: 24rpx;
  bottom: 22rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255, 249, 242, 0.28);
  border-radius: 999rpx;
  background: rgba(43, 36, 29, 0.36);
  color: #fff9f2;
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 0.08em;
}

.idea-list-item__thumb-wrap {
  flex: 0 0 126rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #2b241d;
  box-shadow: inset 0 0 0 1rpx rgba(255, 249, 242, 0.22);
}

.idea-list-item__thumb {
  width: 100%;
  height: 100%;
}

.idea-list-item__stamp {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  min-height: 142rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(169, 77, 53, 0.18);
  background:
    linear-gradient(180deg, rgba(169, 77, 53, 0.1), rgba(109, 122, 82, 0.08)),
    rgba(255, 249, 242, 0.44);
}

.idea-list-item__stamp-text {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 24rpx;
  line-height: 1.1;
  text-align: center;
  color: rgba(153, 57, 33, 0.58);
}

.idea-list-item__main {
  flex: 1;
  min-width: 0;
}

.idea-list-item--featured .idea-list-item__main {
  padding: 26rpx 28rpx 28rpx;
}

.idea-list-item__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.idea-list-item__theme,
.idea-list-item__number {
  display: block;
  font-size: 20rpx;
  line-height: 1.35;
  letter-spacing: 0.12em;
  color: rgba(153, 57, 33, 0.68);
}

.idea-list-item__theme {
  max-width: 360rpx;
}

.idea-list-item__number {
  color: rgba(95, 82, 70, 0.5);
}

.idea-list-item__title {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #2b241d;
}

.idea-list-item--featured .idea-list-item__title {
  font-size: 42rpx;
  line-height: 1.34;
}

.idea-list-item__summary {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.68;
  color: #6a5a4b;
}

.idea-list-item__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(153, 57, 33, 0.08);
}

.idea-list-item__action {
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.12em;
  color: rgba(153, 57, 33, 0.72);
}

.idea-list-item__arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
  color: rgba(153, 57, 33, 0.56);
}

.trip-scroll {
  width: 100%;
}

.trip-scroll__track {
  display: flex;
  gap: 20rpx;
  width: max-content;
  padding-right: 20rpx;
}

.trip-card {
  width: 540rpx;
  height: 626rpx;
  padding-top: 18rpx;
  padding-bottom: 16rpx;
  border: none;
  border-radius: 18rpx;
  background:
    linear-gradient(180deg, rgba(255, 249, 242, 0.96), rgba(249, 244, 236, 0.9));
  box-shadow:
    0 18rpx 38rpx rgba(84, 57, 31, 0.07),
    inset 0 0 0 1rpx rgba(153, 57, 33, 0.06);
  box-sizing: border-box;
}

.trip-card__cover-wrap {
  position: relative;
  width: 502rpx;
  height: 502rpx;
  margin: 0 auto;
  border-radius: 18rpx;
  overflow: hidden;
}

.trip-card__cover {
  width: 100%;
  height: 100%;
  display: block;
}

.trip-card__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  background: linear-gradient(180deg, rgba(43, 36, 29, 0) 0%, rgba(43, 36, 29, 0.76) 100%);
}

.trip-card__cover-meta {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  left: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.trip-card__title {
  flex: 1;
  min-width: 0;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.22;
  color: #f6f2e8;
}

.trip-card__price {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.25;
  color: rgba(246, 242, 232, 0.94);
}

.trip-card__summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  width: 502rpx;
  margin: 18rpx auto 0;
  min-height: 72rpx;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.58;
  letter-spacing: 0.4rpx;
  text-align: left;
  color: #7f776d;
}

.service-tabs {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  width: 100%;
  margin: -14rpx 0 24rpx;
  padding-left: 2rpx;
}

.service-tab {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 218rpx;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.18);
  border-radius: 999rpx;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 600;
  text-align: center;
  color: rgba(143, 75, 51, 0.78);
  background: rgba(255, 249, 242, 0.44);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 249, 242, 0.26);
  box-sizing: border-box;
  white-space: nowrap;
}

.service-tab + .service-tab {
  margin-left: 0;
}

.service-tab--active {
  color: #fff5ee;
  border-color: rgba(153, 57, 33, 0);
  background: #993921;
  box-shadow: 0 10rpx 18rpx rgba(153, 57, 33, 0.16);
  z-index: 2;
}

.service-tab--active::before {
  display: none;
}

.service-tab--more {
  width: 224rpx;
  color: #993921;
}

.creator-constellation {
  position: relative;
  padding-top: 2rpx;
}

.creator-constellation__field {
  position: relative;
  width: 100%;
  height: 670rpx;
  border-radius: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 48%, rgba(218, 177, 98, 0.32), rgba(218, 177, 98, 0.18) 34%, rgba(218, 177, 98, 0.06) 58%, rgba(218, 177, 98, 0) 76%),
    radial-gradient(circle at 28% 24%, rgba(255, 250, 235, 0.5), rgba(255, 250, 235, 0) 34%),
    radial-gradient(circle at 74% 76%, rgba(148, 92, 48, 0.08), rgba(148, 92, 48, 0) 36%);
  box-shadow: none;
}

.creator-constellation__field::before,
.creator-constellation__field::after {
  position: absolute;
  z-index: 2;
  pointer-events: none;
  content: "";
}

.creator-constellation__field::before {
  top: 0;
  right: 0;
  left: 0;
  height: 100%;
  background:
    linear-gradient(180deg, #F2E6C9 0%, rgba(242, 230, 201, 0) 13%, rgba(242, 230, 201, 0) 86%, #F2E6C9 100%),
    linear-gradient(90deg, #F2E6C9 0%, rgba(242, 230, 201, 0) 9%, rgba(242, 230, 201, 0) 91%, #F2E6C9 100%);
}

.creator-constellation__field::after {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    radial-gradient(circle at 50% 50%, rgba(153, 57, 33, 0) 0%, rgba(153, 57, 33, 0) 46%, rgba(128, 86, 42, 0.055) 78%, rgba(128, 86, 42, 0) 100%);
}

.creator-constellation__plate {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  will-change: transform;
}

.creator-constellation__item {
  position: absolute;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 250, 243, 0.96);
  overflow: hidden;
  background: #ead9b7;
  box-shadow:
    0 12rpx 22rpx rgba(54, 48, 38, 0.12),
    inset 0 0 0 1rpx rgba(153, 57, 33, 0.08);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.creator-constellation__item--pressed {
  transform: scale(0.94);
  box-shadow:
    0 8rpx 18rpx rgba(72, 48, 27, 0.1),
    inset 0 0 0 1rpx rgba(153, 57, 33, 0.12);
}

.creator-constellation__avatar {
  display: block;
  width: 100%;
  height: 100%;
}

.creator-constellation__fallback {
  display: -webkit-box;
  overflow: hidden;
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 1.28;
  text-align: center;
  color: #7c4428;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

