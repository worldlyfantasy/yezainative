.home-page {
  padding-bottom: 80rpx;
}

.hero {
  position: relative;
  height: 820rpx;
  overflow: hidden;
}

.hero__transition {
  width: 100%;
  background: #ede2c8;
}

.hero__transition-fade {
  width: 100%;
  height: 34rpx;
  background: linear-gradient(180deg, rgba(32, 23, 17, 0.12) 0%, rgba(32, 23, 17, 0.04) 56%, rgba(32, 23, 17, 0) 100%);
}

.hero__swiper,
.hero__slide {
  width: 100%;
  height: 100%;
}

.hero__slide {
  background: #e7dece;
}

.hero__image,
.hero__mask,
.hero__art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero__mask {
  background: linear-gradient(180deg, rgba(21, 15, 11, 0.08), rgba(21, 15, 11, 0.3) 82%);
}

.hero__slide--muted .hero__image {
  opacity: 1;
}

.hero__slide--muted .hero__mask {
  background:
    linear-gradient(180deg, rgba(255, 251, 243, 0.03), rgba(247, 235, 211, 0.08) 46%, rgba(121, 78, 43, 0.05) 100%),
    linear-gradient(90deg, rgba(255, 248, 234, 0.03), rgba(255, 248, 234, 0));
}

.hero__mask--art {
  background:
    linear-gradient(180deg, rgba(255, 252, 244, 0.06), rgba(58, 34, 18, 0.18) 76%),
    linear-gradient(90deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0));
}

.hero__art {
  background:
    linear-gradient(180deg, #f2ead7 0%, #ece3d4 58%, #ede6da 100%);
}

.hero__art-band {
  position: absolute;
  left: -8%;
  width: 116%;
  border-radius: 999rpx;
  transform: rotate(-6deg);
}

.hero__art-band--top {
  top: -40rpx;
  height: 260rpx;
  background:
    linear-gradient(180deg, rgba(241, 208, 108, 0.94), rgba(233, 187, 80, 0.9));
}

.hero__art-band--middle {
  top: 300rpx;
  left: 40%;
  width: 92%;
  height: 300rpx;
  background:
    linear-gradient(180deg, rgba(198, 189, 176, 0.46), rgba(215, 206, 193, 0.64));
  transform: rotate(-10deg);
}

.hero__art-band--bottom {
  right: -12%;
  bottom: -120rpx;
  left: auto;
  width: 78%;
  height: 240rpx;
  background:
    linear-gradient(180deg, rgba(206, 124, 69, 0.9), rgba(170, 86, 40, 0.94));
  transform: rotate(-10deg);
}

.hero__art-logo {
  position: absolute;
  top: 116rpx;
  left: 58rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 120rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #9e3820;
  transform: rotate(-14deg);
}

.hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  padding: 72rpx 44rpx;
}

.hero__mark {
  display: block;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(242, 230, 201, 0.92);
}

.hero__title {
  margin-top: 18rpx;
  max-width: 560rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 68rpx;
  line-height: 1.52;
  font-weight: 500;
  color: #F2E6C9;
}

.hero__desc {
  display: block;
  margin-top: 22rpx;
  max-width: 520rpx;
  font-size: 28rpx;
  line-height: 1.95;
  color: rgba(242, 230, 201, 0.86);
}

.hero__slide--art .hero__mark {
  color: rgba(123, 53, 24, 0.72);
}

.hero__slide--art .hero__title {
  color: #3b2a1f;
}

.hero__slide--art .hero__desc {
  color: rgba(70, 52, 41, 0.9);
}

.hero__desc--secondary {
  margin-top: 6rpx;
}

.home-note {
  padding-top: 10rpx;
  padding-bottom: 46rpx;
}

.home-note__text {
  display: block;
  font-family: "OPPOSans", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 0.4rpx;
  text-align: center;
  color: #5f5750;
}

.home-page .section-block {
  margin-top: 0;
}

.section-head--trip {
  margin-bottom: 26rpx;
}

.trip-scroll {
  width: 100%;
}

.trip-scroll__track {
  display: flex;
  gap: 20rpx;
  width: max-content;
  padding-right: 20rpx;
}

.trip-card {
  width: 540rpx;
  height: 626rpx;
  padding-top: 18rpx;
  padding-bottom: 16rpx;
  border: none;
  border-radius: 18rpx;
  background: #fbf7ec;
  box-shadow:
    0 4rpx 10rpx rgba(82, 62, 40, 0.08),
    0 14rpx 28rpx rgba(82, 62, 40, 0.06);
  box-sizing: border-box;
}

.trip-card__cover-wrap {
  position: relative;
  width: 502rpx;
  height: 502rpx;
  margin: 0 auto;
  border-radius: 18rpx;
  overflow: hidden;
}

.trip-card__cover {
  width: 100%;
  height: 100%;
  display: block;
}

.trip-card__mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  background: linear-gradient(180deg, rgba(23, 17, 13, 0) 0%, rgba(23, 17, 13, 0.82) 100%);
}

.trip-card__cover-meta {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  left: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.trip-card__title {
  flex: 1;
  min-width: 0;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.22;
  color: #f6f2e8;
}

.trip-card__price {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.25;
  color: rgba(246, 242, 232, 0.94);
}

.trip-card__summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  width: 502rpx;
  margin: 18rpx auto 0;
  min-height: 72rpx;
  font-family: "OPPOSans", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.58;
  letter-spacing: 0.4rpx;
  text-align: left;
  color: #7f776d;
}

.service-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
}

.service-tabs--top {
  margin-bottom: 24rpx;
}

.service-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 158rpx;
  height: 52rpx;
  min-width: 158rpx;
  padding: 0;
  border: 2rpx solid #d8b893;
  border-radius: 26rpx;
  font-family: "OPPOSans Medium", "OPPOSans", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 500;
  text-align: center;
  color: #fff8ee;
  background: #d9b77d;
  box-sizing: border-box;
}

.service-tab--active {
  color: #fff8ee;
  border-color: #c76334;
  background: #c76334;
}

.home-section-divider {
  display: block;
  width: 100%;
}

.divider--mountain {
  margin: 40rpx 0 100rpx;
}

.divider--human {
  margin: 100rpx 0 120rpx;
}

.divider--pack {
  margin: 80rpx 0 120rpx;
}

/* 首页文案字体统一：标题 Songti，说明 OPPOSans */
.home-page .creator-card__name {
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.home-page .creator-card__stance {
  font-family: "OPPOSans", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  font-weight: 400;
}

.home-page .idea-card__title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.home-page .idea-card__summary {
  font-family: "OPPOSans", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  font-weight: 400;
}

.home-page .idea-card__author {
  font-family: "OPPOSans", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  font-weight: 500;
}
