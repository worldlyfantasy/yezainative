<view class="journey-page">
  <view class="page-shell journey-page__shell">
    <view class="journey-head">
      <text class="page-eyebrow journey-head__title">旅程档案</text>
    </view>
    <text class="page-subtitle journey-page__subtitle">每一段旅途，都有专属的季节、节奏与在地温度。\n愿你在这里，找到想要奔赴的土地和靠近的人。</text>

    <view class="journey-tool-row">
      <view class="journey-date-trigger" bindtap="openRegionSheet" hover-class="journey-date-trigger--pressed">
        <view class="journey-date-trigger__icon">
          <view class="journey-date-trigger__pin">
            <view class="journey-date-trigger__pin-core"></view>
          </view>
        </view>
        <text class="journey-date-trigger__label">{{selectedDestinationRegionLabel || '路线区域'}}</text>
        <view
          wx:if="{{selectedDestinationRegionCode}}"
          class="journey-date-trigger__clear"
          catchtap="clearDestinationRegionFilter"
        >×</view>
      </view>

      <view class="journey-date-trigger" bindtap="openDateSheet" hover-class="journey-date-trigger--pressed">
        <view class="journey-date-trigger__icon">
          <view class="journey-date-trigger__clock">
            <view class="journey-date-trigger__hand journey-date-trigger__hand--hour"></view>
            <view class="journey-date-trigger__hand journey-date-trigger__hand--minute"></view>
          </view>
        </view>
        <text class="journey-date-trigger__label">出行时间</text>
      </view>
    </view>

    <view class="journey-filter-stack-anchor">
      <view class="journey-filter-stack">
        <view wx:if="{{visibleRouteTypeOptions.length}}" class="journey-type-panel">
          <scroll-view class="journey-type-panel__scroll" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="journey-type-panel__track">
              <view
                wx:for="{{visibleRouteTypeOptions}}"
                wx:key="key"
                class="journey-type-panel__item {{item.available ? 'journey-type-panel__item--available' : 'journey-type-panel__item--unavailable'}} {{item.selected ? 'journey-type-panel__item--selected' : ''}}"
                data-value="{{item.key}}"
                bindtap="onRouteTypeTap"
              >
                <view class="journey-type-panel__icon-shell">
                  <image
                    wx:if="{{item.icon}}"
                    class="journey-type-panel__icon"
                    src="{{item.selected ? item.selectedIcon : item.icon}}"
                    mode="aspectFit"
                    lazy-load="{{true}}"
                  ></image>
                  <text wx:else class="journey-type-panel__icon-fallback">{{item.shortLabel}}</text>
                </view>
                <text class="journey-type-panel__label">{{item.label}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="journey-status-row">
          <scroll-view class="journey-status-bar" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view class="journey-status-bar__track">
              <view
                wx:for="{{statusOptions}}"
                wx:key="key"
                class="journey-status-bar__item {{item.active ? 'journey-status-bar__item--active' : ''}}"
                data-status="{{item.key}}"
                bindtap="onStatusTap"
                hover-class="journey-status-bar__item--pressed"
              >{{item.label}}</view>
            </view>
          </scroll-view>
          <text
            wx:if="{{selectedFilterChips.length}}"
            class="journey-status-row__clear"
            bindtap="clearAllFilters"
          >清空筛选</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showFloatingFilters}}" class="journey-filter-stack journey-filter-stack--floating">
      <view wx:if="{{visibleRouteTypeOptions.length}}" class="journey-type-panel">
        <scroll-view class="journey-type-panel__scroll" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="journey-type-panel__track">
            <view
              wx:for="{{visibleRouteTypeOptions}}"
              wx:key="key"
              class="journey-type-panel__item {{item.available ? 'journey-type-panel__item--available' : 'journey-type-panel__item--unavailable'}} {{item.selected ? 'journey-type-panel__item--selected' : ''}}"
              data-value="{{item.key}}"
              bindtap="onRouteTypeTap"
            >
              <view class="journey-type-panel__icon-shell">
                <image
                  wx:if="{{item.icon}}"
                  class="journey-type-panel__icon"
                  src="{{item.selected ? item.selectedIcon : item.icon}}"
                  mode="aspectFit"
                  lazy-load="{{true}}"
                ></image>
                <text wx:else class="journey-type-panel__icon-fallback">{{item.shortLabel}}</text>
              </view>
              <text class="journey-type-panel__label">{{item.label}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="journey-status-row">
        <scroll-view class="journey-status-bar" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="journey-status-bar__track">
            <view
              wx:for="{{statusOptions}}"
              wx:key="key"
              class="journey-status-bar__item {{item.active ? 'journey-status-bar__item--active' : ''}}"
              data-status="{{item.key}}"
              bindtap="onStatusTap"
              hover-class="journey-status-bar__item--pressed"
            >{{item.label}}</view>
          </view>
        </scroll-view>
        <text
          wx:if="{{selectedFilterChips.length}}"
          class="journey-status-row__clear"
          bindtap="clearAllFilters"
        >清空筛选</text>
      </view>
    </view>

    <view class="journey-result-head">
      <text class="journey-result-head__count">{{resultCountText}}</text>
      <view class="journey-view-switch">
        <view
          class="journey-view-switch__item {{journeyViewMode === 'grid' ? 'journey-view-switch__item--active' : ''}}"
          data-mode="grid"
          bindtap="onJourneyViewModeTap"
          hover-class="journey-view-switch__item--pressed"
        >
          <view class="journey-view-switch__icon journey-view-switch__icon--grid">
            <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="journey-view-switch__grid-cell"></view>
          </view>
        </view>
        <view
          class="journey-view-switch__item {{journeyViewMode === 'image' ? 'journey-view-switch__item--active' : ''}}"
          data-mode="image"
          bindtap="onJourneyViewModeTap"
          hover-class="journey-view-switch__item--pressed"
        >
          <view class="journey-view-switch__icon journey-view-switch__icon--image">
            <view class="journey-view-switch__image-cover"></view>
            <view class="journey-view-switch__image-line journey-view-switch__image-line--long"></view>
            <view class="journey-view-switch__image-line journey-view-switch__image-line--short"></view>
          </view>
        </view>
        <view
          class="journey-view-switch__item {{journeyViewMode === 'compact' ? 'journey-view-switch__item--active' : ''}}"
          data-mode="compact"
          bindtap="onJourneyViewModeTap"
          hover-class="journey-view-switch__item--pressed"
        >
          <view class="journey-view-switch__icon journey-view-switch__icon--compact">
            <view wx:for="{{[1,2,3]}}" wx:key="*this" class="journey-view-switch__compact-row">
              <view class="journey-view-switch__compact-thumb"></view>
              <view class="journey-view-switch__compact-line"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{errorText}}" class="paper-block page-feedback journey-page__feedback">
      <text class="page-feedback__title">加载失败</text>
      <text class="page-feedback__desc">{{errorText}}</text>
      <view class="journey-page__feedback-actions">
        <button class="primary-button journey-page__feedback-button" bindtap="retryLoadJourneyData">重新加载</button>
        <button
          wx:if="{{selectedFilterChips.length}}"
          class="outline-button journey-page__feedback-button"
          bindtap="clearAllFilters"
        >清空筛选</button>
      </view>
    </view>

    <view wx:elif="{{loading}}" class="journey-loading">
      <view wx:for="{{[1,2]}}" wx:key="*this" class="journey-loading__card">
        <view class="journey-loading__cover"></view>
        <view class="journey-loading__body">
          <view class="journey-loading__line journey-loading__line--title"></view>
          <view class="journey-loading__line journey-loading__line--meta"></view>
          <view class="journey-loading__line journey-loading__line--short"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{displayJourneys.length}}" class="journey-list {{journeyViewMode === 'grid' ? 'journey-list--grid' : ''}}">
      <view wx:if="{{journeyViewMode === 'grid'}}" class="journey-masonry">
        <view wx:for="{{displayJourneyColumns}}" wx:for-item="column" wx:key="key" class="journey-masonry__column">
          <view
            class="journey-list__card"
            wx:for="{{column.items}}"
            wx:for-item="journey"
            wx:for-index="journeyIndex"
            wx:key="slug"
          >
            <journey-route-card
              journey="{{journey}}"
              variant="grid"
              bind:cardtap="onJourneyTap"
              bind:departuretap="onJourneyDepartureTap"
              bind:summarytoggle="onJourneySummaryToggle"
            ></journey-route-card>
          </view>
        </view>
      </view>
      <block wx:else>
        <view
          class="journey-list__card"
          wx:for="{{displayJourneys}}"
          wx:key="slug"
        >
          <journey-route-card
            journey="{{item}}"
            compact="{{journeyViewMode === 'compact'}}"
            variant="{{journeyViewMode}}"
            bind:cardtap="onJourneyTap"
            bind:departuretap="onJourneyDepartureTap"
            bind:summarytoggle="onJourneySummaryToggle"
          ></journey-route-card>
        </view>
      </block>
      <view class="journey-list__footer">
        <text wx:if="{{renderedCountText}}" class="journey-list__footer-text">{{renderedCountText}}</text>
        <button
          wx:if="{{hasMoreJourneys}}"
          class="outline-button journey-list__footer-button"
          bindtap="onLoadMoreTap"
        >继续加载</button>
      </view>
    </view>

    <view wx:else class="journey-empty">
      <text class="journey-empty__title">{{emptyStateTitle}}</text>
      <text class="journey-empty__desc">{{emptyStateDescPrimary}}</text>
      <text wx:if="{{emptyStateDescSecondary}}" class="journey-empty__desc">{{emptyStateDescSecondary}}</text>
      <view class="journey-empty__actions">
        <button wx:if="{{showEmptyClearRegionAction}}" class="outline-button journey-empty__button" bindtap="clearDestinationRegionFilter">清空区域</button>
        <button wx:else class="outline-button journey-empty__button" bindtap="clearAllFilters">清空筛选</button>
      </view>
    </view>
  </view>

  <view wx:if="{{isRegionSheetVisible}}" class="journey-date-sheet journey-region-sheet">
    <view class="journey-date-sheet__backdrop" bindtap="closeRegionSheet"></view>
    <view class="journey-date-sheet__panel journey-region-sheet__panel {{isRegionSheetAnimating ? 'journey-date-sheet__panel--active' : ''}}">
      <view class="journey-date-sheet__header journey-date-sheet__header--region">
        <view class="journey-region-tabs">
          <view
            wx:for="{{regionScopeTabs}}"
            wx:key="key"
            class="journey-region-tabs__item {{item.active ? 'journey-region-tabs__item--active' : ''}}"
            data-scope="{{item.key}}"
            bindtap="onRegionScopeTabTap"
            hover-class="journey-region-tabs__item--pressed"
          >{{item.label}}</view>
        </view>
        <view class="journey-date-sheet__close journey-region-sheet__close journey-control" bindtap="closeRegionSheet" hover-class="journey-control--pressed">×</view>
      </view>

      <scroll-view wx:if="{{regionSheetColumns.length}}" class="journey-region-sheet__scroll" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="journey-region-sheet__track">
          <view wx:for="{{regionSheetColumns}}" wx:key="index" class="journey-region-sheet__column">
            <view
              wx:for="{{item}}"
              wx:key="key"
              class="journey-region-card {{item.available ? 'journey-region-card--available' : 'journey-region-card--unavailable'}} {{item.selected ? 'journey-region-card--selected' : ''}}"
              data-region="{{item.value}}"
              bindtap="onRegionTap"
            >
              <image
                wx:if="{{item.image}}"
                class="journey-region-card__image"
                src="{{item.image}}"
                mode="aspectFill"
                lazy-load="{{true}}"
              ></image>
              <view wx:else class="journey-region-card__fallback"></view>
              <view class="journey-region-card__mask"></view>
              <view class="journey-region-card__content">
                <text class="journey-region-card__label">{{item.label}}</text>
                <text class="journey-region-card__meta">{{item.countText}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:else class="journey-region-sheet__empty">
        <text class="journey-region-sheet__empty-text">当前筛选下还没有可选区域。</text>
      </view>
    </view>
  </view>

  <view wx:if="{{isDateSheetVisible}}" class="journey-date-sheet">
    <view class="journey-date-sheet__backdrop" bindtap="closeDateSheet"></view>
    <view class="journey-date-sheet__panel {{isDateSheetAnimating ? 'journey-date-sheet__panel--active' : ''}}">
      <view class="journey-date-sheet__header journey-date-sheet__header--compact">
        <view class="journey-date-sheet__close journey-control" bindtap="closeDateSheet" hover-class="journey-control--pressed">×</view>
      </view>

      <block wx:if="{{hasMarkedDates}}">
        <scroll-view class="journey-date-sheet__content" scroll-y="true" enhanced="{{true}}" show-scrollbar="{{false}}" enable-flex="{{true}}">
          <view class="journey-date-sheet__month-row">
            <text class="journey-date-sheet__month-action {{calendarMonthKeys.length <= 1 ? 'journey-date-sheet__month-action--disabled' : ''}}" bindtap="onPrevCalendarMonth">‹</text>
            <text class="journey-date-sheet__month-label">{{activeCalendarMonthLabel}}</text>
            <text class="journey-date-sheet__month-action {{calendarMonthKeys.length <= 1 ? 'journey-date-sheet__month-action--disabled' : ''}}" bindtap="onNextCalendarMonth">›</text>
          </view>

          <view class="journey-date-sheet__weekdays">
            <text wx:for="{{calendarWeekdayLabels}}" wx:key="*this" class="journey-date-sheet__weekday">{{item}}</text>
          </view>

          <view class="journey-date-sheet__calendar">
            <view wx:for="{{calendarWeeks}}" wx:key="index" class="journey-date-sheet__week">
              <view
                wx:for="{{item}}"
                wx:key="key"
                class="journey-date-sheet__day {{item.empty ? 'journey-date-sheet__day--empty' : ''}}"
                data-date="{{item.fullDate}}"
                bindtap="onCalendarDayTap"
              >
                <view class="journey-date-sheet__day-pill {{item.selected ? 'journey-date-sheet__day-pill--selected' : ''}}">
                  <text class="journey-date-sheet__day-label {{item.marked ? 'journey-date-sheet__day-label--marked' : ''}}">{{item.label}}</text>
                </view>
                <view wx:if="{{item.marked}}" class="journey-date-sheet__day-dot"></view>
              </view>
            </view>
          </view>

          <text wx:if="{{sheetHintText && sheetJourneys.length}}" class="journey-date-sheet__hint">{{sheetHintText}}</text>

          <view class="journey-date-sheet__list">
            <view wx:if="{{sheetJourneys.length}}" class="journey-date-sheet__list-inner">
              <journey-route-card
                wx:for="{{sheetJourneys}}"
                wx:key="slug"
                compact="{{true}}"
                journey="{{item}}"
                bind:cardtap="onJourneyTap"
              ></journey-route-card>
            </view>
            <view wx:else class="journey-date-sheet__empty">
              <text class="journey-date-sheet__empty-text">选一个有标记的日期，看看那天有哪些可报名的旅程。</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <view wx:else class="journey-date-sheet__empty-state">
        <text class="journey-date-sheet__empty-title">{{sheetEmptyTitle}}</text>
        <text class="journey-date-sheet__empty-desc">{{sheetEmptyDesc}}</text>
      </view>
    </view>
  </view>
</view>

<app-tab-bar wx:if="{{!isDateSheetVisible && !isRegionSheetVisible}}"></app-tab-bar>
