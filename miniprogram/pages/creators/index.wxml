<view class="page-shell">
  <text class="page-eyebrow">创作者档案</text>
  <text class="page-subtitle">他们有自己的节奏与价值观，我们负责透明呈现。选择所在土地或创作者类型，即可筛选合适的同行者。</text>

  <view class="section-block filter-shell creators-filter-shell">
    <view class="filter-item creator-filter-item">
      <text class="filter-label">创作者类型</text>
      <picker
        wx:if="{{styleLabels.length > 1}}"
        class="filter-picker-trigger"
        mode="selector"
        range="{{styleLabels}}"
        value="{{styleIndex}}"
        bindchange="onStyleChange"
      >
        <view class="filter-picker creator-filter-picker">{{styleLabels[styleIndex] || '全部'}}</view>
      </picker>
      <view wx:else class="filter-picker creator-filter-picker creator-filter-picker--static">全部</view>
    </view>
    <view class="filter-item creator-filter-item">
      <text class="filter-label">所在土地</text>
      <picker
        wx:if="{{destinationLabels.length > 1}}"
        class="filter-picker-trigger"
        mode="selector"
        range="{{destinationLabels}}"
        value="{{destinationIndex}}"
        bindchange="onDestinationChange"
      >
        <view class="filter-picker creator-filter-picker">{{destinationLabels[destinationIndex] || '全部'}}</view>
      </picker>
      <view wx:else class="filter-picker creator-filter-picker creator-filter-picker--static">全部</view>
    </view>
  </view>

  <view class="section-block">
    <view wx:if="{{errorText}}" class="paper-block page-feedback">
      <text class="page-feedback__title">加载失败</text>
      <text class="page-feedback__desc">{{errorText}}</text>
    </view>
    <view wx:elif="{{loading}}" class="empty-state">创作者列表加载中...</view>
    <view wx:elif="{{creators.length}}" class="card-stack">
      <creator-card wx:for="{{creators}}" wx:key="id" creator="{{item}}" bind:cardtap="onCreatorTap"></creator-card>
    </view>
    <view wx:else class="empty-state">暂无符合条件的创作者。</view>
  </view>
</view>

<app-tab-bar></app-tab-bar>
