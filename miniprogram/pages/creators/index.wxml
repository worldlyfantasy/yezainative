<view class="page-shell">
  <text class="page-eyebrow">创作者档案</text>
  <text class="page-subtitle">每一位创作者都有自己的节奏与热爱，我们负责把真实的TA们完整呈现给你。</text>

  <view class="creator-tool-row">
    <view class="creator-filter-trigger" bindtap="openStyleSheet" hover-class="creator-filter-trigger--pressed">
      <view class="creator-filter-trigger__icon">
        <image
          wx:if="{{selectedStyleIcon}}"
          class="creator-filter-trigger__style-icon"
          src="{{selectedStyleIcon}}"
          mode="aspectFit"
        ></image>
        <view wx:else class="creator-filter-trigger__route-dots">
          <view wx:for="{{routeTriggerDots}}" wx:key="*this" class="creator-filter-trigger__route-dot"></view>
        </view>
      </view>
      <text class="creator-filter-trigger__label">{{selectedStyleLabel || '路线标签'}}</text>
      <view
        wx:if="{{selectedStyle}}"
        class="creator-filter-trigger__clear"
        catchtap="clearSelectedStyle"
      >×</view>
    </view>

    <view class="creator-filter-trigger" bindtap="openRegionSheet" hover-class="creator-filter-trigger--pressed">
      <view class="creator-filter-trigger__icon">
        <view class="creator-filter-trigger__pin">
          <view class="creator-filter-trigger__pin-core"></view>
        </view>
      </view>
      <text class="creator-filter-trigger__label">{{selectedRegionLabel || '路线区域'}}</text>
      <view
        wx:if="{{selectedRegionCode}}"
        class="creator-filter-trigger__clear"
        catchtap="clearSelectedRegion"
      >×</view>
    </view>
  </view>

  <view class="creator-result-head">
    <text class="creator-result-head__count">共 {{creators.length}} 位创作者</text>
    <view class="creator-view-switch">
      <view
        class="creator-view-switch__item {{creatorViewMode === 'grid' ? 'creator-view-switch__item--active' : ''}}"
        data-mode="grid"
        bindtap="onCreatorViewModeTap"
        hover-class="creator-view-switch__item--pressed"
      >
        <view class="creator-view-switch__icon creator-view-switch__icon--grid">
          <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="creator-view-switch__grid-cell"></view>
        </view>
      </view>
      <view
        class="creator-view-switch__item {{creatorViewMode === 'card' ? 'creator-view-switch__item--active' : ''}}"
        data-mode="card"
        bindtap="onCreatorViewModeTap"
        hover-class="creator-view-switch__item--pressed"
      >
        <view class="creator-view-switch__icon creator-view-switch__icon--list">
          <view wx:for="{{[1,2,3]}}" wx:key="*this" class="creator-view-switch__list-row">
            <view class="creator-view-switch__list-thumb"></view>
            <view class="creator-view-switch__list-line"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section-block">
    <view wx:if="{{errorText}}" class="paper-block page-feedback">
      <text class="page-feedback__title">加载失败</text>
      <text class="page-feedback__desc">{{errorText}}</text>
    </view>
    <view wx:elif="{{loading}}" class="empty-state">创作者列表加载中...</view>
    <view wx:elif="{{creators.length}}" class="{{creatorViewMode === 'grid' ? 'creator-grid' : 'creator-list'}}">
      <creator-card
        wx:for="{{creators}}"
        wx:key="id"
        creator="{{item}}"
        variant="{{creatorViewMode}}"
        bind:cardtap="onCreatorTap"
      ></creator-card>
    </view>
    <view wx:else class="empty-state">暂无符合条件的创作者。</view>
  </view>
</view>

<view wx:if="{{isStyleSheetVisible}}" class="creator-sheet">
  <view class="creator-sheet__backdrop" bindtap="closeStyleSheet"></view>
  <view class="creator-sheet__panel creator-sheet__panel--tags {{isStyleSheetAnimating ? 'creator-sheet__panel--active' : ''}}">
    <view class="creator-sheet__header creator-sheet__header--compact">
      <view class="creator-sheet__close" bindtap="closeStyleSheet" hover-class="creator-sheet__close--pressed">×</view>
    </view>

    <view class="creator-tag-grid">
      <view
        wx:for="{{visibleStyleOptions}}"
        wx:key="key"
        class="creator-tag-card {{item.available ? 'creator-tag-card--available' : 'creator-tag-card--unavailable'}} {{item.selected ? 'creator-tag-card--selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="onStyleTap"
      >
        <view class="creator-tag-card__icon-shell">
          <image
            wx:if="{{item.icon}}"
            class="creator-tag-card__icon"
            src="{{item.selected ? item.selectedIcon : item.icon}}"
            mode="aspectFit"
            lazy-load="{{true}}"
          ></image>
        </view>
        <text class="creator-tag-card__label">{{item.label}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{isRegionSheetVisible}}" class="creator-sheet">
  <view class="creator-sheet__backdrop" bindtap="closeRegionSheet"></view>
  <view class="creator-sheet__panel creator-sheet__panel--region {{isRegionSheetAnimating ? 'creator-sheet__panel--active' : ''}}">
    <view class="creator-sheet__header creator-sheet__header--region">
      <view class="creator-region-tabs">
        <view
          wx:for="{{regionScopeTabs}}"
          wx:key="key"
          class="creator-region-tabs__item {{item.active ? 'creator-region-tabs__item--active' : ''}}"
          data-scope="{{item.key}}"
          bindtap="onRegionScopeTabTap"
          hover-class="creator-region-tabs__item--pressed"
        >{{item.label}}</view>
      </view>
      <view class="creator-sheet__close creator-region-sheet__close" bindtap="closeRegionSheet" hover-class="creator-sheet__close--pressed">×</view>
    </view>

    <scroll-view wx:if="{{regionSheetColumns.length}}" class="creator-region-sheet__scroll" scroll-x="true" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="creator-region-sheet__track">
        <view wx:for="{{regionSheetColumns}}" wx:key="index" class="creator-region-sheet__column">
          <view
            wx:for="{{item}}"
            wx:key="key"
            class="creator-region-card {{item.available ? 'creator-region-card--available' : 'creator-region-card--unavailable'}} {{item.selected ? 'creator-region-card--selected' : ''}}"
            data-region="{{item.value}}"
            bindtap="onRegionTap"
          >
            <image
              wx:if="{{item.image}}"
              class="creator-region-card__image"
              src="{{item.image}}"
              mode="aspectFill"
              lazy-load="{{true}}"
            ></image>
            <view wx:else class="creator-region-card__fallback"></view>
            <view class="creator-region-card__mask"></view>
            <view class="creator-region-card__content">
              <text class="creator-region-card__label">{{item.label}}</text>
              <text class="creator-region-card__meta">{{item.countText}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="creator-sheet__empty">
      <text class="creator-sheet__empty-text">当前筛选下还没有可选区域。</text>
    </view>
  </view>
</view>

<app-tab-bar wx:if="{{!isStyleSheetVisible && !isRegionSheetVisible}}"></app-tab-bar>
