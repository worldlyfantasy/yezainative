.page-shell {
  padding-bottom: 196rpx;
}

.creator-tool-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 28rpx;
}

.creator-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(153, 57, 33, 0.12);
}

.creator-result-head__count {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 30rpx;
  line-height: 1.7;
  color: #5d5042;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator-view-switch {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 242, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(153, 57, 33, 0.1);
}

.creator-view-switch__item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #7a6958;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out, background 0.18s ease-out, color 0.18s ease-out;
}

.creator-view-switch__item--pressed {
  opacity: 0.84;
  transform: scale(0.96);
}

.creator-view-switch__item--active {
  color: #fff5ee;
  font-weight: 600;
  background: #D15E14;
  box-shadow: 0 8rpx 16rpx rgba(209, 94, 20, 0.16);
}

.creator-view-switch__icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
}

.creator-view-switch__icon--list {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.creator-view-switch__list-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 6rpx;
}

.creator-view-switch__list-thumb {
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.creator-view-switch__list-line {
  flex: 1;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.creator-view-switch__icon--grid {
  display: grid;
  grid-template-columns: repeat(2, 11rpx);
  grid-template-rows: repeat(2, 11rpx);
  gap: 6rpx;
}

.creator-view-switch__grid-cell {
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.creator-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 18rpx;
}

.creator-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.creator-filter-trigger {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-height: 92rpx;
  padding: 0 26rpx 0 22rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 249, 242, 0.44);
  box-sizing: border-box;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.creator-filter-trigger--pressed {
  opacity: 0.82;
  transform: scale(0.99);
}

.creator-filter-trigger__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(153, 57, 33, 0.06);
}

.creator-filter-trigger__label {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.7;
  color: #2b241d;
}

.creator-filter-trigger__clear {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(153, 57, 33, 0.1);
  font-size: 28rpx;
  line-height: 1;
  color: #993921;
}

.creator-filter-trigger__route-dots {
  display: grid;
  grid-template-columns: repeat(2, 10rpx);
  gap: 6rpx;
}

.creator-filter-trigger__style-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.72;
}

.creator-filter-trigger__route-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #993921;
}

.creator-filter-trigger__pin {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #993921;
  border-radius: 50% 50% 50% 0;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.creator-filter-trigger__pin-core {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #993921;
}

.creator-sheet {
  position: fixed;
  inset: 0;
  z-index: 60;
}

.creator-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.3);
}

.creator-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 34rpx 34rpx calc(env(safe-area-inset-bottom) + 26rpx);
  border-radius: 40rpx 40rpx 0 0;
  background:
    linear-gradient(180deg, #FFF9F2 0%, #F9F4EC 72%, #F2E6C9 100%);
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.24s ease-out;
}

.creator-sheet__panel--tags {
  min-height: 48vh;
}

.creator-sheet__panel--region {
  display: flex;
  flex-direction: column;
  height: 58vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 36rpx);
}

.creator-sheet__panel--active {
  transform: translateY(0);
}

.creator-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.creator-sheet__header--compact {
  justify-content: flex-end;
}

.creator-sheet__header--region {
  justify-content: space-between;
  gap: 24rpx;
}

.creator-sheet__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(153, 57, 33, 0.12);
  font-size: 44rpx;
  color: #5f5041;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.creator-sheet__close--pressed {
  opacity: 0.82;
  transform: scale(0.97);
}

.creator-region-sheet__close {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  font-size: 36rpx;
  color: #6a5a49;
  box-shadow: inset 0 0 0 2rpx rgba(153, 57, 33, 0.1);
}

.creator-tag-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx 14rpx;
  margin-top: 22rpx;
}

.creator-tag-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  min-height: 174rpx;
  padding: 8rpx 6rpx 10rpx;
  transition: transform 0.18s ease-out;
}

.creator-tag-card--selected {
  transform: translateY(-4rpx);
}

.creator-tag-card__icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 249, 242, 0.48);
  box-shadow:
    inset 0 0 0 2rpx rgba(138, 117, 99, 0.14);
  transition: background 0.18s ease-out, box-shadow 0.18s ease-out, transform 0.18s ease-out;
}

.creator-tag-card--available .creator-tag-card__icon-shell {
  background: rgba(209, 94, 20, 0.22);
  box-shadow:
    0 8rpx 16rpx rgba(153, 57, 33, 0.06),
    inset 0 0 0 1rpx rgba(209, 94, 20, 0.12);
}

.creator-tag-card--unavailable .creator-tag-card__icon-shell {
  background: rgba(255, 249, 242, 0.32);
  box-shadow:
    inset 0 0 0 2rpx rgba(138, 117, 99, 0.1);
}

.creator-tag-card--selected .creator-tag-card__icon-shell {
  box-shadow:
    0 16rpx 26rpx rgba(84, 57, 31, 0.1),
    inset 0 0 0 2rpx rgba(255, 249, 242, 0.42);
  transform: scale(1.04);
}

.creator-tag-card--selected .creator-tag-card__icon-shell,
.creator-tag-card--selected.creator-tag-card--available .creator-tag-card__icon-shell {
  background: #D15E14;
  box-shadow:
    0 16rpx 28rpx rgba(209, 94, 20, 0.26),
    inset 0 0 0 2rpx rgba(255, 249, 242, 0.38);
}

.creator-tag-card__icon {
  width: 54rpx;
  height: 54rpx;
  opacity: 0.2;
  transition: opacity 0.18s ease-out;
}

.creator-tag-card--available .creator-tag-card__icon {
  opacity: 0.58;
}

.creator-tag-card--selected .creator-tag-card__icon,
.creator-tag-card--selected.creator-tag-card--available .creator-tag-card__icon {
  opacity: 1;
}

.creator-tag-card__label {
  text-align: center;
  font-size: 22rpx;
  line-height: 1.55;
  color: rgba(138, 117, 99, 0.58);
  white-space: normal;
  transition: color 0.18s ease-out, font-weight 0.18s ease-out;
}

.creator-tag-card--available .creator-tag-card__label {
  color: #a3542f;
  font-weight: 500;
}

.creator-tag-card--selected.creator-tag-card--available .creator-tag-card__label {
  color: #D15E14;
  font-weight: 600;
}

.creator-region-tabs {
  display: inline-flex;
  align-self: flex-start;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 242, 0.8);
  box-shadow: inset 0 0 0 1rpx rgba(153, 57, 33, 0.1);
}

.creator-region-tabs__item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #7a6958;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out, background 0.18s ease-out, color 0.18s ease-out;
}

.creator-region-tabs__item--pressed {
  opacity: 0.84;
  transform: scale(0.96);
}

.creator-region-tabs__item--active {
  color: #fff5ee;
  font-weight: 600;
  background: #D15E14;
  box-shadow: 0 8rpx 16rpx rgba(209, 94, 20, 0.16);
}

.creator-region-sheet__scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 44rpx);
}

.creator-region-sheet__track {
  display: inline-flex;
  align-items: stretch;
  gap: 20rpx;
  min-width: 100%;
  padding-right: 34rpx;
}

.creator-region-sheet__column {
  display: inline-flex;
  flex-direction: column;
  gap: 20rpx;
  width: 284rpx;
}

.creator-region-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  min-height: 224rpx;
  background: linear-gradient(180deg, rgba(199, 180, 149, 0.46), rgba(154, 121, 83, 0.72));
  transition: transform 0.18s ease-out, opacity 0.18s ease-out, box-shadow 0.18s ease-out;
}

.creator-region-card--available {
  box-shadow: 0 18rpx 30rpx rgba(84, 57, 31, 0.12);
}

.creator-region-card--selected {
  transform: translateY(-4rpx);
  box-shadow:
    0 22rpx 36rpx rgba(84, 57, 31, 0.16),
    0 0 0 3rpx rgba(255, 246, 236, 0.72) inset;
}

.creator-region-card--unavailable {
  opacity: 0.52;
}

.creator-region-card__image,
.creator-region-card__fallback,
.creator-region-card__mask {
  position: absolute;
  inset: 0;
}

.creator-region-card__image {
  width: 100%;
  height: 100%;
}

.creator-region-card__fallback {
  background: linear-gradient(180deg, rgba(219, 198, 164, 0.82), rgba(146, 113, 75, 0.86));
}

.creator-region-card__mask {
  background: linear-gradient(180deg, rgba(43, 36, 29, 0.06), rgba(43, 36, 29, 0.56));
}

.creator-region-card__content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 24rpx 28rpx;
}

.creator-region-card__label {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 38rpx;
  line-height: 1.4;
  color: #fff7ef;
}

.creator-region-card__meta {
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 247, 239, 0.82);
}

.creator-sheet__empty {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx 20rpx;
}

.creator-sheet__empty-text {
  text-align: center;
  font-size: 28rpx;
  line-height: 1.8;
  color: #8f7c69;
}
