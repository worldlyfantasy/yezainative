.page-shell {
  padding-bottom: 196rpx;
}

.creator-tool-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 28rpx;
}

.creator-filter-trigger {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-height: 92rpx;
  padding: 0 26rpx 0 22rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 249, 242, 0.44);
  box-sizing: border-box;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.creator-filter-trigger--pressed {
  opacity: 0.82;
  transform: scale(0.99);
}

.creator-filter-trigger__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(153, 57, 33, 0.06);
}

.creator-filter-trigger__label {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.7;
  color: #2b241d;
}

.creator-filter-trigger__clear {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(153, 57, 33, 0.1);
  font-size: 28rpx;
  line-height: 1;
  color: #993921;
}

.creator-filter-trigger__route-dots {
  display: grid;
  grid-template-columns: repeat(2, 10rpx);
  gap: 6rpx;
}

.creator-filter-trigger__route-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #993921;
}

.creator-filter-trigger__pin {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #993921;
  border-radius: 50% 50% 50% 0;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.creator-filter-trigger__pin-core {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #993921;
}

.creator-sheet {
  position: fixed;
  inset: 0;
  z-index: 60;
}

.creator-sheet__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(43, 36, 29, 0.3);
}

.creator-sheet__panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 34rpx 34rpx calc(env(safe-area-inset-bottom) + 26rpx);
  border-radius: 40rpx 40rpx 0 0;
  background:
    linear-gradient(180deg, #FFF9F2 0%, #F9F4EC 72%, #F2E6C9 100%);
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.24s ease-out;
}

.creator-sheet__panel--tags {
  min-height: 48vh;
}

.creator-sheet__panel--region {
  display: flex;
  flex-direction: column;
  height: 64vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 22rpx);
}

.creator-sheet__panel--active {
  transform: translateY(0);
}

.creator-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.creator-sheet__header--compact {
  justify-content: flex-end;
}

.creator-sheet__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(153, 57, 33, 0.12);
  font-size: 44rpx;
  color: #5f5041;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.creator-sheet__close--pressed {
  opacity: 0.82;
  transform: scale(0.97);
}

.creator-tag-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx 14rpx;
  margin-top: 22rpx;
}

.creator-tag-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  min-height: 182rpx;
  padding: 8rpx 6rpx 10rpx;
  transition: transform 0.18s ease-out;
}

.creator-tag-card--selected {
  transform: translateY(-4rpx);
}

.creator-tag-card__icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(138, 117, 99, 0.44);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 249, 242, 0.28);
  transition: background 0.18s ease-out, box-shadow 0.18s ease-out;
}

.creator-tag-card--available .creator-tag-card__icon-shell {
  background: rgba(209, 94, 20, 0.92);
  box-shadow:
    0 10rpx 20rpx rgba(209, 94, 20, 0.12),
    inset 0 0 0 1rpx rgba(255, 249, 242, 0.18);
}

.creator-tag-card--selected .creator-tag-card__icon-shell {
  box-shadow:
    0 14rpx 24rpx rgba(84, 57, 31, 0.12),
    inset 0 0 0 2rpx rgba(255, 249, 242, 0.42);
}

.creator-tag-card--selected.creator-tag-card--available .creator-tag-card__icon-shell {
  background: #D15E14;
  box-shadow:
    0 14rpx 24rpx rgba(209, 94, 20, 0.18),
    inset 0 0 0 2rpx rgba(255, 249, 242, 0.38);
}

.creator-tag-card__icon {
  width: 54rpx;
  height: 54rpx;
}

.creator-tag-card__label {
  text-align: center;
  font-size: 22rpx;
  line-height: 1.55;
  color: #8a5a38;
}

.creator-tag-card--selected.creator-tag-card--available .creator-tag-card__label {
  color: #D15E14;
  font-weight: 600;
}

.creator-region-sheet__scroll {
  flex: 1;
  min-height: 0;
  margin-top: 16rpx;
  white-space: nowrap;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 22rpx);
}

.creator-region-sheet__track {
  display: inline-flex;
  align-items: stretch;
  gap: 20rpx;
  min-width: 100%;
  padding-right: 34rpx;
}

.creator-region-sheet__column {
  display: inline-flex;
  flex-direction: column;
  gap: 20rpx;
  width: 284rpx;
}

.creator-region-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  min-height: 224rpx;
  background: linear-gradient(180deg, rgba(199, 180, 149, 0.46), rgba(154, 121, 83, 0.72));
  transition: transform 0.18s ease-out, opacity 0.18s ease-out, box-shadow 0.18s ease-out;
}

.creator-region-card--available {
  box-shadow: 0 18rpx 30rpx rgba(84, 57, 31, 0.12);
}

.creator-region-card--selected {
  transform: translateY(-4rpx);
  box-shadow:
    0 22rpx 36rpx rgba(84, 57, 31, 0.16),
    0 0 0 3rpx rgba(255, 246, 236, 0.72) inset;
}

.creator-region-card--unavailable {
  opacity: 0.52;
}

.creator-region-card__image,
.creator-region-card__fallback,
.creator-region-card__mask {
  position: absolute;
  inset: 0;
}

.creator-region-card__image {
  width: 100%;
  height: 100%;
}

.creator-region-card__fallback {
  background: linear-gradient(180deg, rgba(219, 198, 164, 0.82), rgba(146, 113, 75, 0.86));
}

.creator-region-card__mask {
  background: linear-gradient(180deg, rgba(43, 36, 29, 0.06), rgba(43, 36, 29, 0.56));
}

.creator-region-card__content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 24rpx 28rpx;
}

.creator-region-card__label {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 38rpx;
  line-height: 1.4;
  color: #fff7ef;
}

.creator-region-card__meta {
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 247, 239, 0.82);
}

.creator-sheet__empty {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx 20rpx;
}

.creator-sheet__empty-text {
  text-align: center;
  font-size: 28rpx;
  line-height: 1.8;
  color: #8f7c69;
}
