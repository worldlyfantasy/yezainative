.journey-route-card {
  width: 100%;
}

.journey-route-card__plate {
  overflow: hidden;
  border-radius: 36rpx;
  background:
    linear-gradient(180deg, rgba(252, 246, 233, 0.96), rgba(247, 238, 219, 0.9));
  box-shadow:
    0 20rpx 40rpx rgba(84, 57, 31, 0.07),
    inset 0 0 0 1rpx rgba(153, 57, 33, 0.08);
}

.journey-route-card__cover-shell {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  margin: 18rpx 18rpx 0;
  max-height: 720rpx;
  padding-top: 0;
  border-radius: 30rpx;
  background: rgba(217, 205, 179, 0.5);
}

.journey-route-card__cover {
  position: static;
  display: block;
  width: 100%;
  height: auto;
  background: transparent;
}

.journey-route-card__cover--empty {
  min-height: 430rpx;
}

.journey-route-card__cover--empty,
.journey-route-card__thumb--empty {
  background:
    linear-gradient(135deg, rgba(209, 94, 20, 0.12), rgba(189, 154, 95, 0.06)),
    rgba(217, 205, 179, 0.6);
}

.journey-route-card__cover-badges {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12rpx;
}

.journey-route-card__duration-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  min-width: 74rpx;
  min-height: 42rpx;
  padding: 6rpx 13rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 19rpx;
  line-height: 1.4;
  font-weight: 600;
  white-space: nowrap;
  color: rgba(103, 77, 55, 0.84);
  background: rgba(246, 238, 220, 0.74);
  box-shadow: 0 2rpx 6rpx rgba(42, 29, 18, 0.08);
}

.journey-route-card__duration-pill--compact {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  min-width: 0;
  min-height: 32rpx;
  padding: 3rpx 9rpx;
  font-size: 17rpx;
  z-index: 2;
}

.journey-route-card__confirmed-corner {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 3;
  min-width: 104rpx;
  padding: 9rpx 18rpx 10rpx;
  border-radius: 0 30rpx 0 18rpx;
  background: rgba(209, 94, 20, 0.94);
  box-shadow: 0 4rpx 12rpx rgba(70, 36, 15, 0.2);
  color: #fff7ed;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
}

.journey-route-card__confirmed-corner--compact {
  min-width: 82rpx;
  padding: 5rpx 11rpx 6rpx;
  border-radius: 0 22rpx 0 14rpx;
  font-size: 18rpx;
}

.journey-route-card__route-wordmark {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  width: 140rpx;
  z-index: 2;
  pointer-events: none;
}

.journey-route-card__body {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 24rpx 26rpx 24rpx;
  text-align: center;
}

.journey-route-card__title,
.journey-route-card__compact-title {
  display: block;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  color: #2b241d;
  font-weight: 600;
}

.journey-route-card__title {
  font-size: 40rpx;
  line-height: 1.42;
}

.journey-route-card__creator-name {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.5;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: rgba(153, 57, 33, 0.72);
}

.journey-route-card__summary {
  display: block;
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.62;
  color: #5f5347;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.journey-route-card__summary--expanded {
  display: block;
  overflow: visible;
  -webkit-line-clamp: unset;
}

.journey-route-card__summary-measurer,
.journey-route-card__summary-line-probe {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: block;
  visibility: hidden;
  overflow: visible;
  pointer-events: none;
  z-index: -1;
  font-size: 26rpx;
  line-height: 1.62;
  color: transparent;
}

.journey-route-card__summary-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-height: 48rpx;
  margin-top: 10rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(153, 57, 33, 0.08);
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #993921;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.journey-route-card__summary-toggle--pressed {
  opacity: 0.82;
  transform: scale(0.96);
}

.journey-route-card__foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(153, 57, 33, 0.12);
}

.journey-route-card__departure {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: flex-start;
  padding: 6rpx 0;
  border-radius: 20rpx;
  transition: opacity 0.18s ease-out, transform 0.18s ease-out;
}

.journey-route-card__departure--pressed {
  opacity: 0.84;
  transform: scale(0.98);
}

.journey-route-card__departure-label {
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  color: #993921;
}

.journey-route-card__departure-date {
  font-size: 31rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #2b241d;
}

.journey-route-card__price,
.journey-route-card__compact-price {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-weight: 700;
  color: #D15E14;
}

.journey-route-card__price {
  font-size: 38rpx;
  line-height: 1.12;
}

.journey-route-card__custom-action {
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #2b241d;
}

.journey-route-card__price--custom-example {
  max-width: 58%;
  text-align: right;
  font-size: 34rpx;
  line-height: 1.18;
}

.journey-route-card--compact .journey-route-card__plate {
  background: transparent;
  box-shadow: none;
}

.journey-route-card--compact {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(245, 236, 218, 0.82);
  box-shadow: inset 0 0 0 1rpx rgba(153, 57, 33, 0.08);
}

.journey-route-card__thumb-shell {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  flex: 0 0 148rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: rgba(217, 205, 179, 0.5);
}

.journey-route-card__thumb {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  background: rgba(217, 205, 179, 0.5);
}

.journey-route-card__compact-body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  min-height: 148rpx;
  padding: 6rpx 0;
}

.journey-route-card__compact-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.journey-route-card__compact-title {
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  overflow: hidden;
  font-size: 32rpx;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.journey-route-card__compact-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.journey-route-card__compact-meta-group {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.journey-route-card__compact-date {
  display: block;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.42;
  color: #993921;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.journey-route-card__compact-foot-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.journey-route-card__compact-price {
  font-size: 28rpx;
  line-height: 1.08;
}

.journey-route-card__compact-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: #8d7b68;
}

.journey-route-card--grid .journey-route-card__plate {
  height: auto;
  border-radius: 24rpx;
  box-shadow:
    0 12rpx 24rpx rgba(84, 57, 31, 0.06),
    inset 0 0 0 1rpx rgba(153, 57, 33, 0.08);
}

.journey-route-card--grid .journey-route-card__cover-shell {
  position: relative;
  align-items: flex-start;
  margin: 10rpx 10rpx 0;
  max-height: none;
  padding-top: 0;
  border-radius: 18rpx;
}

.journey-route-card--grid .journey-route-card__cover {
  position: static;
  width: 100%;
  height: auto;
}

.journey-route-card--grid .journey-route-card__cover--empty {
  min-height: 220rpx;
}

.journey-route-card--grid .journey-route-card__cover-badges {
  top: 12rpx;
  left: 12rpx;
  gap: 8rpx;
}

.journey-route-card--grid .journey-route-card__duration-pill {
  min-width: 0;
  min-height: 32rpx;
  padding: 3rpx 9rpx;
  font-size: 17rpx;
}

.journey-route-card--grid .journey-route-card__confirmed-corner {
  min-width: 82rpx;
  padding: 5rpx 11rpx 6rpx;
  border-radius: 0 18rpx 0 14rpx;
  font-size: 18rpx;
}

.journey-route-card--grid .journey-route-card__route-wordmark {
  right: 12rpx;
  bottom: 12rpx;
  width: 96rpx;
}

.journey-route-card--grid .journey-route-card__body {
  padding: 14rpx 14rpx 16rpx;
  text-align: left;
}

.journey-route-card--grid .journey-route-card__title {
  display: -webkit-box;
  overflow: hidden;
  font-size: 28rpx;
  line-height: 1.36;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.journey-route-card--grid .journey-route-card__creator-name {
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.journey-route-card--grid .journey-route-card__summary {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-line-clamp: 2;
}

.journey-route-card--grid .journey-route-card__summary-toggle {
  display: none;
}

.journey-route-card--grid .journey-route-card__foot {
  align-items: center;
  flex-direction: row;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
}

.journey-route-card--grid .journey-route-card__departure {
  flex: 1;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  max-width: 100%;
  padding: 0;
}

.journey-route-card--grid .journey-route-card__departure-label {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 1.35;
  letter-spacing: 0;
}

.journey-route-card--grid .journey-route-card__departure-date {
  display: block;
  overflow: hidden;
  max-width: 100%;
  font-size: 20rpx;
  line-height: 1.34;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.journey-route-card--grid .journey-route-card__price {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.08;
  white-space: nowrap;
}
