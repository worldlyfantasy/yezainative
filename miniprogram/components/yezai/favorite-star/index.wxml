<view class="favorite-star">
  <view
    wx:if="{{showButton}}"
    class="favorite-star__button {{favorited ? 'favorite-star__button--active' : ''}}"
    bindtap="handleToggle"
  >
    <view class="favorite-star__leaf {{favorited ? 'favorite-star__leaf--active' : ''}}">
      <view class="favorite-star__leaf-shape"></view>
      <view class="favorite-star__leaf-vein"></view>
    </view>
  </view>

  <view
    wx:if="{{noticeState}}"
    class="favorite-star__notice favorite-star__notice--{{noticeState}} favorite-star__notice--{{noticeMode}} {{noticeElevated ? 'favorite-star__notice--elevated' : ''}}"
  >
    <view class="favorite-star__notice-main">
      <view class="favorite-star__notice-check favorite-star__notice-check--{{noticeMode}}">
        <text class="favorite-star__notice-check-icon">{{noticeMode === 'warning' ? '!' : '✓'}}</text>
      </view>
      <text class="favorite-star__notice-label">{{noticeLabel}}</text>
    </view>
    <view class="favorite-star__notice-action" catchtap="handleNavigateFavorites">
      <text class="favorite-star__notice-link">{{noticeActionLabel}}</text>
      <text class="favorite-star__notice-arrow">›</text>
    </view>
  </view>
</view>
