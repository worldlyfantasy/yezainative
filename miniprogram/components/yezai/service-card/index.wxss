.service-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 0 0 28rpx;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.12);
}

.service-card--compact {
  gap: 14rpx;
  padding: 0 0 24rpx;
}

.service-card__cover {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
}

.service-card__cover-bg {
  background-color: rgba(217, 205, 179, 0.5);
}

.service-card--compact .service-card__cover {
  height: 220rpx;
  border-radius: 22rpx;
}

.service-card__meta,
.service-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.service-card__link-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 auto;
}

.service-card__type {
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #993921;
}

.service-card__duration,
.service-card__link {
  font-size: 22rpx;
  color: #6a5a4b;
}

.service-card__link--pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #fff9f2;
  background: #D15E14;
  box-shadow: 0 12rpx 26rpx rgba(209, 94, 20, 0.18);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
  white-space: nowrap;
}

.service-card__name {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 40rpx;
  line-height: 1.55;
  font-weight: 500;
  color: #2b241d;
}

.service-card--compact .service-card__name {
  font-size: 34rpx;
  line-height: 1.45;
}

.service-card__summary,
.service-card__creator {
  font-size: 27rpx;
  line-height: 1.95;
  color: #6a5a4b;
}

.service-card__tags {
  gap: 8rpx 14rpx;
}

.service-card__tag {
  letter-spacing: 1rpx;
}

.service-card__price {
  font-size: 30rpx;
  font-weight: 500;
  color: #2b241d;
}

.service-card--compact .service-card__price {
  font-size: 28rpx;
}
