.section-tabs {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 249, 242, 0.62);
  box-shadow: inset 0 0 0 1rpx rgba(153, 57, 33, 0.08);
}

.section-tabs__item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx 8rpx 18rpx;
}

.section-tabs__label {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 500;
  color: #6a5a4b;
  transition: color 0.28s ease-out;
}

.section-tabs__indicator {
  width: 48rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: transparent;
  transition: background 0.28s ease-out;
}

.section-tabs__item--active .section-tabs__label {
  color: #993921;
  font-weight: 600;
}

.section-tabs__item--active .section-tabs__indicator {
  background: #993921;
}

.section-tabs--compact {
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
}

.section-tabs--compact .section-tabs__item {
  gap: 6rpx;
  padding: 18rpx 8rpx 14rpx;
}

.section-tabs--compact .section-tabs__label {
  font-size: 28rpx;
}

.section-tabs--compact .section-tabs__indicator {
  width: 44rpx;
  height: 6rpx;
}
