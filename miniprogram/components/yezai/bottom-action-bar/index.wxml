<view class="bottom-action-bar {{placement === 'sticky-top' ? 'bottom-action-bar--sticky-top' : 'bottom-action-bar--fixed-bottom'}}">
  <view class="bottom-action-bar__meta {{labelText ? '' : 'bottom-action-bar__meta--compact'}}">
    <text wx:if="{{labelText}}" class="bottom-action-bar__label">{{labelText}}</text>
    <text class="bottom-action-bar__price">{{priceText}}</text>
  </view>
  <button
    class="primary-button bottom-action-bar__button {{disabled ? 'bottom-action-bar__button--disabled' : ''}}"
    bindtap="handleTap"
    disabled="{{disabled}}"
    loading="{{loading}}"
  >
    {{loading && loadingText ? loadingText : buttonText}}
  </button>
</view>
