.bottom-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: rgba(242, 230, 201, 0.96);
}

.bottom-action-bar--fixed-bottom {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  z-index: 2000;
  padding: 18rpx 0 0;
  border-top: 1rpx solid rgba(153, 57, 33, 0.14);
  border-radius: 0;
  box-shadow: none;
}

.bottom-action-bar--sticky-top {
  position: sticky;
  top: 0;
  z-index: 1001;
  width: 100%;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(153, 57, 33, 0.14);
  box-shadow: 0 10rpx 24rpx rgba(153, 57, 33, 0.06);
}

.bottom-action-bar__meta {
  display: flex;
  flex: 1;
  min-height: 88rpx;
  flex-direction: column;
  justify-content: center;
}

.bottom-action-bar__meta--compact {
  justify-content: center;
}

.bottom-action-bar__label {
  display: block;
  font-size: 22rpx;
  color: #6a5a4b;
}

.bottom-action-bar__price {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #2b241d;
}

.bottom-action-bar__button {
  min-width: 260rpx;
}

.bottom-action-bar__button--disabled {
  opacity: 0.72;
}
