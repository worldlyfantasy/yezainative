.order-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(153, 57, 33, 0.12);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 250, 242, 0.96), rgba(255, 250, 242, 0) 34%),
    linear-gradient(180deg, rgba(255, 250, 242, 0.96), rgba(246, 236, 214, 0.9));
  box-shadow: 0 16rpx 38rpx rgba(84, 57, 31, 0.07);
  transition: opacity 0.16s ease-out, transform 0.16s ease-out;
}

.order-card--pressing {
  opacity: 0.92;
  transform: scale(0.992);
}

.order-card__cover-wrap {
  position: relative;
  z-index: 1;
  overflow: hidden;
  width: 156rpx;
  height: 178rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: rgba(153, 57, 33, 0.08);
}

.order-card__cover {
  width: 156rpx;
  height: 178rpx;
}

.order-card__cover--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 30% 24%, rgba(255, 250, 242, 0.7), rgba(255, 250, 242, 0) 36%),
    linear-gradient(145deg, rgba(226, 211, 181, 0.95), rgba(153, 57, 33, 0.13));
}

.order-card__cover-mark {
  font-family: "Yezai Songti Fixed", "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 28rpx;
  color: rgba(43, 36, 29, 0.56);
}

.order-card__body {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 0 34rpx;
}

.order-card__main {
  transform: translateY(10rpx);
}

.order-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.order-card__name {
  flex: 1;
  min-width: 0;
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", serif;
  font-size: 32rpx;
  line-height: 1.32;
  font-weight: 500;
  color: #2b241d;
}

.order-card__status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.3;
  color: #b36b08;
  background: rgba(255, 171, 31, 0.16);
}

.order-card--pending .order-card__status {
  color: #b24a2c;
  background: rgba(209, 94, 20, 0.13);
}

.order-card--paid .order-card__status,
.order-card--traveling .order-card__status {
  color: #a9650b;
  background: rgba(255, 171, 31, 0.18);
}

.order-card--completed .order-card__status {
  color: rgba(74, 58, 43, 0.74);
  background: rgba(106, 90, 75, 0.12);
}

.order-card--canceled .order-card__status {
  color: rgba(171, 91, 45, 0.78);
  background: rgba(255, 171, 31, 0.14);
}

.order-card__meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 28rpx;
}

.order-card__meta-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.order-card__meta-value {
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.45;
  color: #6a5a4b;
}

.order-card__foot {
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.order-card__action {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 600;
  color: rgba(153, 57, 33, 0.9);
}
